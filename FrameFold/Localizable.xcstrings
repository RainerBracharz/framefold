    "Klassische Einstellungen: Format, Bildrate, Abspielmodus, Stabilisierung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The usual settings: aspect, frame rate, playback, stabilisation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages habituels : format, cadence, lecture, stabilisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de siempre: formato, velocidad, reproducción, estabilización."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni classiche: formato, frame rate, riproduzione, stabilizzazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klassieke instellingen: formaat, beeldsnelheid, afspelen, stabilisatie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本の設定：アスペクト比、フレームレート、再生、手ぶれ補正。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes de sempre: formato, taxa de quadros, reprodução, estabilização."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasická nastavení: formát, snímková frekvence, přehrávání, stabilizace."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasyczne ustawienia: format, liczba klatek, odtwarzanie, stabilizacja."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Класичні налаштування: формат, частота кадрів, режим відтворення, стабілізація."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычные настройки: формат, частота кадров, воспроизведение, стабилизация."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinen ayarlar: en-boy oranı, kare hızı, oynatma, sabitleme."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익숙한 설정: 화면비, 프레임 레이트, 재생, 흔들림 보정."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常用设置：画幅、帧率、播放方式、防抖。"
