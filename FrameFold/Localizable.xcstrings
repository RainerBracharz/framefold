    "Das Beispielwerk „Faltung“ zeigt, wie ein fertiges Werk aussieht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sample work “Sample: Fold” shows what a finished work looks like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’œuvre « Exemple : pliage » montre à quoi ressemble une œuvre terminée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La obra de ejemplo «Ejemplo: plegado» muestra cómo es una obra terminada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opera d’esempio «Esempio: piegatura» mostra com’è un’opera finita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het voorbeeldwerk ‘Voorbeeld: vouwen’ laat zien hoe een af werk eruitziet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプル作品「サンプル：折り」で、完成した作品の姿を見られます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A obra de exemplo “Exemplo: Dobra” mostra como fica uma obra pronta."
          }
        }
      }
    },
