    "Kein Bluetooth-Zugriff – in den Einstellungen erlauben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bluetooth access – allow it in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès Bluetooth – autorise-le dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Bluetooth: permítelo en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al Bluetooth – consentilo in Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Bluetooth-toegang – sta het toe in Instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth へのアクセスがありません –「設定」で許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao Bluetooth – permita em Ajustes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný přístup k Bluetooth – povol ho v Nastavení."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do Bluetooth – zezwól w Ustawieniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до Bluetooth – дозволь у Налаштуваннях."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к Bluetooth — разрешите в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth erişimi yok — Ayarlar’dan izin verin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 접근 권한이 없어요 – 설정에서 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有蓝牙访问权限 – 请在“设置”中允许。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Bluetooth-adgang – tillad det i Indstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Bluetooth-åtkomst – tillåt det i Inställningar."
          }
        }
      }
    },
    "Kein Konto, keine Werbung, keine Verbindung ins Internet. Licht (Art-Net) und Motion Control (Bluetooth) verbinden sich nur, wenn du sie einschaltest – und nur mit deinem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no ads, no internet connection. Lights (Art-Net) and motion control (Bluetooth) only connect when you turn them on – and only to your own device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de pub, pas de connexion à Internet. La lumière (Art-Net) et le Motion Control (Bluetooth) ne se connectent que si tu les actives – et uniquement à ton appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin conexión a internet. La luz (Art-Net) y el Motion Control (Bluetooth) solo se conectan cuando los activas, y solo con tu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessuna pubblicità, nessuna connessione a Internet. Luci (Art-Net) e Motion Control (Bluetooth) si collegano solo quando li attivi – e solo al tuo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account, geen reclame, geen internetverbinding. Licht (Art-Net) en motion control (Bluetooth) maken alleen verbinding als je ze inschakelt – en alleen met je eigen apparaat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなし、広告なし、インターネット接続なし。照明（Art-Net）とモーションコントロール（Bluetooth）は、オンにしたときだけ、あなたの機器にだけ接続します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem anúncios, sem conexão com a internet. A luz (Art-Net) e o Motion Control (Bluetooth) só se conectam quando você os ativa – e só ao seu aparelho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný účet, žádné reklamy, žádné připojení k internetu. Světlo (Art-Net) a Motion Control (Bluetooth) se připojí, jen když je zapneš – a jen k tvému zařízení."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta, bez reklam, bez połączenia z internetem. Światło (Art-Net) i Motion Control (Bluetooth) łączą się tylko wtedy, gdy je włączysz – i tylko z twoim urządzeniem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без облікового запису, без реклами, без з’єднання з інтернетом. Світло (Art-Net) і Motion Control (Bluetooth) підключаються, лише коли ти їх вмикаєш, – і лише до твого пристрою."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта, без рекламы, без подключения к интернету. Свет (Art-Net) и Motion Control (Bluetooth) подключаются, только когда вы их включаете, — и только к вашему устройству."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, reklam yok, internet bağlantısı yok. Işık (Art-Net) ve Motion Control (Bluetooth) yalnızca siz açtığınızda bağlanır – ve yalnızca kendi cihazınıza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도, 광고도, 인터넷 연결도 없어요. 조명(Art-Net)과 모션 컨트롤(Bluetooth)은 직접 켤 때만, 내 기기에만 연결돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，没有广告，不连接互联网。灯光（Art-Net）和运动控制（蓝牙）只在你开启时连接，而且只连接你自己的设备。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto, ingen reklamer, ingen forbindelse til internettet. Lys (Art-Net) og motion control (Bluetooth) forbinder kun, når du slår dem til – og kun til din egen enhed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto, ingen reklam, ingen anslutning till internet. Ljus (Art-Net) och motion control (Bluetooth) ansluter bara när du slår på dem – och bara till din egen enhet."
          }
        }
      }
    },
    "Kein Zugriff auf angeschlossene Kameras – in den Systemeinstellungen erlauben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to connected cameras – allow it in System Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès aux appareils connectés – autorise-le dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a las cámaras conectadas: permítelo en Ajustes del Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso alle fotocamere collegate – consentilo in Impostazioni di Sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot aangesloten camera’s – sta het toe in Systeeminstellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したカメラへのアクセスがありません –「システム設定」で許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso às câmeras conectadas – permita em Ajustes do Sistema."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný přístup k připojeným kamerám – povol ho v Nastavení systému."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do podłączonych aparatów – zezwól w Ustawieniach systemowych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до підключених камер – дозволь у Системних параметрах."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к подключённым камерам — разрешите в Системных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı kameralara erişim yok — Sistem Ayarları’ndan izin verin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 카메라에 접근할 수 없어요 – 시스템 설정에서 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问已连接的相机 – 请在“系统设置”中允许。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen adgang til tilsluttede kameraer – tillad det i Systemindstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen åtkomst till anslutna kameror – tillåt det i Systeminställningar."
          }
        }
      }
    },
