    "Fotos aus der Mediathek lassen sich als Bilder anhängen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos from your library can be appended as frames."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos de la photothèque peuvent être ajoutées comme images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de la fototeca se pueden añadir como fotogramas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto della libreria si possono aggiungere come fotogrammi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s uit de bibliotheek kun je als beelden toevoegen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォトライブラリの写真をコマとして追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos da sua fototeca podem ser adicionadas como quadros."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky z knihovny lze připojit jako snímky."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia z biblioteki można dołączyć jako klatki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото з медіатеки можна додати як кадри."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото из медиатеки можно добавить как кадры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivinizdeki fotoğraflar kare olarak eklenebilir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 사진을 프레임으로 덧붙일 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图库中的照片可以作为帧添加进来。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos fra dit bibliotek kan tilføjes som billeder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Foton från ditt bibliotek kan läggas till som bilder."
          }
        }
      }
    },
    "Gedrückt halten startet einen Selbstauslöser von 3 Sekunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to start a 3-second self-timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui long lance un retardateur de 3 secondes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado inicia un temporizador de 3 segundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere premuto avvia un autoscatto di 3 secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingedrukt houden start een zelfontspanner van 3 seconden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しすると 3 秒のセルフタイマーが始まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar inicia um temporizador de 3 segundos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržením spustíš samospoušť na 3 sekundy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymanie uruchamia samowyzwalacz na 3 sekundy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримання запускає автоспуск на 3 секунди."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание запускает автоспуск на 3 секунды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılı tutmak 3 saniyelik zamanlayıcıyı başlatır."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르면 3초 셀프 타이머가 시작돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住可启动 3 秒自拍定时器。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede for at starte en selvudløser på 3 sekunder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll in för att starta en självutlösare på 3 sekunder."
          }
        }
      }
    },
    "Geräusch hier": {
      "localizations": {
