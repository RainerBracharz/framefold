    "Bilder sammeln sich über beliebig viele\nAufnahmen – live oder aus Videos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames collect across any number of\nsessions — live or from video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images s’accumulent sur autant\nde séances que tu veux — en direct ou depuis une vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fotogramas se acumulan en tantas\nsesiones como quieras, en directo o desde vídeos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fotogrammi si raccolgono in tutte le\nsessioni che vuoi, dal vivo o da video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beelden verzamelen zich over zoveel\nsessies als je wilt – live of uit video’s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマは何回のセッションにまたがっても\nたまっていきます — ライブでも動画からでも。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros se acumulam em quantas\nsessões você quiser — ao vivo ou de vídeo."
          }
        }
      }
    },
