    "Aus dem Video konnten keine Bilder übernommen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No frames could be taken from the video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image n’a pu être extraite de la vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo extraer ningún fotograma del vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile estrarre fotogrammi dal video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er konden geen beelden uit de video worden gehaald."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画からコマを取り込めませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível extrair quadros do vídeo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z videa se nepodařilo převzít žádné snímky."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać żadnych klatek z wideo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося взяти з відео жодного кадру."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось взять кадры из видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videodan hiç kare alınamadı."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오에서 프레임을 가져올 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从视频中提取任何帧。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kunne ikke hentes nogen billeder fra videoen."
          }
        },
        "sv": {
