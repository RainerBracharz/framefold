    "Für diese Sprache gibt es keine Spracherkennung auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no on-device speech recognition for this language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune reconnaissance vocale sur l’appareil pour cette langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay reconocimiento de voz en el dispositivo para este idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questa lingua non c’è riconoscimento vocale sul dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze taal is er geen spraakherkenning op het apparaat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語にはデバイス上の音声認識がありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há reconhecimento de fala no dispositivo para este idioma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento jazyk není v zařízení rozpoznávání řeči k dispozici."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tego języka nie ma rozpoznawania mowy na urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї мови немає розпізнавання мовлення на пристрої."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого языка нет распознавания речи на устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dil için cihaz üzerinde konuşma tanıma yok."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어는 기기 내 음성 인식을 지원하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言没有设备端语音识别。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der findes ingen talegenkendelse på enheden for dette sprog."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen taligenkänning på enheten för det här språket."
          }
        }
      }
    },
    "In der Spur wurden keine Wörter erkannt.": {
