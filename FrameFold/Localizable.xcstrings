    "Halt kurz still…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold still a moment…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne bouge plus un instant…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieto un momento…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermo un attimo…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even stilhouden…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しの間そのまま…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique parado um instante…"
          }
        }
      }
    },
    "Höher = kleine Wackler und Bildrauschen werden ignoriert. Wenn der Auslöser nie Ruhe findet, diesen Wert erhöhen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher = small shakes and sensor noise are ignored. If the shutter never settles, raise this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haut = petites secousses et bruit d’image ignorés. Si le déclencheur ne trouve jamais le calme, augmente cette valeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto = se ignoran pequeñas sacudidas y el ruido del sensor. Si el obturador nunca encuentra calma, sube este valor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto = piccoli tremolii e rumore del sensore vengono ignorati. Se lo scatto non trova mai calma, aumenta questo valore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger = kleine trillingen en ruis worden genegeerd. Als de ontspanner nooit rust vindt, verhoog deze waarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高くすると、小さな揺れやセンサーノイズを無視します。シャッターがいつまでも落ち着かない場合は上げてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto = pequenos tremores e ruído do sensor são ignorados. Se o obturador nunca se acalma, aumente."
          }
        }
      }
    },
    "Ich sehe kaum Struktur und kann die Schärfe nicht prüfen. Geh etwas weiter weg oder tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can barely see any detail, so I can't judge sharpness. Move back a little, or tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne vois presque pas de détails et ne peux pas juger la netteté. Recule un peu ou touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas veo detalle y no puedo comprobar la nitidez. Aléjate un poco o toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedo pochissimi dettagli e non riesco a valutare la nitidezza. Allontanati un po’ o tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zie nauwelijks structuur en kan de scherpte niet controleren. Ga iets verder weg of tik in de zoeker op je werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディテールがほとんど見えないため、ピントを判断できません。少し離れるか、ファインダーで作品をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase não vejo detalhes, então não consigo avaliar a nitidez. Afaste-se um pouco ou toque na sua obra no visor."
          }
        }
      }
    },
    "Ich warte, bis du weg bist…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll wait till you're clear…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’attends que tu sois sorti du cadre…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espero a que te apartes…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetto che ti sposti…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wacht tot je weg bent…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手がどくまで待ちます…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou esperar você sair do quadro…"
          }
        }
      }
    },
    "Im Intervall-Modus löst FrameFold in festem Takt aus – unabhängig von Bewegung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In interval mode FrameFold fires on a fixed beat, regardless of motion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode intervalle, FrameFold déclenche à rythme fixe, quel que soit le mouvement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo intervalo, FrameFold dispara a un ritmo fijo, sin importar el movimiento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità intervallo FrameFold scatta a ritmo fisso, indipendentemente dal movimento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de intervalmodus drukt FrameFold in een vast ritme af – los van beweging."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターバルモードでは、動きに関係なく一定の間隔で撮影します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo intervalo, o FrameFold dispara num ritmo fixo, independentemente do movimento."
          }
        }
      }
    },
    "Interferenz-Echo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interference echo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écho d’interférence"
          }
        },
        "es": {
