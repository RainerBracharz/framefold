    "Bilder sammeln sich über beliebig viele\nAufnahmen – live oder aus Videos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames collect across any number of\nsessions — live or from video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images s’accumulent sur autant\nde séances que tu veux — en direct ou depuis une vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fotogramas se acumulan en tantas\nsesiones como quieras, en directo o desde vídeos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fotogrammi si raccolgono in tutte le\nsessioni che vuoi, dal vivo o da video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beelden verzamelen zich over zoveel\nsessies als je wilt – live of uit video’s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマは何回のセッションにまたがっても\nたまっていきます — ライブでも動画からでも。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros se acumulam em quantas\nsessões você quiser — ao vivo ou de vídeo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky se sbírají z libovolného počtu\nnatáčení – živě nebo z videí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki zbierają się z dowolnej liczby\nsesji – na żywo albo z wideo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри збираються з будь-якої кількості\nзйомок — наживо або з відео."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры копятся за сколько угодно\nсъёмок — вживую или из видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareler istediğiniz kadar çekimde\nbirikir — canlı ya da videodan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임은 원하는 만큼 여러 번의\n촬영에 걸쳐 모여요 — 라이브로 또는 비디오에서."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧会在任意多次拍摄中\n不断累积——现场拍摄或来自视频。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder samles over lige så mange\noptagelser du vil — live eller fra video."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder samlas över hur många\ninspelningar som helst — live eller från video."
          }
        }
      }
    },
