    "Jede Facette liegt anders im Licht — als wäre das Bild gefaltet und wieder abfotografiert worden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each facet catches the light differently — as if the image had been folded and photographed again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque facette accroche la lumière autrement — comme si l’image avait été pliée puis rephotographiée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada faceta recibe la luz de otra manera, como si la imagen se hubiera plegado y vuelto a fotografiar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sfaccettatura prende la luce in modo diverso, come se l’immagine fosse stata piegata e fotografata di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk facet vangt het licht anders — alsof het beeld gevouwen en opnieuw gefotografeerd is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファセットごとに光の当たり方が変わります — まるで画像を折ってもう一度撮影したように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada faceta capta a luz de um jeito diferente — como se a imagem tivesse sido dobrada e fotografada de novo."
          }
        }
      }
    },
    "Kalibriere – kurz ruhig lassen…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrating — keep it steady…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrage — ne bouge pas…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrando: mantenlo quieto…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrazione: tienila ferma…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreren – even stilhouden…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリブレーション中 — 動かさないで…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrando — mantenha firme…"
          }
        }
      }
    },
    "Kamera-Tab am iPhone öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the camera tab on iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’onglet Caméra sur l’iPhone"
          }
        },
        "es": {
