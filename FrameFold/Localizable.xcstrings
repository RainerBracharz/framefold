    "Zu viel Bewegung – steht die Kamera wirklich fest?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much movement — is the camera really fixed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de mouvement — la caméra est-elle bien fixée ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado movimiento: ¿está la cámara realmente fija?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo movimento: la fotocamera è davvero fissa?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel beweging – staat de camera echt vast?"
          }
        }
      }
    },
    "Zu viel Wackeln – leg das iPhone irgendwo auf oder lehne es an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much shake — set the phone down or lean it against something."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de secousses — pose l’iPhone ou appuie-le contre quelque chose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado temblor: apoya el iPhone en algún sitio o recuéstalo contra algo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo mosso: posa l’iPhone da qualche parte o appoggialo a qualcosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel trilling – leg de iPhone ergens neer of zet hem ergens tegenaan."
          }
        }
      }
    },
