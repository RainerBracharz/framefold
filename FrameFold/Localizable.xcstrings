    "Am Stativ wird der Fokus fixiert, aus der Hand läuft er mit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a tripod focus stays locked; handheld it keeps tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur trépied, la mise au point reste verrouillée ; à main levée, elle suit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el trípode el enfoque queda fijo; a mano sigue al motivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul treppiede il fuoco resta fisso; a mano libera segue il soggetto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een statief blijft de focus vast; uit de hand volgt hij mee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三脚ではピントを固定し、手持ちでは追従し続けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No tripé, o foco fica travado; na mão, ele continua acompanhando."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stativu se ostření zamkne, z ruky průběžně sleduje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na statywie ostrość jest blokowana, z ręki podąża za obrazem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На штативі фокус фіксується, з рук він стежить за сценою."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На штативе фокус фиксируется, с рук — следует за сценой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tripotta odak kilitlenir, elde çekimde takip eder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삼각대에서는 초점이 고정되고, 핸드헬드에서는 계속 따라가요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用三脚架时对焦锁定；手持时对焦持续跟随。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På stativ låses fokus; håndholdt følger det med."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På stativ låses fokus; handhållen följer den med."
          }
        }
      }
    },
