    "Jedes Bild als Foto vom Sensor statt als Videobild (1080p) – schärfer, braucht mehr Speicher.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every frame as a photo from the sensor instead of a video frame (1080p) – sharper, uses more storage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque image comme photo du capteur au lieu d’une image vidéo (1080p) – plus net, prend plus de place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fotograma como foto del sensor en lugar de imagen de vídeo (1080p): más nítido, ocupa más espacio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni fotogramma come foto dal sensore invece che dal video (1080p): più nitido, occupa più spazio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk beeld als foto van de sensor in plaats van een videobeeld (1080p) – scherper, neemt meer ruimte in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各コマをビデオフレーム（1080p）ではなくセンサーからの写真として記録 – よりシャープですが、ストレージを多く使います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada quadro como foto do sensor em vez de quadro de vídeo (1080p) – mais nítido, ocupa mais espaço."
          }
        }
      }
    },
    "Auslösen per Klatschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clap to shoot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclencher en tapant des mains"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disparar con una palmada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta con un battito di mani"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afdrukken met klappen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拍手で撮影"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bater palma para disparar"
          }
        }
      }
    },
    "Einmal klatschen = ein Bild. Das Mikrofon hört nur auf den Knall, nichts wird aufgenommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clap = one frame. The microphone only listens for the clap; nothing is recorded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clap = une image. Le micro n’écoute que le claquement, rien n’est enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palmada = un fotograma. El micrófono solo escucha la palmada; no se graba nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un battito = un fotogramma. Il microfono ascolta solo il battito, non registra nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer klappen = één beeld. De microfoon luistert alleen naar de klap; er wordt niets opgenomen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回の拍手 = 1 コマ。マイクは拍手の音だけを聞き取り、何も録音しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palma = um quadro. O microfone só escuta a palma; nada é gravado."
          }
        }
      }
