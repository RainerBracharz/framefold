    "Zeigt das erste oder letzte Bild als Überblendung – zum Ausrichten und um Drift zu erkennen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlays the first or last frame — for lining up and spotting drift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpose la première ou la dernière image — pour aligner et repérer les dérives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el primer o el último fotograma superpuesto, para alinear y detectar desplazamientos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra in sovrimpressione il primo o l’ultimo fotogramma, per allineare e scoprire spostamenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het eerste of laatste beeld als overlay – om uit te lijnen en verschuiving te zien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初または最後のコマを重ねます — 位置合わせやずれの確認に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe o primeiro ou o último quadro — para alinhar e perceber desvios."
          }
        }
      }
    },
