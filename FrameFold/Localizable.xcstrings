    "Einfach: nur Auslöser und Fertig. Alles Weitere erscheint ab \"Erweitert\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple: just the shutter and Done. Everything else appears from \"Advanced\" on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple : juste le déclencheur et Terminé. Le reste apparaît à partir du mode « Avancé »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sencillo: solo el obturador y Listo. Todo lo demás aparece a partir de «Avanzado»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Semplice: solo scatto e Fine. Tutto il resto compare da «Avanzata» in su."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenvoudig: alleen ontspanner en Klaar. Al het andere verschijnt vanaf ‘Uitgebreid’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプル：シャッターと「完了」だけ。そのほかの機能は「詳細」から表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simples: só o obturador e Concluído. Todo o resto aparece a partir de “Avançado”."
          }
        }
      }
    },
