            "value": "De rustige momenten worden gezocht"
          }
        }
      }
    },
    "Direkt aufnehmen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoot live"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmer en direct"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar en directo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi dal vivo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct opnemen"
          }
        }
      }
    },
    "Dokumentenkamera mit Fokus-Schalter: auf Einzelfokus (S) stellen und einmal scharfstellen – sonst stellt sie bei jeder Hand im Bild neu scharf. Helligkeit und Weißabgleich lassen sich meist mit der App des Herstellers fest einstellen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document camera with a focus switch: set it to single focus (S) and focus once – otherwise it refocuses every time a hand enters the frame. Brightness and white balance can usually be fixed in the maker's app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra de documents avec sélecteur de mise au point : passe en mise au point unique (S) et fais la mise au point une fois – sinon elle refait le point à chaque main dans le cadre. La luminosité et la balance des blancs se règlent en général de façon fixe dans l’app du fabricant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara de documentos con selector de enfoque: ponla en enfoque único (S) y enfoca una vez; si no, vuelve a enfocar cada vez que entra una mano en el encuadre. El brillo y el balance de blancos suelen poder fijarse en la app del fabricante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Document camera con selettore di messa a fuoco: impostala su fuoco singolo (S) e metti a fuoco una volta, altrimenti rimette a fuoco ogni volta che una mano entra nell’inquadratura. Luminosità e bilanciamento del bianco di solito si fissano nell’app del produttore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentcamera met focusschakelaar: zet hem op enkele focus (S) en stel één keer scherp – anders stelt hij bij elke hand in beeld opnieuw scherp. Helderheid en witbalans kun je meestal vastzetten in de app van de fabrikant."
          }
        }
      }
    },
    "Doppeltippen nimmt das Bild in den Film auf oder heraus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to add the frame to the film or take it out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche deux fois pour ajouter l’image au film ou l’en retirer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para añadir el fotograma a la película o quitarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per aggiungere o togliere il fotogramma dal film."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltik om het beeld aan de film toe te voegen of eruit te halen."
          }
        }
      }
    },
    "Drift früh erkennen: Zwiebelhaut anlassen und die Aufnahme ab und zu mit dem ersten Bild vergleichen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot drift early: leave onion skin on and compare against the first frame now and then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère vite les dérives : laisse la pelure d’oignon activée et compare de temps en temps avec la première image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta el desplazamiento a tiempo: deja el papel cebolla activado y compara de vez en cuando con el primer fotograma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri subito lo spostamento: lascia attivo l’onion skin e confronta ogni tanto con il primo fotogramma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschuiving vroeg zien: laat onion skin aan en vergelijk de opname af en toe met het eerste beeld."
          }
        }
      }
    },
