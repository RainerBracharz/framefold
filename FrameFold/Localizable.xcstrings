    "Zeitleiste, Abspielen, Umschalten zwischen Live-Bild und Aufnahme, Zwiebelhaut über mehrere Bilder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, playback, toggling between live view and capture, onion skin across several frames."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, lecture, bascule entre image en direct et prise, pelure d’oignon sur plusieurs images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea de tiempo, reproducción, cambio entre imagen en vivo y toma, papel cebolla sobre varios fotogramas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, riproduzione, passaggio tra immagine live e scatto, onion skin su più fotogrammi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdlijn, afspelen, wisselen tussen livebeeld en opname, onion skin over meerdere beelden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムライン、再生、ライブ映像と撮影済みの切り替え、複数コマのオニオンスキン。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha do tempo, reprodução, alternância entre imagem ao vivo e captura, papel cebola de vários quadros."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časová osa, přehrávání, přepínání mezi živým obrazem a snímkem, cibulová slupka přes více snímků."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oś czasu, odtwarzanie, przełączanie między obrazem na żywo a zdjęciem, skórka cebuli z wielu klatek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймлайн, відтворення, перемикання між живим зображенням і знятим кадром, калька з кількох кадрів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймлайн, воспроизведение, переключение между живым изображением и снятым, калька на несколько кадров."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman çizelgesi, oynatma, canlı görüntü ile çekim arasında geçiş, çok kareli soğan kabuğu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인, 재생, 라이브 화면과 촬영 프레임 간 전환, 여러 프레임 어니언 스킨."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间线、播放、在实时画面与已拍帧之间切换、多帧洋葱皮。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidslinje, afspilning, skift mellem livebillede og optagelse, løgskind over flere billeder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidslinje, uppspelning, växling mellan livebild och tagen bild, lökskal över flera bilder."
          }
        }
      }
    },
