    },
    "Hallo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut"
          }
        }
      }
    },
    "Halt kurz still…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold still a moment…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne bouge plus un instant…"
          }
        }
      }
    },
    "Höher = kleine Wackler und Bildrauschen werden ignoriert. Wenn der Auslöser nie Ruhe findet, diesen Wert erhöhen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher = small shakes and sensor noise are ignored. If the shutter never settles, raise this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haut = petites secousses et bruit d’image ignorés. Si le déclencheur ne trouve jamais le calme, augmente cette valeur."
          }
        }
      }
    },
    "Ich sehe kaum Struktur und kann die Schärfe nicht prüfen. Geh etwas weiter weg oder tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can barely see any detail, so I can't judge sharpness. Move back a little, or tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne vois presque pas de détails et ne peux pas juger la netteté. Recule un peu ou touche ton œuvre dans le viseur."
          }
        }
      }
    },
    "Ich warte, bis du weg bist…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll wait till you're clear…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’attends que tu sois sorti du cadre…"
          }
        }
      }
    },
    "Im Intervall-Modus löst FrameFold in festem Takt aus – unabhängig von Bewegung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In interval mode FrameFold fires on a fixed beat, regardless of motion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode intervalle, FrameFold déclenche à rythme fixe, quel que soit le mouvement."
          }
        }
      }
    },
    "Interferenz-Echo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interference echo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écho d’interférence"
          }
        }
      }
    },
    "Intervall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalle"
          }
        }
      }
    },
    "Intervall: %.0f s": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval: %.0f s"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalle : %.0f s"
          }
        }
      }
    },
    "Jede Facette liegt anders im Licht — als wäre das Bild gefaltet und wieder abfotografiert worden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each facet catches the light differently — as if the image had been folded and photographed again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque facette accroche la lumière autrement — comme si l’image avait été pliée puis rephotographiée."
          }
        }
      }
    },
    "Kalibriere – kurz ruhig lassen…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrating — keep it steady…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrage — ne bouge pas…"
          }
        }
      }
    },
    "Kamera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra"
          }
        }
      }
    },
    "Kamera aufs Stativ, automatisch auslösen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera on a tripod, fires by itself"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra sur trépied, déclenchement automatique"
          }
        }
      }
    },
    "Kamera bleibt ruhig: FrameFold sperrt Belichtung und Weißabgleich nach der kurzen Kalibrierung – so driftet zwischen den Bildern nichts. Der Fokus wird am Stativ fixiert, aus der Hand läuft er mit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera stays calm: after a short calibration FrameFold locks exposure and white balance, so nothing drifts between frames. Focus stays locked on a tripod; handheld it keeps tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra stable : après un bref calibrage, FrameFold verrouille l’exposition et la balance des blancs, rien ne dérive d’une image à l’autre. Sur trépied, la mise au point reste verrouillée ; à main levée, elle suit."
          }
        }
      }
    },
    "Kamera neu fixieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-lock camera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverrouiller la caméra"
          }
        }
      }
    },
    "Kamera startet…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting camera…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage de la caméra…"
          }
        }
      }
    },
    "Kein Kamerazugriff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès à l’appareil photo"
          }
        }
      }
    },
    "Keine Kamera verfügbar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera available"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil photo disponible"
          }
        }
      }
    },
    "Keine ruhigen Momente gefunden. Das Video ist evtl. sehr kurz oder durchgehend in Bewegung – nimm etwas länger auf oder halte zwischendurch kurz still.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calm moments found. The video may be very short, or in motion throughout — shoot a little longer, or hold still now and then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun moment calme trouvé. La vidéo est peut-être très courte ou en mouvement du début à la fin — filme un peu plus longtemps ou marque de petites pauses."
          }
        }
      }
    },
    "Keine ruhigen Momente gefunden. Das Video ist evtl. sehr kurz oder durchgehend in Bewegung — schiebe den Regler unten Richtung Mehr Bilder oder nimm etwas länger auf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calm moments found. The video may be very short, or in motion throughout — push the slider below towards More frames, or shoot a little longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun moment calme trouvé. La vidéo est peut-être très courte ou en mouvement du début à la fin — pousse le curseur ci-dessous vers « Plus d’images » ou filme un peu plus longtemps."
          }
        }
      }
    },
    "Keyframes prüfen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review keyframes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les images clés"
          }
        }
      }
    },
    "Klassische Einstellungen: Format, Bildrate, Abspielmodus, Stabilisierung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The usual settings: aspect, frame rate, playback, stabilisation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages habituels : format, cadence, lecture, stabilisation."
          }
        }
      }
    },
    "Klick!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic !"
          }
        }
      }
    },
    "Kontaktbogen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact sheet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planche contact"
          }
        }
      }
    },
    "Kontaktbogen konnte nicht erstellt werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact sheet couldn't be created."
          }
        },
        "fr": {
