            "state": "translated",
            "value": "Mode : trépied. Touche pour passer à main levée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de captura: trípode. Toca para a mano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità di ripresa: treppiede. Tocca per a mano libera."
          }
