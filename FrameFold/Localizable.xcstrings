    "Fokus findet nichts Scharfes. Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus can't find anything sharp. Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise au point ne trouve rien de net. Touche ton œuvre dans le viseur."
          }
        }
      }
    },
    "Format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspect"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format"
          }
        }
      }
    },
    "Format, Bildrate, Effekte, Faltvorlagen, Ausstellung — die volle Werkstatt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspect, frame rate, effects, fold templates, exhibition — the full workshop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format, cadence, effets, gabarits de pliage, exposition — tout l’atelier."
          }
        }
      }
    },
    "FrameFold": {
      "shouldTranslate": false
    },
    "FrameFold findet die ruhigen Momente und verwirft Bilder, auf denen deine Hände zu sehen sind. Alles bleibt auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold finds the calm moments and drops any frame with your hands in it. Everything stays on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold repère les moments calmes et écarte chaque image où l’on voit tes mains. Tout reste sur l’appareil."
          }
        }
      }
    },
    "Galerie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallery"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Galerie"
          }
        }
      }
    },
    "Gegen erstes Bild (Drift)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Against first frame (drift)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par rapport à la première image (dérive)"
          }
        }
      }
    },
    "Gesichert ✓": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved ✓"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré ✓"
          }
        }
      }
    },
    "Gleich geht's los…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearly there…"
          }
        },
        "fr": {
          "stringUnit": {
