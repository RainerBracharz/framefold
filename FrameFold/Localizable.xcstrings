            "value": "La scena non si ferma mai. Controlla il treppiede, oppure aumenta la tolleranza al movimento nelle impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scène blijft onrustig. Controleer het statief – of verhoog in de instellingen de bewegingstolerantie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーンが落ち着きません。三脚を確認するか、設定で動きの許容度を上げてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cena nunca se acalma. Verifique o tripé — ou aumente a tolerância de movimento nos ajustes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scéna je pořád neklidná. Zkontroluj stativ – nebo v nastavení zvyš toleranci pohybu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scena wciąż jest niespokojna. Sprawdź statyw – albo zwiększ w ustawieniach tolerancję ruchu."
