    "Der Auto-Auslöser wartet, bis die Szene ruhig ist und keine Hände zu sehen sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The auto shutter waits until the scene is still and no hands are visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déclencheur auto attend que la scène soit immobile et qu’aucune main ne soit visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disparador automático espera a que la escena esté quieta y no se vean manos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scatto automatico attende che la scena sia ferma e che non si vedano mani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De auto-ontspanner wacht tot de scène stil is en er geen handen te zien zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートシャッターは、シーンが静止して手が見えなくなるまで待ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O obturador automático espera até a cena ficar parada e nenhuma mão aparecer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatická spoušť čeká, až bude scéna v klidu a nebudou vidět žádné ruce."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczny spust czeka, aż scena się uspokoi i nie będzie widać rąk."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозатвор чекає, поки сцена завмре й не буде видно рук."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозатвор ждёт, пока сцена успокоится и руки исчезнут из кадра."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik deklanşör, sahne durulana ve eller görünmeyene kadar bekler."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 셔터는 장면이 멈추고 손이 보이지 않을 때까지 기다려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动快门会等到场景静止、画面中没有手时才拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-udløseren venter, til scenen er rolig og der ikke er hænder i billedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den automatiska avtryckaren väntar tills scenen är lugn och inga händer syns."
          }
        }
      }
    },
    "Die Sprachausgabe läuft auf dem Gerät – nichts wird übertragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is generated on the device – nothing is transmitted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synthèse vocale fonctionne sur l’appareil – rien n’est transmis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz se genera en el dispositivo: no se transmite nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sintesi vocale avviene sul dispositivo – non viene trasmesso nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spraakuitvoer draait op het apparaat – er wordt niets verstuurd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声合成はデバイス上で行われます – 何も送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fala é gerada no dispositivo – nada é transmitido."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasový výstup běží v zařízení – nic se nepřenáší."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synteza mowy działa na urządzeniu – nic nie jest przesyłane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Озвучення працює на пристрої — нічого не передається."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синтез речи работает на устройстве — ничего не передаётся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seslendirme cihazda çalışır — hiçbir şey aktarılmaz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 출력은 기기에서 처리돼요 — 아무것도 전송되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音朗读在设备上完成——不会传输任何内容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplæsningen sker på enheden — intet bliver overført."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppläsningen sker på enheten — inget överförs."
          }
        }
      }
    },
    "Die Stimme konnte nichts erzeugen. Andere Stimme wählen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This voice couldn’t produce anything. Choose another voice?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette voix n’a rien pu produire. Choisir une autre voix ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz no ha podido generar nada. ¿Elegir otra voz?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa voce non ha prodotto nulla. Scegliere un’altra voce?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze stem kon niets maken. Een andere stem kiezen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声では生成できませんでした。別の音声を選びますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz não conseguiu gerar nada. Escolher outra voz?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento hlas nedokázal nic vytvořit. Vybrat jiný hlas?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten głos nic nie wygenerował. Wybrać inny głos?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей голос нічого не зміг створити. Вибрати інший голос?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот голос ничего не смог произнести. Выбрать другой?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses hiçbir şey üretemedi. Başka bir ses seçilsin mi?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목소리로는 만들 수 없었어요. 다른 목소리를 고를까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语音无法生成内容。要选择其他语音吗？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen kunne ikke frembringe noget. Vælg en anden stemme?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rösten kunde inte skapa något. Välja en annan röst?"
          }
        }
      }
    },
    "Die Zwiebelhaut zeigt das vorige Bild durchscheinend – so sieht man den letzten Schritt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onion skin shows the previous frame see-through – so you can see the last step."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelure d’oignon montre l’image précédente en transparence – on voit ainsi le dernier pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El papel cebolla muestra el fotograma anterior en transparencia: así se ve el último paso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onion skin mostra il fotogramma precedente in trasparenza – così si vede l’ultimo passo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onion skin toont het vorige beeld doorschijnend – zo zie je de laatste stap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オニオンスキンは前のコマを透かして表示します – 直前の一歩がわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O papel cebola mostra o quadro anterior transparente – assim você vê o último passo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cibulová slupka ukazuje předchozí snímek průsvitně – tak vidíš poslední krok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skórka cebuli pokazuje poprzednią klatkę półprzezroczyście – tak widać ostatni krok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Калька показує попередній кадр напівпрозоро — так видно останній крок."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калька показывает предыдущий кадр полупрозрачно — так виден последний шаг."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soğan kabuğu önceki kareyi yarı saydam gösterir — böylece son adımı görürsünüz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어니언 스킨은 이전 프레임을 반투명하게 보여 줘요 — 그래서 마지막 단계를 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洋葱皮会半透明地显示上一帧——这样就能看到上一步。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løgskind viser det forrige billede gennemsigtigt — så kan du se det sidste skridt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lökskalet visar föregående bild genomskinligt — så ser du det senaste steget."
          }
        }
      }
    },
