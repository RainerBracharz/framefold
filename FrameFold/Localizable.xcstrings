    "Fokus findet nichts Scharfes. Liegt das Werk im Bildfeld der Kamera?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus can't find anything sharp. Is your work within the camera's view?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise au point ne trouve rien de net. Ton œuvre est-elle dans le champ de la caméra ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enfoque no encuentra nada nítido. ¿Está tu obra dentro del campo de la cámara?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La messa a fuoco non trova niente di nitido. L’opera è nel campo della fotocamera?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De focus vindt niets scherps. Ligt het werk in het beeldveld van de camera?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピントの合う対象が見つかりません。作品はカメラの画角に入っていますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O foco não encontra nada nítido. Sua obra está no campo de visão da câmera?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostření nenachází nic ostrého. Je dílo v záběru kamery?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrość nie znajduje nic ostrego. Czy praca jest w polu widzenia kamery?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус не знаходить нічого різкого. Чи робота в полі зору камери?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус не находит резкости. Работа точно в поле зрения камеры?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak net bir şey bulamıyor. Eser kameranın görüş alanında mı?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선명한 곳을 찾지 못했어요. 작품이 카메라 화각 안에 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对焦找不到清晰的对象。作品是否在相机的视野内？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus finder ikke noget skarpt. Er dit værk inden for kameraets synsfelt?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus hittar inget skarpt. Ligger ditt verk inom kamerans bildfält?"
          }
        }
      }
    },
    "Fokus findet nichts Scharfes. Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus can't find anything sharp. Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise au point ne trouve rien de net. Touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enfoque no encuentra nada nítido. Toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La messa a fuoco non trova niente di nitido. Tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De focus vindt niets scherps. Tik in de zoeker op je werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピントの合う対象が見つかりません。ファインダーで作品をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O foco não encontra nada nítido. Toque na sua obra no visor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostření nenachází nic ostrého. Klepni v hledáčku na své dílo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrość nie znajduje nic ostrego. Stuknij w wizjerze swoją pracę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус не знаходить нічого різкого. Торкнися у видошукачі своєї роботи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус не находит резкости. Коснитесь работы в видоискателе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak net bir şey bulamıyor. Vizörde eserinize dokunun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선명한 곳을 찾지 못했어요. 뷰파인더에서 작품을 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对焦找不到清晰的对象。请在取景器中轻点你的作品。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus finder ikke noget skarpt. Tryk på dit værk i søgeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus hittar inget skarpt. Tryck på ditt verk i sökaren."
          }
        }
      }
    },
