    "Die Farbe wird beim Export durch den Hintergrund ersetzt – ein Bild oder ein Film, der Bild für Bild mitläuft.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colour is replaced by the background on export – an image, or a movie that follows frame by frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur est remplacée par l’arrière-plan à l’export – une image ou un film qui suit image par image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al exportar, el color se sustituye por el fondo: una imagen o una película que avanza fotograma a fotograma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’esportazione il colore viene sostituito dallo sfondo: un’immagine o un filmato che scorre fotogramma per fotogramma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kleur wordt bij het exporteren vervangen door de achtergrond – een beeld of een film die beeld voor beeld meeloopt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し時にこの色が背景に置き換わります – 画像、またはコマごとに進む動画。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na exportação, a cor é substituída pelo fundo – uma imagem ou um filme que acompanha quadro a quadro."
          }
        }
      }
    },
