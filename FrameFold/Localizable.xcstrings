    "Blendet das nächste Bild ein — als Falzkante, als triangulierte Facetten oder als eingewobene Bildstreifen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings in the next frame — as a crease, as triangulated facets, or as woven strips."
          }
        }
      }
    },
    "Blendet das vorherige Bild halbtransparent über den Sucher.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lays the previous frame over the viewfinder, half transparent."
          }
        }
      }
    },
    "Das Stopmotion-Video konnte nicht geschrieben werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stop-motion video couldn't be written."
          }
        }
      }
    },
    "Das Video ist leer oder konnte nicht gelesen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video is empty or couldn't be read."
