    "Szene wirkt dauerhaft unruhig. Kamerahalterung prüfen – oder in den Einstellungen die Bewegungs-Toleranz erhöhen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scene never settles. Check the camera mount — or raise the motion tolerance in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La scène ne se stabilise jamais. Vérifie le support de la caméra — ou augmente la tolérance au mouvement dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escena nunca se queda quieta. Revisa el soporte de la cámara, o sube la tolerancia de movimiento en los ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scena non si ferma mai. Controlla il supporto della fotocamera, oppure aumenta la tolleranza al movimento nelle impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scène blijft onrustig. Controleer de camerahouder – of verhoog in de instellingen de bewegingstolerantie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーンが落ち着きません。カメラの固定を確認するか、設定で動きの許容度を上げてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cena nunca se acalma. Verifique a fixação da câmera — ou aumente a tolerância de movimento nos ajustes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Scéna je pořád neklidná. Zkontroluj držák kamery – nebo v nastavení zvyš toleranci pohybu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scena wciąż jest niespokojna. Sprawdź uchwyt kamery – albo zwiększ w ustawieniach tolerancję ruchu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцена постійно неспокійна. Перевір кріплення камери — або збільш допуск руху в налаштуваннях."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцена никак не успокаивается. Проверьте крепление камеры — или увеличьте допуск движения в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahne bir türlü durulmuyor. Kamera tutucusunu kontrol edin — ya da ayarlardan hareket toleransını artırın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장면이 계속 안정되지 않아요. 카메라 거치대를 확인하거나 설정에서 움직임 허용치를 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景始终无法静止。请检查相机支架——或在设置中调高动作容差。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen falder aldrig til ro. Tjek kameraholderen — eller hæv bevægelsestolerancen i indstillingerne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen lugnar aldrig ner sig. Kontrollera kamerafästet — eller höj rörelsetoleransen i inställningarna."
          }
        }
      }
    },
    "Szene wirkt dauerhaft unruhig. Stativ prüfen – oder in den Einstellungen die Bewegungs-Toleranz erhöhen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scene never settles. Check the tripod — or raise the motion tolerance in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La scène ne se stabilise jamais. Vérifie le trépied — ou augmente la tolérance au mouvement dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escena nunca se queda quieta. Revisa el trípode, o sube la tolerancia de movimiento en los ajustes."
          }
        },
        "it": {
          "stringUnit": {
