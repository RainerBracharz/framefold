    "Spracherkennung und Sprachausgabe laufen auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition and speech output run on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance et la synthèse vocales fonctionnent sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento y la síntesis de voz funcionan en el dispositivo."
          }
        },
