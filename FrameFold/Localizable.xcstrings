    "Szene wirkt dauerhaft unruhig. Kamerahalterung prüfen – oder in den Einstellungen die Bewegungs-Toleranz erhöhen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scene never settles. Check the camera mount — or raise the motion tolerance in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La scène ne se stabilise jamais. Vérifie le support de la caméra — ou augmente la tolérance au mouvement dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escena nunca se queda quieta. Revisa el soporte de la cámara, o sube la tolerancia de movimiento en los ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scena non si ferma mai. Controlla il supporto della fotocamera, oppure aumenta la tolleranza al movimento nelle impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scène blijft onrustig. Controleer de camerahouder – of verhoog in de instellingen de bewegingstolerantie."
          }
        }
      }
    },
    "Szene wirkt dauerhaft unruhig. Stativ prüfen – oder in den Einstellungen die Bewegungs-Toleranz erhöhen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scene never settles. Check the tripod — or raise the motion tolerance in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La scène ne se stabilise jamais. Vérifie le trépied — ou augmente la tolérance au mouvement dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escena nunca se queda quieta. Revisa el trípode, o sube la tolerancia de movimiento en los ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scena non si ferma mai. Controlla il treppiede, oppure aumenta la tolleranza al movimento nelle impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scène blijft onrustig. Controleer het statief – of verhoog in de instellingen de bewegingstolerantie."
          }
        }
      }
    },
