            "value": "Poprzednia klatka delikatnie prześwituje w następnej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній кадр ледь проступає в наступному."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
