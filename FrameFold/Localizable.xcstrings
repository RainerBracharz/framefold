          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreren – even stilhouden…"
          }
        }
      }
    },
    "Kamera-Tab am iPhone öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the camera tab on iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’onglet Caméra sur l’iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pestaña Cámara en el iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la scheda Fotocamera sull’iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het cameratabblad op de iPhone"
          }
        }
      }
    },
    "Keine Kamera angeschlossen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera connected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune caméra branchée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cámara conectada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fotocamera collegata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen camera aangesloten."
          }
        }
      }
    },
    "Ideal ist eine Dokumentenkamera, die senkrecht von oben auf den Tisch blickt. Eine angesteckte USB-Kamera wählt FrameFold von selbst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A document camera looking straight down at the table works best. FrameFold picks a connected USB camera on its own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'idéal est une caméra document qui regarde la table à la verticale. FrameFold choisit de lui-même une caméra USB branchée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo ideal es una cámara de documentos que mire en vertical a la mesa. FrameFold elige sola una cámara USB conectada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ideale è una document camera che guarda il tavolo in verticale dall’alto. FrameFold sceglie da solo una fotocamera USB collegata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideaal is een documentcamera die loodrecht van boven op de tafel kijkt. Een aangesloten USB-camera kiest FrameFold vanzelf."
          }
        }
      }
    },
    "Kamera über dem Tisch, automatisch auslösen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera above the table, fires by itself"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra au-dessus de la table, déclenchement automatique"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara sobre la mesa, disparo automático"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera sopra il tavolo, scatta da sola"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera boven de tafel, drukt vanzelf af"
          }
        }
      }
    },
    "Keine ruhigen Momente gefunden. Halte beim Filmen zwischendurch kurz still – oder nimm etwas länger auf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calm moments found. Hold still for a moment now and then while filming – or record a little longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun moment calme trouvé. Reste immobile un instant de temps en temps pendant le tournage – ou filme un peu plus longtemps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron momentos de calma. Al grabar, quédate quieto de vez en cuando, o graba un poco más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun momento di calma trovato. Mentre riprendi, fermati ogni tanto, oppure riprendi un po’ più a lungo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen rustige momenten gevonden. Houd tijdens het filmen af en toe even stil – of neem wat langer op."
          }
        }
      }
    },
