    "Blendet das nächste Bild ein — als Falzkante, als triangulierte Facetten oder als eingewobene Bildstreifen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings in the next frame — as a crease, as triangulated facets, or as woven strips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait apparaître l’image suivante — en pli, en facettes triangulées ou en bandes tissées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funde el siguiente fotograma: como pliegue, como facetas trianguladas o como tiras de imagen entretejidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa entrare il fotogramma successivo: come piega, come sfaccettature triangolate o come strisce intrecciate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het volgende beeld binnenkomen — als vouw, als getrianguleerde facetten of als geweven beeldstroken."
          }
        }
      }
    },
    "Blendet das vorherige Bild halbtransparent über den Sucher.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lays the previous frame over the viewfinder, half transparent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpose l’image précédente au viseur, en transparence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpone el fotograma anterior en el visor, semitransparente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrappone al mirino il fotogramma precedente, semitrasparente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt het vorige beeld halfdoorzichtig over de zoeker."
          }
        }
      }
    },
