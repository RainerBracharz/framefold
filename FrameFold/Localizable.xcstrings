    "Kamera über den Tisch, arbeiten. Es löst von selbst aus, sobald deine Hände aus dem Bild sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera above the table, then work. It fires by itself as soon as your hands leave the frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra au-dessus de la table, et au travail. Elle déclenche toute seule dès que tes mains quittent le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara sobre la mesa y a trabajar. Dispara sola en cuanto tus manos salen del encuadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera sopra il tavolo, e al lavoro. Scatta da sola appena le tue mani escono dall’inquadratura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera boven de tafel, aan het werk. Hij drukt vanzelf af zodra je handen uit beeld zijn."
          }
        }
      }
    },
    "Kamera über den Tisch. FrameFold löst aus, sobald deine Hände aus dem Bild sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera above the table. FrameFold fires as soon as your hands leave the frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra au-dessus de la table. FrameFold déclenche dès que tes mains quittent le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara sobre la mesa. FrameFold dispara en cuanto tus manos salen del encuadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera sopra il tavolo. FrameFold scatta appena le tue mani escono dall’inquadratura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera boven de tafel. FrameFold drukt af zodra je handen uit beeld zijn."
          }
        }
      }
    },
    "Kein Kamerazugriff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès à la caméra"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a la cámara"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso alla fotocamera"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen cameratoegang"
          }
        }
      }
    },
    "Keine Kamera gefunden. Schließ eine USB-Kamera an – etwa eine Dokumentenkamera über dem Tisch – oder nimm dein iPhone als Kamera. Videos kannst du im Video-Tab trotzdem verarbeiten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera found. Connect a USB camera – a document camera above the table, for instance – or use your iPhone as a camera. You can still process videos in the Video tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune caméra trouvée. Branche une caméra USB – par exemple une caméra de documents au-dessus de la table – ou utilise ton iPhone comme caméra. Tu peux tout de même traiter des vidéos dans l’onglet Vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna cámara. Conecta una cámara USB (por ejemplo, una cámara de documentos sobre la mesa) o usa tu iPhone como cámara. Aun así puedes procesar vídeos en la pestaña Vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fotocamera trovata. Collega una fotocamera USB (ad esempio una document camera sopra il tavolo) o usa il tuo iPhone come fotocamera. Puoi comunque elaborare video nella scheda Video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen camera gevonden. Sluit een USB-camera aan – bijvoorbeeld een documentcamera boven de tafel – of gebruik je iPhone als camera. Video’s kun je nog steeds verwerken op het tabblad Video."
          }
        }
      }
    },
    "Keine Kamera verfügbar": {
      "localizations": {
