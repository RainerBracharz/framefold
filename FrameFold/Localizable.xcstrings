      "shouldTranslate": false
    },
    "FrameFold findet die ruhigen Momente und verwirft Bilder, auf denen deine Hände zu sehen sind. Alles bleibt auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold finds the calm moments and drops any frame with your hands in it. Everything stays on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold repère les moments calmes et écarte chaque image où l’on voit tes mains. Tout reste sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold encuentra los momentos de calma y descarta los fotogramas en los que se ven tus manos. Todo se queda en el dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold trova i momenti di calma e scarta i fotogrammi in cui si vedono le tue mani. Tutto resta sul dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold vindt de rustige momenten en laat beelden weg waarop je handen te zien zijn. Alles blijft op het apparaat."
          }
        }
      }
    },
