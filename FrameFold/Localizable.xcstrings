          "stringUnit": {
            "state": "translated",
            "value": "Har kameraet flyttet sig? Baggrunden ligger anderledes end i det første billede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har kameran flyttats? Bakgrunden ligger annorlunda än i första bilden."
