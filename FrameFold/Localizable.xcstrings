    "Ein Film läuft Bild für Bild mit: Bild n zeigt die Stelle n ÷ Bildrate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A movie follows frame by frame: frame n shows the point n ÷ frame rate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un film suit image par image : l’image n montre l’instant n ÷ cadence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una película avanza fotograma a fotograma: el fotograma n muestra el punto n ÷ velocidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filmato scorre fotogramma per fotogramma: il fotogramma n mostra il punto n ÷ frame rate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een film loopt beeld voor beeld mee: beeld n toont het punt n ÷ beeldsnelheid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画はコマごとに進みます：n コマ目には n ÷ フレームレートの時点が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um filme acompanha quadro a quadro: o quadro n mostra o ponto n ÷ taxa de quadros."
          }
        }
      }
    },
    "Endzeit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End time"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure de fin"
