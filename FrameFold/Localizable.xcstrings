    "Daumenkino und Kontaktbogen gibt es als PDF zum Drucken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flip book and contact sheet are available as PDFs to print."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le folioscope et la planche contact sont disponibles en PDF à imprimer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flipbook y la hoja de contactos están disponibles en PDF para imprimir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipbook e provino sono disponibili in PDF da stampare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipboek en contactvel zijn er als pdf om af te drukken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラパラ漫画とコンタクトシートは印刷用 PDF で用意できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipbook e folha de contato estão disponíveis como PDFs para imprimir."
          }
        }
      }
    },
    "Der Auto-Auslöser wartet, bis die Szene ruhig ist und keine Hände zu sehen sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The auto shutter waits until the scene is still and no hands are visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déclencheur auto attend que la scène soit immobile et qu’aucune main ne soit visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disparador automático espera a que la escena esté quieta y no se vean manos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scatto automatico attende che la scena sia ferma e che non si vedano mani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De auto-ontspanner wacht tot de scène stil is en er geen handen te zien zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートシャッターは、シーンが静止して手が見えなくなるまで待ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O obturador automático espera até a cena ficar parada e nenhuma mão aparecer."
          }
        }
      }
    },
    "Die Sprachausgabe läuft auf dem Gerät – nichts wird übertragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is generated on the device – nothing is transmitted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synthèse vocale fonctionne sur l’appareil – rien n’est transmis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz se genera en el dispositivo: no se transmite nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sintesi vocale avviene sul dispositivo – non viene trasmesso nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spraakuitvoer draait op het apparaat – er wordt niets verstuurd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声合成はデバイス上で行われます – 何も送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fala é gerada no dispositivo – nada é transmitido."
          }
        }
      }
    },
    "Die Stimme konnte nichts erzeugen. Andere Stimme wählen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This voice couldn’t produce anything. Choose another voice?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette voix n’a rien pu produire. Choisir une autre voix ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz no ha podido generar nada. ¿Elegir otra voz?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa voce non ha prodotto nulla. Scegliere un’altra voce?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze stem kon niets maken. Een andere stem kiezen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声では生成できませんでした。別の音声を選びますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta voz não conseguiu gerar nada. Escolher outra voz?"
          }
        }
      }
    },
    "Die Zwiebelhaut zeigt das vorige Bild durchscheinend – so sieht man den letzten Schritt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onion skin shows the previous frame see-through – so you can see the last step."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelure d’oignon montre l’image précédente en transparence – on voit ainsi le dernier pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El papel cebolla muestra el fotograma anterior en transparencia: así se ve el último paso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onion skin mostra il fotogramma precedente in trasparenza – così si vede l’ultimo passo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onion skin toont het vorige beeld doorschijnend – zo zie je de laatste stap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オニオンスキンは前のコマを透かして表示します – 直前の一歩がわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O papel cebola mostra o quadro anterior transparente – assim você vê o último passo."
          }
        }
      }
    },
