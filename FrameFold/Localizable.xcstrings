    "Einfach: nur Auslöser und Fertig. Alles Weitere erscheint ab \"Erweitert\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple: just the shutter and Done. Everything else appears from \"Advanced\" on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple : juste le déclencheur et Terminé. Le reste apparaît à partir du mode « Avancé »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sencillo: solo el obturador y Listo. Todo lo demás aparece a partir de «Avanzado»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
