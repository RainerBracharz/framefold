    "10 Bilder sind eine Sekunde Film bei 10 Bildern pro Sekunde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 frames make one second of film at 10 frames per second."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 images font une seconde de film à 10 images par seconde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10 fotogramas son un segundo de película a 10 fotogramas por segundo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "10 fotogrammi sono un secondo di film a 10 fotogrammi al secondo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 beelden zijn één seconde film bij 10 beelden per seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 fps なら、10 コマで映像 1 秒分です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "10 quadros dão um segundo de filme a 10 quadros por segundo."
          }
        }
      }
    },
    "Ab „Erweitert“ zeigt die Kamera am Mac und iPad die Studio-Arbeitsfläche, am iPhone nach Einschalten in den Kamera-Einstellungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From “Advanced” on, the camera shows the studio workspace on Mac and iPad – on iPhone after switching it on in the camera settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du mode « Avancé », la caméra affiche l’espace studio sur Mac et iPad – sur iPhone après l’avoir activé dans les réglages de la caméra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de «Avanzado», la cámara muestra el espacio de estudio en Mac y iPad; en el iPhone, tras activarlo en los ajustes de la cámara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da «Avanzata» in poi, la fotocamera mostra lo spazio studio su Mac e iPad – su iPhone dopo averlo attivato nelle impostazioni della fotocamera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf ‘Uitgebreid’ toont de camera op Mac en iPad de studio-werkruimte – op iPhone nadat je die in de camera-instellingen hebt ingeschakeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「詳細」以降、Mac と iPad ではカメラに Studio の作業スペースが表示されます。iPhone ではカメラの設定でオンにすると表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir do “Avançado”, a câmera mostra a área de trabalho do Studio no Mac e no iPad – no iPhone, depois de ativá-la nos ajustes da câmera."
          }
        }
      }
    },
    "Alle Befehle mit Tastatur: Menü „Studio“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every command by keyboard: “Studio” menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les commandes au clavier : menu « Studio »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los comandos con el teclado: menú «Studio»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i comandi da tastiera: menu «Studio»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle opdrachten met het toetsenbord: menu ‘Studio’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコマンドはキーボードでも：「Studio」メニュー。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os comandos pelo teclado: menu “Studio”."
          }
        }
      }
    },
    "Alles lässt sich rückgängig machen: mit den Pfeil-Knöpfen oder ⌘Z.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything can be undone: with the arrow buttons or ⌘Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout peut être annulé : avec les boutons fléchés ou ⌘Z."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se puede deshacer: con los botones de flecha o ⌘Z."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto si può annullare: con i pulsanti a freccia o ⌘Z."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles kan ongedaan worden gemaakt: met de pijlknoppen of ⌘Z."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての操作は取り消せます：矢印ボタンまたは ⌘Z で。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pode ser desfeito: com os botões de seta ou ⌘Z."
          }
        }
      }
    },
    "Als Tonspur hinzufügen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add as audio track"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter comme piste audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir como pista de audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi come traccia audio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toevoegen als audiospoor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオトラックとして追加"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar como faixa de áudio"
          }
        }
      }
    },
    "Anhören": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écouter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
