    "Labor-Ansicht: Blattnummer, Sitzungsuhr, Messwerte – und der Falz-Countdown wandert in Amber um den Auslöser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab view: sheet number, session clock, readings — and the crease countdown runs in amber around the shutter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue labo : numéro de feuille, chrono de séance, mesures — et le compte à rebours du pli tourne en ambre autour du déclencheur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de laboratorio: número de hoja, reloj de sesión, mediciones, y la cuenta atrás del pliegue gira en ámbar alrededor del obturador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista laboratorio: numero del foglio, orologio della sessione, misurazioni, e il conto alla rovescia della piega gira in ambra attorno al pulsante di scatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labweergave: velnummer, sessieklok, meetwaarden – en het vouw-aftellen loopt in amber rond de ontspanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラボ表示：シート番号、セッション時間、測定値 — 折り目のカウントダウンがシャッターのまわりを琥珀色で回ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão de laboratório: número da folha, relógio da sessão, medições — e a contagem regressiva do vinco gira em âmbar ao redor do obturador."
          }
        }
      }
    },
    "Labor-Ansicht: Blattnummer, Sitzungsuhr, fixierte Belichtung, Messwerte – und der Falz-Countdown wandert in Amber um den Auslöser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab view: sheet number, session clock, locked exposure, readings — and the crease countdown runs in amber around the shutter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue labo : numéro de feuille, chrono de séance, exposition verrouillée, mesures — et le compte à rebours du pli tourne en ambre autour du déclencheur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de laboratorio: número de hoja, reloj de sesión, exposición bloqueada, mediciones, y la cuenta atrás del pliegue gira en ámbar alrededor del obturador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista laboratorio: numero del foglio, orologio della sessione, esposizione bloccata, misurazioni, e il conto alla rovescia della piega gira in ambra attorno al pulsante di scatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labweergave: velnummer, sessieklok, vastgezette belichting, meetwaarden – en het vouw-aftellen loopt in amber rond de ontspanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラボ表示：シート番号、セッション時間、固定した露出、測定値 — 折り目のカウントダウンがシャッターのまわりを琥珀色で回ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão de laboratório: número da folha, relógio da sessão, exposição travada, medições — e a contagem regressiva do vinco gira em âmbar ao redor do obturador."
          }
        }
      }
    },
