    "Der Film läuft ab Bild %lld mit. Vorhandener Ton spielt während der Aufnahme nicht, damit er nicht mit aufgenommen wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The film plays along from frame %lld. Existing sound is not played during recording, so headphones aren’t needed to keep it out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le film défile à partir de l’image %lld. Le son existant n’est pas joué pendant l’enregistrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La película se reproduce desde el fotograma %lld. El sonido existente no suena durante la grabación, para que no se grabe también."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il film scorre dal fotogramma %lld. Il suono esistente non viene riprodotto durante la registrazione, così non finisce nella ripresa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De film speelt mee vanaf beeld %lld. Bestaand geluid speelt tijdens de opname niet, zodat het niet mee wordt opgenomen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像は %lld コマ目から一緒に再生されます。録音中は既存のサウンドが再生されないので、ヘッドフォンがなくても音が入りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O filme toca junto a partir do quadro %lld. O som existente não é reproduzido durante a gravação, então não é preciso usar fones de ouvido para evitá-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Film běží od snímku %lld s sebou. Stávající zvuk se při nahrávání nepřehrává, aby se nenahrál znovu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film odtwarza się od klatki %lld. Istniejący dźwięk nie gra podczas nagrywania, żeby się nie nagrał."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільм іде від кадру %lld. Наявний звук під час запису не грає, щоб не записатися ще раз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильм идёт с кадра %lld. Имеющийся звук во время записи не играет, чтобы не попасть в запись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Film %lld. kareden itibaren eşlik eder. Mevcut ses kayda karışmasın diye kayıt sırasında çalınmaz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상이 프레임 %lld부터 함께 재생돼요. 기존 사운드는 함께 녹음되지 않도록 녹음 중에는 재생되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影片从第 %lld 帧起同步播放。录制期间不会播放已有的声音，以免被一起录进去。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmen afspilles med fra billede %lld. Eksisterende lyd afspilles ikke under optagelsen, så den ikke kommer med på optagelsen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmen spelas upp från bild %lld. Befintligt ljud spelas inte under inspelningen, så att det inte kommer med i inspelningen."
          }
        }
      }
    },
    "Titel (optional)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title (optional)"
