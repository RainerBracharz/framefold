    "So lange muss die Szene ruhig sein, bevor automatisch ausgelöst wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the scene has to stay calm before the shutter fires."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle la scène doit rester calme avant le déclenchement automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo que la escena debe estar quieta antes del disparo automático."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto deve restare ferma la scena prima dello scatto automatico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo lang moet de scène stil zijn voordat er automatisch wordt afgedrukt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッターが切れるまでに、シーンが静止している必要がある時間。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo a cena precisa ficar parada antes de o obturador disparar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak dlouho musí být scéna v klidu, než se automaticky spustí spoušť."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyle czasu scena musi być spokojna, zanim zdjęcie zrobi się samo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки сцена має бути нерухомою, перш ніж затвор спрацює сам."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько сцена должна оставаться спокойной, прежде чем сработает затвор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklanşör çalışmadan önce sahnenin ne kadar süre sakin kalması gerektiği."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 촬영 전에 장면이 멈춰 있어야 하는 시간이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景需要静止这么久，才会自动拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så længe skal scenen være rolig, før der automatisk tages et billede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så länge måste scenen vara lugn innan en bild tas automatiskt."
          }
        }
      }
    },
    "Standard erfasst großzügig. Unerwünschte Bilder oben einfach abwählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default errs on the generous side. Just deselect what you don't want above."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, la sélection est généreuse. Désélectionne simplement ci-dessus ce que tu ne veux pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción estándar es generosa. Simplemente quita arriba los fotogramas que no quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impostazione standard è generosa. Deseleziona qui sopra i fotogrammi che non vuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaard pakt ruim. Haal ongewenste beelden hierboven gewoon weg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定は多めに選んであります。不要なものは上で選択を解除してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão é generoso. É só desmarcar acima o que você não quiser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí nastavení bere velkoryse. Nechtěné snímky nahoře prostě odznač."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wybór jest hojny. Niechciane klatki po prostu odznacz powyżej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово вибір щедрий. Небажані кадри вгорі просто зніми з вибору."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию берётся с запасом. Лишние кадры просто снимите с выбора выше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan ayar cömert davranır. İstemediğiniz karelerin seçimini yukarıda kaldırın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 넉넉하게 잡아요. 원하지 않는 프레임은 위에서 선택 해제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认设置会尽量多选。只需在上方取消不想要的帧。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarden tager generøst med. Fravælg bare de billeder ovenfor, du ikke vil have."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardläget tar med generöst. Välj bara bort de bilder ovan som du inte vill ha."
          }
        }
      }
    },
