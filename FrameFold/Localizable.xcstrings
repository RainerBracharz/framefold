    "Scharf gestellt und fixiert. Wirkt es unscharf? Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focused and locked. Looks soft? Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise au point faite et verrouillée. C’est flou ? Touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfocado y bloqueado. ¿Se ve borroso? Toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A fuoco e bloccato. Sembra sfocato? Tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scherpgesteld en vastgezet. Lijkt het onscherp? Tik in de zoeker op je werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピントを合わせて固定しました。ぼやけて見える場合は、ファインダーで作品をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Focado e travado. Parece sem nitidez? Toque na sua obra no visor."
          }
        }
      }
    },
    "Schließen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar"
          }
        }
      }
    },
    "Schwarzweiß mit warmem Papierton — wie ein abfotografierter Druck.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black and white on a warm paper tone — like a print photographed again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noir et blanc sur un ton papier chaud — comme un tirage rephotographié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanco y negro sobre un tono de papel cálido, como una impresión vuelta a fotografiar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bianco e nero su un tono carta caldo, come una stampa fotografata di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwart-wit met een warme papiertoon — als een opnieuw gefotografeerde afdruk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かみのある紙の色に白黒 — プリントをもう一度撮影したように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preto e branco num tom de papel quente — como uma cópia fotografada de novo."
          }
        }
      }
    },
    "Schärfe bricht immer wieder weg. Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharpness keeps dropping. Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La netteté se perd sans cesse. Touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nitidez se pierde una y otra vez. Toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nitidezza continua a calare. Tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scherpte valt steeds weg. Tik in de zoeker op je werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピントが落ち続けています。ファインダーで作品をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nitidez continua caindo. Toque na sua obra no visor."
          }
        }
      }
    },
