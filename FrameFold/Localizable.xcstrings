    "Diese Kamera lässt sich über USB nicht auslösen – den Kamera-Ordner nutzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This camera can’t be triggered over USB – use the camera folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas être déclenché par USB – utilise le dossier de l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no se puede disparar por USB: usa la carpeta de la cámara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fotocamera non può scattare via USB – usa la cartella fotocamera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze camera kan niet via USB worden afgedrukt – gebruik de cameramap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラは USB で撮影できません – カメラフォルダを使ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta câmera não pode ser disparada por USB – use a pasta da câmera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto kameru nelze spustit přes USB – použij složku kamery."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego aparatu nie da się wyzwolić przez USB – użyj folderu aparatu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю камеру не можна спустити через USB – скористайся текою камери."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту камеру нельзя спустить через USB — используйте папку камеры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kamera USB üzerinden çekim yapamıyor – kamera klasörünü kullanın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카메라는 USB로 촬영할 수 없어요 – 카메라 폴더를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台相机无法通过 USB 拍摄 – 请使用相机文件夹。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kamera kan ikke udløses via USB – brug kameramappen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här kameran kan inte utlösas via USB – använd kameramappen."
          }
        }
      }
    },
    "Diese Kamera meldet kein Auslösen über USB – den Kamera-Ordner nutzen.": {
