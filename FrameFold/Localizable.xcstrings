    "Alles dabei — plus die Spezialfeatures: Facetten, Echo, Faltvorlage, Rekursion, Ausstellung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything, plus the studio effects: facets, echo, fold template, recursion, exhibition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout, plus les effets d’atelier : facettes, écho, gabarit de pliage, récursion, exposition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo, más los efectos de taller: facetas, eco, plantilla de plegado, recursión, exposición."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto, più gli effetti d’atelier: sfaccettature, eco, modello di piegatura, ricorsione, mostra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, plus de atelier-effecten: facetten, echo, vouwsjabloon, recursie, tentoonstelling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能に加えて、Studio のエフェクト：ファセット、エコー、折りテンプレート、再帰、展示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo, mais os efeitos do Studio: facetas, eco, molde de dobra, recursão, exposição."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechno — plus speciální efekty: fasety, echo, šablona skládání, rekurze, výstava."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko — plus efekty specjalne: fasety, echo, szablon składania, rekurencja, wystawa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе — плюс спецефекти: фасети, відлуння, шаблон складання, рекурсія, виставка."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё сразу — плюс особые эффекты: грани, эхо, шаблон складывания, рекурсия, выставка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey dahil — artı özel efektler: yüzeyler, yankı, katlama şablonu, özyineleme, sergi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 다 — 여기에 특수 효과까지: 면 분할, 에코, 접기 템플릿, 재귀, 전시."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应有尽有——外加特色效果：多面、回声、折叠模板、递归、展览。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt med — plus specialeffekterne: facetter, ekko, foldeskabelon, rekursion, udstilling."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt ingår — plus specialeffekterna: fasetter, eko, vikmall, rekursion, utställning."
          }
        }
      }
    },
