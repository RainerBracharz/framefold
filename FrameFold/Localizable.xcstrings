    "Kein Mikrofonzugriff – erlauben unter Einstellungen → Datenschutz → Mikrofon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone access – allow it in Settings → Privacy → Microphone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès au micro – autorise-le dans Réglages → Confidentialité → Micro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono: permítelo en Ajustes → Privacidad → Micrófono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al microfono: consentilo in Impostazioni → Privacy → Microfono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen microfoontoegang – sta het toe via Instellingen → Privacy → Microfoon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがありません –「設定」→「プライバシー」→「マイク」で許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao microfone – permita em Ajustes → Privacidade → Microfone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez přístupu k mikrofonu – povol ho v Nastavení → Soukromí → Mikrofon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do mikrofonu – zezwól w Ustawieniach → Prywatność → Mikrofon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до мікрофона — дозволь у Параметрах → Приватність → Мікрофон."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к микрофону — разрешите в Настройках → Конфиденциальность → Микрофон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erişimi yok — Ayarlar → Gizlilik → Mikrofon bölümünden izin verin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한 없음 — 설정 → 개인정보 보호 → 마이크에서 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无麦克风访问权限——请在“设置” → “隐私” → “麦克风”中允许。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofonadgang — tillad det under Indstillinger → Anonymitet → Mikrofon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofonåtkomst — tillåt det under Inställningar → Integritet → Mikrofon."
          }
        }
      }
    },
