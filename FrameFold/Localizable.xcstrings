    "Zu viel Bewegung – steht die Kamera wirklich fest?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much movement — is the camera really fixed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de mouvement — la caméra est-elle bien fixée ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado movimiento: ¿está la cámara realmente fija?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo movimento: la fotocamera è davvero fissa?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel beweging – staat de camera echt vast?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動きが多すぎます — カメラはしっかり固定されていますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimento demais — a câmera está mesmo fixa?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho pohybu – stojí kamera opravdu pevně?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo ruchu – czy kamera naprawdę stoi stabilnie?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато руху — камера справді стоїть нерухомо?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много движения — камера точно закреплена?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla hareket var — kamera gerçekten sabit mi?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직임이 너무 많아요 — 카메라가 제대로 고정되어 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作太多——相机真的固定好了吗？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For meget bevægelse — står kameraet virkelig fast?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För mycket rörelse — står kameran verkligen stadigt?"
          }
        }
      }
    },
    "Zu viel Wackeln – leg das iPhone irgendwo auf oder lehne es an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much shake — set the phone down or lean it against something."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de secousses — pose l’iPhone ou appuie-le contre quelque chose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado temblor: apoya el iPhone en algún sitio o recuéstalo contra algo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo mosso: posa l’iPhone da qualche parte o appoggialo a qualcosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel trilling – leg de iPhone ergens neer of zet hem ergens tegenaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "揺れが大きすぎます — スマートフォンを置くか、何かに立てかけてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tremor demais — apoie o telefone ou encoste-o em algo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moc se to třese – polož iPhone nebo ho o něco opři."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo drgań – połóż gdzieś iPhone’a albo o coś go oprzyj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато трусіння — поклади iPhone або обіпри його на щось."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком сильно трясётся — положите iPhone или прислоните его к чему-нибудь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla sarsıntı var — iPhone'u bir yere koyun ya da bir şeye yaslayın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 흔들려요 — iPhone을 어딘가에 내려놓거나 기대어 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抖动太大——请把 iPhone 放下或靠在某处。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For meget rysten — læg iPhonen ned eller stil den op ad noget."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För mycket skakningar — lägg ner iPhonen eller luta den mot något."
          }
        }
      }
    },
