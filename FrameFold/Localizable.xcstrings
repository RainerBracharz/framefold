    "Kamera verrutscht? Der Hintergrund liegt anders als beim ersten Bild.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera moved? The background sits differently than in the first frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra a bougé ? L’arrière-plan n’est plus placé comme sur la première image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Se movió la cámara? El fondo no está igual que en el primer fotograma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera spostata? Lo sfondo non è più come nel primo fotogramma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera verschoven? De achtergrond ligt anders dan bij het eerste beeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが動きましたか？ 背景が最初のコマと違う位置にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera se mexeu? O fundo está diferente do primeiro quadro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunula se kamera? Pozadí leží jinak než na prvním snímku."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera się przesunęła? Tło leży inaczej niż na pierwszej klatce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера зсунулася? Тло лежить інакше, ніж на першому кадрі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера сдвинулась? Фон лежит иначе, чем на первом кадре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera mı kaydı? Arka plan ilk karedekinden farklı duruyor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 움직였나요? 배경이 첫 프레임과 다르게 보여요."
