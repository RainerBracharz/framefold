    "Ein Bild lange drücken und „Text & Zeichnen …“ wählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a frame and choose “Text & drawing …”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une image et choisissez « Texte et dessin … »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un fotograma y elige «Texto y dibujo …»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un fotogramma e scegli «Testo e disegno …»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een beeld ingedrukt en kies ‘Tekst en tekenen …’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマを長押しして「テキストと描画…」を選びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um quadro e escolha “Texto e desenho…”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž snímek a vyber „Text a kreslení…“."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klatkę i wybierz „Tekst i rysowanie…”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуй кадр і вибери «Текст і малювання…»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте кадр и выберите «Текст и рисунок…»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kareye uzun basın ve “Metin ve çizim…” seçin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임을 길게 누르고 '텍스트 및 그리기…'를 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按一帧，然后选择“文字与绘画…”。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på et billede, og vælg “Tekst og tegning …”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll fingret på en bild och välj ”Text och teckning …”."
          }
        }
      }
    },
    "Ein Bild lange drücken: neu aufnehmen, verdoppeln, verschieben, Text & Zeichnen, Geräusch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a frame: reshoot, duplicate, move, text & drawing, sound effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long sur une image : reprendre, dupliquer, déplacer, texte et dessin, bruitage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un fotograma: repetir, duplicar, mover, texto y dibujo, efecto de sonido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un fotogramma: riscatta, duplica, sposta, testo e disegno, effetto sonoro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een beeld ingedrukt: opnieuw opnemen, dupliceren, verplaatsen, tekst & tekenen, geluidseffect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマを長押し：撮り直し、複製、移動、テキストと描画、効果音。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um quadro: tirar de novo, duplicar, mover, texto e desenho, efeito sonoro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž snímek: nasnímat znovu, zdvojit, přesunout, text a kreslení, zvukový efekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klatkę: zrób ponownie, powiel, przenieś, tekst i rysowanie, efekt dźwiękowy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуй кадр: перезняти, дублювати, перемістити, текст і малювання, звуковий ефект."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте кадр: переснять, дублировать, переместить, текст и рисунок, звуковой эффект."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kareye uzun basın: yeniden çek, çoğalt, taşı, metin ve çizim, ses efekti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임을 길게 누르면: 다시 촬영, 복제, 이동, 텍스트 및 그리기, 효과음."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按一帧：重拍、复制、移动、文字与绘画、音效。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på et billede: tag om, dupliker, flyt, tekst og tegning, lydeffekt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll fingret på en bild: ta om, duplicera, flytta, text och teckning, ljudeffekt."
          }
        }
      }
    },
    "Ein kleines Stück bewegen, Hände aus dem Bild – FrameFold löst von selbst aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move things a little, hands out of the frame – FrameFold shoots by itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bougez un peu, mains hors du cadre – FrameFold déclenche tout seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve un poco, manos fuera del encuadre: FrameFold dispara solo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta un poco, mani fuori dall’inquadratura – FrameFold scatta da solo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klein stukje bewegen, handen uit beeld – FrameFold neemt vanzelf op."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しだけ動かして、手を画面の外へ – FrameFold が自動で撮影します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova as coisas um pouquinho, tire as mãos do quadro – o FrameFold dispara sozinho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kousek pohni, ruce pryč ze záběru – FrameFold snímá sám."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń odrobinę, ręce poza kadr – FrameFold robi zdjęcie sam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трохи посунь, руки з кадру — FrameFold знімає сам."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвиньте чуть-чуть, уберите руки из кадра — FrameFold снимет сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz oynatın, ellerinizi kadrajdan çekin — FrameFold kendiliğinden çeker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금만 움직이고 손을 화면에서 빼면 — FrameFold가 저절로 촬영해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动一点点，手离开画面——FrameFold 会自动拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt tingene en lille smule, hænderne ud af billedet — FrameFold tager billedet selv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta lite grann, händerna ur bild — FrameFold tar bilden själv."
          }
        }
      }
    },
