    "Auslösen geht auch von Hand: großer Knopf, Lautstärketasten, Apple Watch, Klatschen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also shoot by hand: big button, volume buttons, Apple Watch, clapping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On peut aussi déclencher à la main : grand bouton, touches de volume, Apple Watch, applaudissement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se puede disparar a mano: botón grande, botones de volumen, Apple Watch, palmada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può scattare anche a mano: pulsante grande, tasti del volume, Apple Watch, battito di mani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook met de hand opnemen: grote knop, volumeknoppen, Apple Watch, klappen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動でも撮影できます：大きなボタン、音量ボタン、Apple Watch、拍手。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode disparar manualmente: botão grande, botões de volume, Apple Watch, palmas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímat jde i ručně: velkým tlačítkem, tlačítky hlasitosti, Apple Watch, tlesknutím."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie można zrobić też ręcznie: dużym przyciskiem, przyciskami głośności, Apple Watch, klaśnięciem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімати можна й вручну: великою кнопкою, кнопками гучності, Apple Watch, оплеском."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимать можно и вручную: большой кнопкой, кнопками громкости, с Apple Watch, хлопком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle de çekebilirsiniz: büyük düğme, ses düğmeleri, Apple Watch, alkış."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 촬영도 할 수 있어요: 큰 버튼, 음량 버튼, Apple Watch, 박수."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以手动拍摄：大按钮、音量键、Apple Watch、拍手。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også tage billeder manuelt: stor knap, lydstyrkeknapper, Apple Watch, klap."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan också ta bilder manuellt: stor knapp, volymknappar, Apple Watch, klapp."
          }
        }
      }
    },
    "Bilder per Ziehen umordnen; entfernte Bilder liegen 30 Tage im Papierkorb.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag frames to reorder; removed frames stay in the trash for 30 days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les images pour les réordonner ; les images retirées restent 30 jours dans la corbeille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los fotogramas para reordenarlos; los eliminados quedan 30 días en la papelera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i fotogrammi per riordinarli; quelli rimossi restano 30 giorni nel cestino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep beelden om ze te herschikken; verwijderde beelden blijven 30 dagen in de prullenmand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマはドラッグで並べ替え。削除したコマは 30 日間ゴミ箱に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste quadros para reordenar; quadros removidos ficam 30 dias na lixeira."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky přeuspořádáš přetažením; odebrané snímky zůstanou 30 dní v koši."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki przestawiasz przeciąganiem; usunięte klatki zostają 30 dni w koszu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри переставляються перетягуванням; вилучені кадри 30 днів лежать у кошику."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте кадры, чтобы изменить порядок; удалённые кадры хранятся в корзине 30 дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareleri sürükleyerek yeniden sıralayın; kaldırılan kareler 30 gün çöp kutusunda kalır."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그로 프레임 순서를 바꿔요. 제거한 프레임은 30일 동안 휴지통에 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动帧即可重新排序；移除的帧会在废纸篓中保留 30 天。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk billeder for at ændre rækkefølgen; fjernede billeder ligger 30 dage i papirkurven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra bilder för att ändra ordningen; borttagna bilder ligger kvar i papperskorgen i 30 dagar."
          }
        }
      }
    },
    "Bilder, Ton und Werke bleiben auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames, sound and works stay on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, son et œuvres restent sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogramas, sonido y obras se quedan en el dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogrammi, audio e opere restano sul dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beelden, geluid en werken blijven op het apparaat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマ、サウンド、作品はデバイス内にとどまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadros, som e obras ficam no dispositivo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky, zvuk a díla zůstávají v zařízení."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki, dźwięk i prace zostają na urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри, звук і роботи залишаються на пристрої."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры, звук и работы остаются на устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareler, ses ve eserler cihazda kalır."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임, 사운드, 작품은 기기에 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧、声音和作品都留在设备上。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder, lyd og værker bliver på enheden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, ljud och verk stannar på enheten."
          }
        }
      }
    },
    "Bildrate, Format und Look wählen, dann „Stopmotion exportieren“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose frame rate, format and look, then “Export stop-motion”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la cadence, le format et le look, puis « Exporter le stop motion »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la velocidad, el formato y el look, y luego «Exportar stop motion»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli frequenza, formato e look, poi «Esporta stop motion»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies beeldsnelheid, formaat en look, dan ‘Stop-motion exporteren’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームレート、アスペクト比、ルックを選んで「コマ撮りを書き出す」へ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha taxa de quadros, formato e visual, depois “Exportar stop motion”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber snímkovou frekvenci, formát a vzhled, pak „Exportovat stop motion“."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz liczbę klatek, format i wygląd, potem „Eksportuj stop motion”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери частоту кадрів, формат і стиль, потім «Експортувати стоп-моушн»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите частоту кадров, формат и стиль, затем «Экспортировать стоп-моушен»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare hızını, en-boy oranını ve görünümü seçin, ardından “Stop motion'ı dışa aktar”."
          }
        },
        "ko": {
          "stringUnit": {
