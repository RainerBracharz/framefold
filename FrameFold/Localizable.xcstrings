    "Masken, Raster, Lupe, Referenzbild mit Chroma-Key, Differenz- und Belichtungsansicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masks, grid, loupe, reference image with chroma key, difference and exposure views."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masques, grille, loupe, image de référence avec incrustation, vues différence et exposition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscaras, cuadrícula, lupa, imagen de referencia con croma, vistas de diferencia y exposición."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maschere, griglia, lente, immagine di riferimento con chroma key, viste differenza ed esposizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskers, raster, loep, referentiebeeld met chromakey, verschil- en belichtingsweergave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスク、グリッド、ルーペ、クロマキー対応の参照画像、差分表示と露出表示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscaras, grade, lupa, imagem de referência com chroma key, visualizações de diferença e de exposição."
          }
        }
      }
    },
    "Mikrofon nur auf Wunsch: für Sprachaufnahmen und das Auslösen per Klatschen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone only on request: for voice recordings and clap-to-shoot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro uniquement sur demande : pour les enregistrements vocaux et le déclenchement par applaudissement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrófono solo si lo pides: para grabar voz y disparar con una palmada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfono solo su richiesta: per le registrazioni vocali e lo scatto con il battito di mani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoon alleen op verzoek: voor spraakopnamen en opnemen door te klappen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクは必要なときだけ：声の録音と拍手での撮影に使います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfone só quando você pede: para gravar voz e disparar com palmas."
          }
        }
      }
    },
    "Mit dem Stift auf genau dieses Bild zeichnen.": {
      "localizations": {
