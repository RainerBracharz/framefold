    "Ein Bild lange drücken und „Text & Zeichnen …“ wählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a frame and choose “Text & drawing …”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une image et choisissez « Texte et dessin … »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un fotograma y elige «Texto y dibujo …»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un fotogramma e scegli «Testo e disegno …»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een beeld ingedrukt en kies ‘Tekst en tekenen …’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマを長押しして「テキストと描画…」を選びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um quadro e escolha “Texto e desenho…”."
          }
        }
      }
    },
    "Ein Bild lange drücken: neu aufnehmen, verdoppeln, verschieben, Text & Zeichnen, Geräusch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a frame: reshoot, duplicate, move, text & drawing, sound effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long sur une image : reprendre, dupliquer, déplacer, texte et dessin, bruitage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un fotograma: repetir, duplicar, mover, texto y dibujo, efecto de sonido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un fotogramma: riscatta, duplica, sposta, testo e disegno, effetto sonoro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een beeld ingedrukt: opnieuw opnemen, dupliceren, verplaatsen, tekst & tekenen, geluidseffect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマを長押し：撮り直し、複製、移動、テキストと描画、効果音。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um quadro: tirar de novo, duplicar, mover, texto e desenho, efeito sonoro."
          }
        }
      }
    },
    "Ein kleines Stück bewegen, Hände aus dem Bild – FrameFold löst von selbst aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move things a little, hands out of the frame – FrameFold shoots by itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bougez un peu, mains hors du cadre – FrameFold déclenche tout seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve un poco, manos fuera del encuadre: FrameFold dispara solo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta un poco, mani fuori dall’inquadratura – FrameFold scatta da solo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klein stukje bewegen, handen uit beeld – FrameFold neemt vanzelf op."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しだけ動かして、手を画面の外へ – FrameFold が自動で撮影します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova as coisas um pouquinho, tire as mãos do quadro – o FrameFold dispara sozinho."
          }
        }
      }
    },
