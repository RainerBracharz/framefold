    "Kamera über den Tisch, arbeiten. Es löst von selbst aus, sobald deine Hände aus dem Bild sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera above the table, then work. It fires by itself as soon as your hands leave the frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra au-dessus de la table, et au travail. Elle déclenche toute seule dès que tes mains quittent le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara sobre la mesa y a trabajar. Dispara sola en cuanto tus manos salen del encuadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera sopra il tavolo, e al lavoro. Scatta da sola appena le tue mani escono dall’inquadratura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera boven de tafel, aan het werk. Hij drukt vanzelf af zodra je handen uit beeld zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラをテーブルの上に置いて作業開始。手が画面から出ると自動で撮影します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera acima da mesa, depois é só trabalhar. Ela dispara sozinha assim que suas mãos saem do quadro."
          }
        }
      }
    },
    "Kamera über den Tisch. FrameFold löst aus, sobald deine Hände aus dem Bild sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera above the table. FrameFold fires as soon as your hands leave the frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra au-dessus de la table. FrameFold déclenche dès que tes mains quittent le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara sobre la mesa. FrameFold dispara en cuanto tus manos salen del encuadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera sopra il tavolo. FrameFold scatta appena le tue mani escono dall’inquadratura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera boven de tafel. FrameFold drukt af zodra je handen uit beeld zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラをテーブルの上に。手が画面から出ると FrameFold が撮影します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera acima da mesa. O FrameFold dispara assim que suas mãos saem do quadro."
          }
        }
      }
    },
    "Kein Kamerazugriff": {
      "localizations": {
