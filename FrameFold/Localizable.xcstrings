    "Zeitleiste, Abspielen, Zwiebelhaut über mehrere Bilder, Masken, Lupe, Ton und X-Sheet – wie am iPad und Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, playback, multi-frame onion skin, masks, loupe, sound and X-sheet – as on iPad and Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, lecture, pelure d’oignon sur plusieurs images, masques, loupe, son et feuille d’exposition – comme sur iPad et Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea de tiempo, reproducción, papel cebolla de varios fotogramas, máscaras, lupa, sonido y hoja de exposición, como en iPad y Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, riproduzione, onion skin su più fotogrammi, maschere, lente, suono e X-sheet, come su iPad e Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdlijn, afspelen, onion skin over meerdere beelden, maskers, loep, geluid en X-sheet – zoals op iPad en Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムライン、再生、複数コマのオニオンスキン、マスク、ルーペ、サウンド、X-Sheet – iPad や Mac と同じように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha do tempo, reprodução, papel cebola de vários quadros, máscaras, lupa, som e X-Sheet – como no iPad e no Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časová osa, přehrávání, cibulová slupka přes více snímků, masky, lupa, zvuk a X-Sheet – jako na iPadu a Macu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oś czasu, odtwarzanie, skórka cebuli z wielu klatek, maski, lupa, dźwięk i X-Sheet – jak na iPadzie i Macu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймлайн, відтворення, калька з кількох кадрів, маски, лупа, звук і X-Sheet — як на iPad і Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймлайн, воспроизведение, калька на несколько кадров, маски, лупа, звук и X-Sheet — как на iPad и Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman çizelgesi, oynatma, çok kareli soğan kabuğu, maskeler, büyüteç, ses ve X-Sheet — iPad ve Mac'teki gibi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인, 재생, 여러 프레임 어니언 스킨, 마스크, 확대경, 사운드, X-시트 — iPad와 Mac처럼."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间线、播放、多帧洋葱皮、遮罩、放大镜、声音和 X-Sheet——与 iPad 和 Mac 上一样。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidslinje, afspilning, løgskind over flere billeder, masker, lup, lyd og X-Sheet — som på iPad og Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidslinje, uppspelning, lökskal över flera bilder, masker, lupp, ljud och X-Sheet — som på iPad och Mac."
          }
        }
      }
    },
