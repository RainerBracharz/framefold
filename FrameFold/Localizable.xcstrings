    "Der Film läuft ab Bild %lld mit. Vorhandener Ton spielt während der Aufnahme nicht, damit er nicht mit aufgenommen wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The film plays along from frame %lld. Existing sound is not played during recording, so headphones aren’t needed to keep it out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le film défile à partir de l’image %lld. Le son existant n’est pas joué pendant l’enregistrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La película se reproduce desde el fotograma %lld. El sonido existente no suena durante la grabación, para que no se grabe también."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il film scorre dal fotogramma %lld. Il suono esistente non viene riprodotto durante la registrazione, così non finisce nella ripresa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De film speelt mee vanaf beeld %lld. Bestaand geluid speelt tijdens de opname niet, zodat het niet mee wordt opgenomen."
          }
        }
      }
    },
