    "Labor-Ansicht: Blattnummer, Sitzungsuhr, Messwerte – und der Falz-Countdown wandert in Amber um den Auslöser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab view: sheet number, session clock, readings — and the crease countdown runs in amber around the shutter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue labo : numéro de feuille, chrono de séance, mesures — et le compte à rebours du pli tourne en ambre autour du déclencheur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de laboratorio: número de hoja, reloj de sesión, mediciones, y la cuenta atrás del pliegue gira en ámbar alrededor del obturador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista laboratorio: numero del foglio, orologio della sessione, misurazioni, e il conto alla rovescia della piega gira in ambra attorno al pulsante di scatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labweergave: velnummer, sessieklok, meetwaarden – en het vouw-aftellen loopt in amber rond de ontspanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラボ表示：シート番号、セッション時間、測定値 — 折り目のカウントダウンがシャッターのまわりを琥珀色で回ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão de laboratório: número da folha, relógio da sessão, medições — e a contagem regressiva do vinco gira em âmbar ao redor do obturador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratorní pohled: číslo archu, hodiny relace, naměřené hodnoty – a odpočet přehybu obíhá jantarově kolem spouště."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widok laboratoryjny: numer arkusza, zegar sesji, pomiary – a odliczanie zagięcia biegnie bursztynowo wokół spustu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лабораторний вигляд: номер аркуша, годинник сесії, виміри — а відлік згину біжить бурштином довкола затвора."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вид лаборатории: номер листа, часы сеанса, показания — а янтарный отсчёт сгиба бежит вокруг затвора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratuvar görünümü: sayfa numarası, oturum saati, ölçümler — ve kıvrım geri sayımı kehribar renginde deklanşörün çevresinde döner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랩 보기: 시트 번호, 세션 시계, 측정값 — 그리고 호박색 접힘 카운트다운이 셔터 주위를 돌아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验室视图：页码、拍摄计时、测量值——折痕倒计时以琥珀色环绕快门。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratorievisning: arknummer, sessionsur, måleværdier — og fold-nedtællingen løber i ravgult rundt om udløseren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Labbvy: arknummer, sessionsklocka, mätvärden — och veck-nedräkningen löper i bärnsten runt avtryckaren."
          }
        }
      }
    },
    "Labor-Ansicht: Blattnummer, Sitzungsuhr, fixierte Belichtung, Messwerte – und der Falz-Countdown wandert in Amber um den Auslöser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab view: sheet number, session clock, locked exposure, readings — and the crease countdown runs in amber around the shutter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue labo : numéro de feuille, chrono de séance, exposition verrouillée, mesures — et le compte à rebours du pli tourne en ambre autour du déclencheur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de laboratorio: número de hoja, reloj de sesión, exposición bloqueada, mediciones, y la cuenta atrás del pliegue gira en ámbar alrededor del obturador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista laboratorio: numero del foglio, orologio della sessione, esposizione bloccata, misurazioni, e il conto alla rovescia della piega gira in ambra attorno al pulsante di scatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labweergave: velnummer, sessieklok, vastgezette belichting, meetwaarden – en het vouw-aftellen loopt in amber rond de ontspanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラボ表示：シート番号、セッション時間、固定した露出、測定値 — 折り目のカウントダウンがシャッターのまわりを琥珀色で回ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão de laboratório: número da folha, relógio da sessão, exposição travada, medições — e a contagem regressiva do vinco gira em âmbar ao redor do obturador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratorní pohled: číslo archu, hodiny relace, zamčená expozice, naměřené hodnoty – a odpočet přehybu obíhá jantarově kolem spouště."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widok laboratoryjny: numer arkusza, zegar sesji, zablokowana ekspozycja, pomiary – a odliczanie zagięcia biegnie bursztynowo wokół spustu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лабораторний вигляд: номер аркуша, годинник сесії, зафіксована експозиція, виміри — а відлік згину біжить бурштином довкола затвора."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вид лаборатории: номер листа, часы сеанса, зафиксированная экспозиция, показания — а янтарный отсчёт сгиба бежит вокруг затвора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratuvar görünümü: sayfa numarası, oturum saati, kilitli pozlama, ölçümler — ve kıvrım geri sayımı kehribar renginde deklanşörün çevresinde döner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랩 보기: 시트 번호, 세션 시계, 고정된 노출, 측정값 — 그리고 호박색 접힘 카운트다운이 셔터 주위를 돌아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验室视图：页码、拍摄计时、锁定的曝光、测量值——折痕倒计时以琥珀色环绕快门。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratorievisning: arknummer, sessionsur, låst eksponering, måleværdier — og fold-nedtællingen løber i ravgult rundt om udløseren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Labbvy: arknummer, sessionsklocka, låst exponering, mätvärden — och veck-nedräkningen löper i bärnsten runt avtryckaren."
          }
        }
      }
    },
