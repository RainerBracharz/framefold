    "%@ mit allen %lld Bildern löschen?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ mit allen %2$lld Bildern löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %1$@ and all %2$lld frames?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %1$@ et ses %2$lld images ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar %1$@ y sus %2$lld fotogramas?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %1$@ e tutti i suoi %2$lld fotogrammi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ met alle %2$lld beelden verwijderen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ と %2$lld コマをすべて削除しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar %1$@ e todos os %2$lld quadros?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat %1$@ se všemi snímky (%2$lld)?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %1$@ ze wszystkimi klatkami (%2$lld)?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити «%1$@» з усіма кадрами (%2$lld)?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@» и все кадры (%2$lld)?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve %2$lld karenin tümü silinsin mi?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 및 프레임 %2$lld개를 모두 삭제할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %1$@ 及全部 %2$lld 帧？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet %1$@ og alle %2$lld billeder?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera %1$@ och alla %2$lld bilder?"
          }
        }
      }
    },
