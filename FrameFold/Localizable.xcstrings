    "Schwenk und Zoom über einen Bildbereich – im Export, wie eine Kamerabewegung über das Set.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan and zoom across a range of frames – in the export, like a camera moving over the set."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoramique et zoom sur une plage d’images – à l’export, comme une caméra qui se déplace sur le plateau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Panorámica y zoom sobre un rango de fotogramas: en la exportación, como una cámara que se mueve por el set."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoramica e zoom su un intervallo di fotogrammi – nell’esportazione, come una camera che si muove sul set."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pannen en zoomen over een reeks beelden – bij het exporteren, als een camera die over de set beweegt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したコマの範囲でパンとズーム。書き出し時に、セットの上をカメラが動くように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Panorâmica e zoom sobre um intervalo de quadros – na exportação, como uma câmera passando pelo set."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Švenk a zoom přes rozsah snímků – v exportu, jako pohyb kamery nad scénou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panorama i zoom w zakresie klatek – w eksporcie, jak ruch kamery nad planem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панорама й зум на проміжку кадрів — в експорті, як рух камери над знімальним майданчиком."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панорама и зум на отрезке кадров — при экспорте, как движение камеры над площадкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kare aralığında kaydırma ve yakınlaştırma — dışa aktarımda, setin üzerinde hareket eden bir kamera gibi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 구간에 걸친 팬과 줌 — 내보낼 때 세트 위를 움직이는 카메라처럼."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一段帧范围内平移和缩放——导出时就像相机在布景上移动。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Panorering og zoom hen over en række billeder — i eksporten, som et kamera, der bevæger sig hen over settet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Panorering och zoom över ett antal bilder — i exporten, som en kamera som rör sig över inspelningsplatsen."
          }
        }
      }
    },
