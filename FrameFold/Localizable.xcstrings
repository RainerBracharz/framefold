    },
    "Fünf Musikstücke von „Fröhlich“ bis „Verfolgung“ und Stimmeffekte (hoch, tief, Roboter) – im Studio unter „Ton“, jede Spur lässt sich kürzen und blenden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five music pieces from “Happy” to “Chase” and voice effects (high, deep, robot) – in the studio under “Sound”; every track can be trimmed and faded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq morceaux de musique, de « Joyeux » à « Poursuite », et des effets de voix (aiguë, grave, robot) – dans le studio sous « Son » ; chaque piste peut être coupée et fondue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco piezas musicales, de «Alegre» a «Persecución», y efectos de voz (aguda, grave, robot): en el estudio, en «Sonido»; cada pista se puede recortar y desvanecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque brani musicali, da «Allegro» a «Inseguimento», ed effetti voce (acuta, profonda, robot) – nello studio sotto «Suono»; ogni traccia si può tagliare e dissolvere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf muziekstukken van ‘Vrolijk’ tot ‘Achtervolging’ en stemeffecten (hoog, laag, robot) – in de studio onder ‘Geluid’; elk spoor kun je inkorten en laten faden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「楽しい」から「追いかけっこ」までの 5 曲と、ボイスエフェクト（高い声・低い声・ロボット）。スタジオの「サウンド」から。各トラックはカットとフェードができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco músicas, de “Alegre” a “Perseguição”, e efeitos de voz (aguda, grave, robô) – no estúdio, em “Som”; cada faixa pode ser cortada e ter fade."
          }
        }
      }
    }
  },
  "version": "1.3"
}
