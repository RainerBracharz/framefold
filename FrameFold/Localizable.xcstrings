    "Das Stopmotion-Video konnte nicht geschrieben werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stop-motion video couldn't be written."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’écrire la vidéo stop motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir el vídeo stop motion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scrivere il video stop motion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stop-motionvideo kon niet worden geschreven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマ撮り動画を書き出せませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar o vídeo em stop motion."
          }
        }
