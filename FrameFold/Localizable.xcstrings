    "Für diese Sprache gibt es keine Spracherkennung auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no on-device speech recognition for this language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune reconnaissance vocale sur l’appareil pour cette langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay reconocimiento de voz en el dispositivo para este idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questa lingua non c’è riconoscimento vocale sul dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze taal is er geen spraakherkenning op het apparaat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語にはデバイス上の音声認識がありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há reconhecimento de fala no dispositivo para este idioma."
          }
        }
      }
    },
    "In der Spur wurden keine Wörter erkannt.": {
