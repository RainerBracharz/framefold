            "state": "translated",
            "value": "動かないで…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se mexa…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehýbat…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ruszaj się…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не рухайся…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не двигайтесь…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıpırdamayın…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직이지 마세요…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要动…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevæg dig ikke…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rör dig inte…"
          }
        }
      }
    },
    "Nimmt sofort ein Bild auf. Sonst löst die Kamera von selbst aus, sobald die Hände aus dem Bild sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes a frame right away. Otherwise the camera fires by itself once your hands are clear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend une image tout de suite. Sinon, la caméra déclenche toute seule dès que tes mains quittent le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un fotograma al instante. Si no, la cámara dispara sola en cuanto las manos salen del encuadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta subito un fotogramma. Altrimenti la fotocamera scatta da sola appena le mani escono dall’inquadratura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt meteen een beeld op. Anders drukt de camera vanzelf af zodra je handen uit beeld zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにコマを撮影します。それ以外は、手がどくとカメラが自動で撮影します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira um quadro na hora. Caso contrário, a câmera dispara sozinha quando suas mãos saem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořídí snímek hned. Jinak kamera snímá sama, jakmile jsou ruce mimo záběr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Robi zdjęcie od razu. W przeciwnym razie aparat robi zdjęcie sam, gdy ręce znikną z kadru."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімає кадр одразу. Інакше камера знімає сама, щойно руки зникнуть із кадру."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу делает кадр. Иначе камера снимает сама, как только руки уходят из кадра."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen bir kare çeker. Aksi hâlde kamera, eller kadrajdan çıkınca kendiliğinden çeker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 프레임을 찍어요. 그렇지 않으면 손이 화면에서 벗어날 때 카메라가 저절로 촬영해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即拍摄一帧。否则手一离开画面，相机就会自动拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tager et billede med det samme. Ellers tager kameraet selv billedet, så snart hænderne er ude af billedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar en bild direkt. Annars tar kameran bilden själv så fort händerna är ur bild."
          }
        }
      }
    },
    "Noch kein Werk – leg eines an, dann kann die Kamera loslegen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No work yet — start one and the camera can go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d’œuvre — crée-en une et la caméra peut démarrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna obra: crea una y la cámara podrá empezar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna opera: creane una e la fotocamera può partire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen werk – maak er een aan, dan kan de camera beginnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ作品がありません — 作品を始めればカメラが使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há obra — comece uma e a câmera pode começar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné dílo – založ si nějaké a kamera může začít."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze żadnej pracy – utwórz ją, a aparat może zaczynać."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає жодної роботи — створи її, і камера зможе почати."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работ пока нет — создайте одну, и камера сможет начать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eser yok — bir tane oluşturun, kamera başlasın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 작품이 없어요 — 하나 만들면 카메라를 시작할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有作品——新建一件，相机就能开始工作。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet værk endnu — opret et, så kan kameraet gå i gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget verk än — skapa ett, så kan kameran sätta igång."
          }
        }
      }
    },
    "Noch nicht scharf…": {
      "localizations": {
