          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі команди з клавіатури: меню «Студія»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все команды с клавиатуры: меню «Студия»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm komutlar klavyeyle: “Stüdyo” menüsü."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 명령을 키보드로: '스튜디오' 메뉴."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有命令均可用键盘操作：见“Studio”菜单。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
