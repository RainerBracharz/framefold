    "Schwarzweiß mit warmem Papierton — wie ein abfotografierter Druck.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black and white on a warm paper tone — like a print photographed again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noir et blanc sur un ton papier chaud — comme un tirage rephotographié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanco y negro sobre un tono de papel cálido, como una impresión vuelta a fotografiar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bianco e nero su un tono carta caldo, come una stampa fotografata di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwart-wit met een warme papiertoon — als een opnieuw gefotografeerde afdruk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かみのある紙の色に白黒 — プリントをもう一度撮影したように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preto e branco num tom de papel quente — como uma cópia fotografada de novo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Černobílá na teplém tónu papíru — jako znovu vyfocený tisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czerń i biel na ciepłym tonie papieru — jak sfotografowana odbitka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чорно-білий на теплому тоні паперу — як перезнятий відбиток."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чёрно-белый на тёплом тоне бумаги — как переснятый отпечаток."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcak kâğıt tonunda siyah-beyaz — yeniden fotoğraflanmış bir baskı gibi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 종이 색 위의 흑백 — 인쇄물을 다시 찍은 것처럼."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑白搭配温暖的纸张色调——如同翻拍的印刷品。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort-hvid på en varm papirtone — som et affotograferet tryk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svartvitt på en varm papperston — som ett affotograferat tryck."
          }
        }
      }
    },
    "Schärfe bricht immer wieder weg. Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharpness keeps dropping. Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La netteté se perd sans cesse. Touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nitidez se pierde una y otra vez. Toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nitidezza continua a calare. Tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scherpte valt steeds weg. Tik in de zoeker op je werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピントが落ち続けています。ファインダーで作品をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nitidez continua caindo. Toque na sua obra no visor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrost pořád ujíždí. Klepni v hledáčku na své dílo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrość ciągle ucieka. Stuknij w wizjerze swoją pracę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різкість постійно зникає. Торкнися у видошукачі своєї роботи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резкость всё время теряется. Коснитесь работы в видоискателе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netlik sürekli kayboluyor. Vizörde eserinize dokunun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점이 자꾸 흐려져요. 뷰파인더에서 작품을 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晰度反复丢失。请在取景器中轻点你的作品。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skarpheden forsvinder igen og igen. Tryk på dit værk i søgeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärpan försvinner hela tiden. Tryck på ditt verk i sökaren."
          }
        }
      }
    },
