    "Das vorherige Bild schimmert im nächsten leicht nach.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous frame lingers faintly in the next."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image précédente persiste légèrement dans la suivante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fotograma anterior se intuye levemente en el siguiente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fotogramma precedente traspare appena nel successivo."
          }
        },
        "nl": {
