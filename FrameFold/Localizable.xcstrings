    "Fokus findet nichts Scharfes. Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus can't find anything sharp. Tap your work in the viewfinder."
