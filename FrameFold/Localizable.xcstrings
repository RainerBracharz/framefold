    "Am Stativ wird der Fokus fixiert, aus der Hand läuft er mit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a tripod focus stays locked; handheld it keeps tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur trépied, la mise au point reste verrouillée ; à main levée, elle suit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el trípode el enfoque queda fijo; a mano sigue al motivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul treppiede il fuoco resta fisso; a mano libera segue il soggetto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een statief blijft de focus vast; uit de hand volgt hij mee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三脚ではピントを固定し、手持ちでは追従し続けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No tripé, o foco fica travado; na mão, ele continua acompanhando."
          }
        }
      }
    },
