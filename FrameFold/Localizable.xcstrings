    "Kamera nicht berühren: fest über dem Tisch montieren und den Auto-Shutter arbeiten lassen (oder den runden Knopf).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't touch the camera: mount it firmly above the table and let the auto-shutter work (or use the round button)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne touche pas la caméra : fixe-la bien au-dessus de la table et laisse faire le déclenchement auto (ou le bouton rond)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No toques la cámara: móntala firme sobre la mesa y deja trabajar al disparo automático (o usa el botón redondo)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non toccare la fotocamera: fissala bene sopra il tavolo e lascia lavorare lo scatto automatico (o usa il pulsante rotondo)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak de camera niet aan: monteer hem stevig boven de tafel en laat de auto-ontspanner werken (of gebruik de ronde knop)."
          }
        }
      }
    },
