    "Geräusche wie Plopp, Wusch oder Tadaa lassen sich an jedes Bild hängen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound effects like pop, whoosh or ta-da can be attached to any frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des bruitages comme plop, whoosh ou tadaa peuvent être placés sur n’importe quelle image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectos como pop, zas o tachán se pueden colocar en cualquier fotograma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effetti come pop, whoosh o tadà si possono agganciare a qualsiasi fotogramma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluidseffecten zoals plop, woesj of tadaa kun je aan elk beeld hangen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポン、シュッ、ジャジャーンなどの効果音を、どのコマにもつけられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeitos sonoros como pop, vush ou tchan-tchan-tchan podem ser colocados em qualquer quadro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukové efekty jako Plop, Šup nebo Tadá lze připojit ke každému snímku."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Efekty dźwiękowe, takie jak Plum, Wziuum czy Tadam, można dołączyć do każdej klatki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звукові ефекти на кшталт «Буль», «Вжух» чи «Та-дам» можна прикріпити до будь-якого кадру."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуковые эффекты вроде «Хлоп», «Вжух» или «Та-дам» можно прикрепить к любому кадру."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pıt, Vuuş ya da Tadaa gibi ses efektleri her kareye eklenebilir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퐁, 휙, 짜잔 같은 효과음을 어느 프레임에나 붙일 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“啵”、“嗖”或“噔噔”等音效可以附加到任意一帧。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydeffekter som plop, whoosh eller tada kan sættes på ethvert billede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudeffekter som plopp, svisch eller tadaa kan läggas på vilken bild som helst."
          }
        }
      }
    },
    "Gleichmäßiges Raumlicht statt Fenster: Wolken lassen den Film flackern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady room light instead of a window: clouds make the film flicker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière intérieure régulière plutôt qu’une fenêtre : les nuages font scintiller le film."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz interior constante en lugar de ventana: las nubes hacen parpadear la película."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce ambiente uniforme invece della finestra: le nuvole fanno sfarfallare il film."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelijkmatig kamerlicht in plaats van een raam: wolken laten de film flikkeren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓の光ではなく均一な室内照明を：雲で映像がちらつきます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz ambiente uniforme em vez de janela: as nuvens fazem o filme piscar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnoměrné světlo v místnosti místo okna: kvůli mrakům film bliká."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Równe światło w pokoju zamiast okna: chmury sprawiają, że film migocze."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівне світло в кімнаті замість вікна: через хмари фільм мерехтить."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровный комнатный свет вместо окна: из-за облаков фильм мерцает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere yerine eşit oda ışığı: bulutlar filmi titretir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창문 대신 고른 실내조명을: 구름 때문에 영상이 깜빡여요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用均匀的室内光而不是窗户光：云层会让影片闪烁。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jævnt rumlys i stedet for vindue: skyer får filmen til at flimre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämnt rumsljus i stället för fönster: moln får filmen att flimra."
          }
        }
      }
    },
    "Greenscreen ersetzt Grün oder Blau durch ein Bild oder einen Film.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green screen replaces green or blue with an image or a video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond vert remplace le vert ou le bleu par une image ou une vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla verde sustituye el verde o el azul por una imagen o un vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il green screen sostituisce il verde o il blu con un’immagine o un video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenscreen vervangt groen of blauw door een afbeelding of een video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリーンバックは、緑または青を画像や動画に置き換えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela verde substitui verde ou azul por uma imagem ou um vídeo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelené plátno nahradí zelenou nebo modrou obrázkem nebo filmem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Green screen zastępuje zieleń lub błękit obrazem albo filmem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелений екран замінює зелений або синій колір зображенням чи фільмом."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелёный экран заменяет зелёный или синий цвет изображением или видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeşil perde, yeşili ya da maviyi bir görüntü veya videoyla değiştirir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그린 스크린은 초록색이나 파란색을 이미지나 동영상으로 바꿔요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿幕会把绿色或蓝色替换为一张图像或一段影片。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenscreen erstatter grøn eller blå med et billede eller en film."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenscreen ersätter grönt eller blått med en bild eller en film."
          }
        }
      }
    },
