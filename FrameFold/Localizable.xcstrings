    "Im Bild klicken oder ziehen: Lupe setzen und dort scharfstellen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click or drag in the image: place the loupe and focus there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique ou glisse dans l’image : place la loupe et fait la mise au point à cet endroit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic o arrastra en la imagen: coloca la lupa y enfoca ahí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic o trascina nell’immagine: posiziona la lente e metti a fuoco lì."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik of sleep in het beeld: zet de loep neer en stel daar scherp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像内をクリックまたはドラッグ：ルーペを置き、そこにピントを合わせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique ou arraste na imagem: posicione a lupa e foque ali."
          }
        }
      }
    },
