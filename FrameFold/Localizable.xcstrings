    "Zeitleiste, Abspielen, Zwiebelhaut über mehrere Bilder, Masken, Lupe, Ton und X-Sheet – wie am iPad und Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, playback, multi-frame onion skin, masks, loupe, sound and X-sheet – as on iPad and Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, lecture, pelure d’oignon sur plusieurs images, masques, loupe, son et feuille d’exposition – comme sur iPad et Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea de tiempo, reproducción, papel cebolla de varios fotogramas, máscaras, lupa, sonido y hoja de exposición, como en iPad y Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, riproduzione, onion skin su più fotogrammi, maschere, lente, suono e X-sheet, come su iPad e Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdlijn, afspelen, onion skin over meerdere beelden, maskers, loep, geluid en X-sheet – zoals op iPad en Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムライン、再生、複数コマのオニオンスキン、マスク、ルーペ、サウンド、X-Sheet – iPad や Mac と同じように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha do tempo, reprodução, papel cebola de vários quadros, máscaras, lupa, som e X-Sheet – como no iPad e no Mac."
          }
        }
      }
    },
