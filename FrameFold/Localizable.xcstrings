    "iPhone nicht berühren: aufs Stativ stellen und den Auto-Shutter arbeiten lassen (oder den runden Knopf).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't touch the phone: put it on a tripod and let the auto-shutter work (or use the round button)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne touche pas l’iPhone : pose-le sur un trépied et laisse faire le déclenchement auto (ou le bouton rond)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No toques el iPhone: ponlo en el trípode y deja trabajar al disparo automático (o usa el botón redondo)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non toccare l’iPhone: mettilo sul treppiede e lascia lavorare lo scatto automatico (o usa il pulsante rotondo)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak de iPhone niet aan: zet hem op een statief en laat de auto-ontspanner werken (of gebruik de ronde knop)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンには触れないでください：三脚に置いて、オートシャッターにまかせましょう（または丸いボタンを使います）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não toque no telefone: coloque-o num tripé e deixe o obturador automático trabalhar (ou use o botão redondo)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedotýkej se iPhonu: postav ho na stativ a nech pracovat automatickou spoušť (nebo kulaté tlačítko)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dotykaj iPhone’a: postaw go na statywie i pozwól działać automatycznemu spustowi (albo okrągłemu przyciskowi)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не торкайся iPhone: постав його на штатив і дай попрацювати автозатвору (або круглій кнопці)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не трогайте iPhone: поставьте его на штатив и доверьтесь автозатвору (или круглой кнопке)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'a dokunmayın: tripoda koyun ve otomatik deklanşörün çalışmasına izin verin (ya da yuvarlak düğmeyi kullanın)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 만지지 마세요: 삼각대에 놓고 자동 셔터에 맡기세요(또는 둥근 버튼)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要触碰 iPhone：把它架上三脚架，让自动快门工作（或使用圆形按钮）。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rør ikke iPhonen: stil den på et stativ, og lad auto-udløseren arbejde (eller brug den runde knap)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rör inte iPhonen: ställ den på ett stativ och låt den automatiska avtryckaren jobba (eller använd den runda knappen)."
          }
        }
      }
    },
