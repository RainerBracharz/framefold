    "Geräusche wie Plopp, Wusch oder Tadaa lassen sich an jedes Bild hängen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound effects like pop, whoosh or ta-da can be attached to any frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des bruitages comme plop, whoosh ou tadaa peuvent être placés sur n’importe quelle image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectos como pop, zas o tachán se pueden colocar en cualquier fotograma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effetti come pop, whoosh o tadà si possono agganciare a qualsiasi fotogramma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluidseffecten zoals plop, woesj of tadaa kun je aan elk beeld hangen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポン、シュッ、ジャジャーンなどの効果音を、どのコマにもつけられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeitos sonoros como pop, vush ou tchan-tchan-tchan podem ser colocados em qualquer quadro."
          }
        }
      }
    },
    "Gleichmäßiges Raumlicht statt Fenster: Wolken lassen den Film flackern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady room light instead of a window: clouds make the film flicker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière intérieure régulière plutôt qu’une fenêtre : les nuages font scintiller le film."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz interior constante en lugar de ventana: las nubes hacen parpadear la película."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce ambiente uniforme invece della finestra: le nuvole fanno sfarfallare il film."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelijkmatig kamerlicht in plaats van een raam: wolken laten de film flikkeren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓の光ではなく均一な室内照明を：雲で映像がちらつきます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz ambiente uniforme em vez de janela: as nuvens fazem o filme piscar."
          }
        }
      }
    },
    "Greenscreen ersetzt Grün oder Blau durch ein Bild oder einen Film.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green screen replaces green or blue with an image or a video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond vert remplace le vert ou le bleu par une image ou une vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla verde sustituye el verde o el azul por una imagen o un vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il green screen sostituisce il verde o il blu con un’immagine o un video."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenscreen vervangt groen of blauw door een afbeelding of een video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリーンバックは、緑または青を画像や動画に置き換えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela verde substitui verde ou azul por uma imagem ou um vídeo."
          }
        }
      }
    },
    "Hilfe": {
