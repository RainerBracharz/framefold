    "Format, Bildrate, Effekte, Faltvorlagen, Ausstellung — die volle Werkstatt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspect, frame rate, effects, fold templates, exhibition — the full workshop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format, cadence, effets, gabarits de pliage, exposition — tout l’atelier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato, velocidad, efectos, plantillas de plegado, exposición: el taller completo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato, frame rate, effetti, modelli di piegatura, mostra: l’atelier completo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaat, beeldsnelheid, effecten, vouwsjablonen, tentoonstelling — het complete atelier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスペクト比、フレームレート、エフェクト、折りテンプレート、展示 — すべてそろった工房。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato, taxa de quadros, efeitos, moldes de dobra, exposição — a oficina completa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Formát, snímková frekvence, efekty, šablony skládání, výstava — celá dílna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Format, liczba klatek, efekty, szablony składania, wystawa — cały warsztat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат, частота кадрів, ефекти, шаблони складання, виставка — уся майстерня."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат, частота кадров, эффекты, шаблоны складывания, выставка — вся мастерская."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En-boy oranı, kare hızı, efektler, katlama şablonları, sergi — atölyenin tamamı."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면비, 프레임 레이트, 효과, 접기 템플릿, 전시 — 작업실 전부."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画幅、帧率、效果、折叠模板、展览——完整的工作坊。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Format, billedhastighed, effekter, foldeskabeloner, udstilling — hele værkstedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Format, bildfrekvens, effekter, vikmallar, utställning — hela verkstaden."
          }
        }
      }
    },
