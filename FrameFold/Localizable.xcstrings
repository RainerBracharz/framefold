    "Format, Bildrate, Effekte, Faltvorlagen, Ausstellung — die volle Werkstatt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspect, frame rate, effects, fold templates, exhibition — the full workshop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format, cadence, effets, gabarits de pliage, exposition — tout l’atelier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato, velocidad, efectos, plantillas de plegado, exposición: el taller completo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato, frame rate, effetti, modelli di piegatura, mostra: l’atelier completo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaat, beeldsnelheid, effecten, vouwsjablonen, tentoonstelling — het complete atelier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスペクト比、フレームレート、エフェクト、折りテンプレート、展示 — すべてそろった工房。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato, taxa de quadros, efeitos, moldes de dobra, exposição — a oficina completa."
          }
        }
      }
    },
