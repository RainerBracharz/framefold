    "Ein Film läuft Bild für Bild mit: Bild n zeigt die Stelle n ÷ Bildrate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A movie follows frame by frame: frame n shows the point n ÷ frame rate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un film suit image par image : l’image n montre l’instant n ÷ cadence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una película avanza fotograma a fotograma: el fotograma n muestra el punto n ÷ velocidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filmato scorre fotogramma per fotogramma: il fotogramma n mostra il punto n ÷ frame rate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een film loopt beeld voor beeld mee: beeld n toont het punt n ÷ beeldsnelheid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画はコマごとに進みます：n コマ目には n ÷ フレームレートの時点が表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um filme acompanha quadro a quadro: o quadro n mostra o ponto n ÷ taxa de quadros."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Film běží snímek po snímku s sebou: snímek n ukazuje místo n ÷ snímková frekvence."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film podąża klatka po klatce: klatka n pokazuje miejsce n ÷ liczba klatek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільм іде кадр за кадром: кадр n показує момент n ÷ частота кадрів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильм идёт кадр за кадром: кадр n показывает момент n ÷ частота кадров."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir film kare kare eşlik eder: n. kare, n ÷ kare hızı anını gösterir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상이 프레임별로 함께 진행돼요: 프레임 n은 n ÷ 프레임 레이트 지점을 보여 줘요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影片逐帧同步：第 n 帧显示 n ÷ 帧率 处的画面。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En film følger med billede for billede: billede n viser stedet n ÷ billedhastighed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En film följer med bild för bild: bild n visar stället n ÷ bildfrekvens."
          }
        }
      }
