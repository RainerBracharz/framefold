    "Nur wenige Bilder gefunden. Halte beim Filmen öfter kurz still, dann werden es mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a few frames found. Pause more often while filming and there will be more."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu d’images trouvées. Fais plus souvent une courte pause pendant le tournage, il y en aura davantage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se encontraron unos pocos fotogramas. Al grabar, para más a menudo y habrá más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovati solo pochi fotogrammi. Mentre riprendi, fermati più spesso e ce ne saranno di più."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maar weinig beelden gevonden. Houd tijdens het filmen vaker even stil, dan worden het er meer."
          }
        }
      }
    },
