    "Im Bild klicken oder ziehen: Lupe setzen und dort scharfstellen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click or drag in the image: place the loupe and focus there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique ou glisse dans l’image : place la loupe et fait la mise au point à cet endroit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic o arrastra en la imagen: coloca la lupa y enfoca ahí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic o trascina nell’immagine: posiziona la lente e metti a fuoco lì."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik of sleep in het beeld: zet de loep neer en stel daar scherp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像内をクリックまたはドラッグ：ルーペを置き、そこにピントを合わせます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique ou arraste na imagem: posicione a lupa e foque ali."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikni nebo táhni v obraze: umístíš lupu a zaostříš tam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij lub przeciągnij w obrazie: ustaw lupę i ostrość w tym miejscu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацни або потягни в зображенні: постав лупу й сфокусуй там."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите или проведите по изображению: поставить лупу и сфокусироваться там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüye tıklayın ya da sürükleyin: büyüteci yerleştirip oraya odaklanın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 클릭하거나 드래그: 확대경을 놓고 그곳에 초점을 맞춰요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面中点按或拖移：放置放大镜并在该处对焦。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik eller træk i billedet: placer luppen og fokusér der."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka eller dra i bilden: placera luppen och fokusera där."
          }
        }
      }
    },
