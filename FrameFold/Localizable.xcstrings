    "Alles dabei — plus die Spezialfeatures: Facetten, Echo, Faltvorlage, Rekursion, Ausstellung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything, plus the studio effects: facets, echo, fold template, recursion, exhibition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout, plus les effets d’atelier : facettes, écho, gabarit de pliage, récursion, exposition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo, más los efectos de taller: facetas, eco, plantilla de plegado, recursión, exposición."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto, più gli effetti d’atelier: sfaccettature, eco, modello di piegatura, ricorsione, mostra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, plus de atelier-effecten: facetten, echo, vouwsjabloon, recursie, tentoonstelling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能に加えて、Studio のエフェクト：ファセット、エコー、折りテンプレート、再帰、展示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo, mais os efeitos do Studio: facetas, eco, molde de dobra, recursão, exposição."
          }
        }
      }
    },
