    "Scharf gestellt und fixiert. Wirkt es unscharf? Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focused and locked. Looks soft? Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise au point faite et verrouillée. C’est flou ? Touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfocado y bloqueado. ¿Se ve borroso? Toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A fuoco e bloccato. Sembra sfocato? Tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scherpgesteld en vastgezet. Lijkt het onscherp? Tik in de zoeker op je werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピントを合わせて固定しました。ぼやけて見える場合は、ファインダーで作品をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Focado e travado. Parece sem nitidez? Toque na sua obra no visor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaostřeno a zamčeno. Vypadá to neostře? Klepni v hledáčku na své dílo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrość ustawiona i zablokowana. Wygląda nieostro? Stuknij w wizjerze swoją pracę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфокусовано й зафіксовано. Здається нерізким? Торкнися у видошукачі своєї роботи."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфокусировано и зафиксировано. Нерезко? Коснитесь работы в видоискателе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklandı ve kilitlendi. Bulanık mı görünüyor? Vizörde eserinize dokunun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점을 맞추고 고정했어요. 흐려 보이나요? 뷰파인더에서 작품을 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对焦并锁定。看起来模糊？请在取景器中轻点你的作品。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokuseret og låst. Ser det uskarpt ud? Tryk på dit værk i søgeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokuserad och låst. Ser det oskarpt ut? Tryck på ditt verk i sökaren."
          }
        }
      }
    },
    "Schließen": {
      "localizations": {
