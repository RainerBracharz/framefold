    "Aus deiner Arbeit\nwird eine Stopmotion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your work\nbecomes a stop-motion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton travail\ndevient un stop motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu obra\nse convierte en stop motion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo lavoro\ndiventa uno stop motion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je werk\nwordt een stop-motion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの作品が\nコマ撮りに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua obra\nvira um stop motion."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tvé práce\nvznikne stop motion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja praca\nstaje się animacją."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З твоєї роботи\nвийде стоп-моушн."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша работа\nстановится стоп-моушеном."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışmanız\nbir stop motion'a dönüşür."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 작업이\n스톱모션이 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
