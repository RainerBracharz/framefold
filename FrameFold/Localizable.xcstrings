    "Blendet das nächste Bild ein — als Falzkante, als triangulierte Facetten oder als eingewobene Bildstreifen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings in the next frame — as a crease, as triangulated facets, or as woven strips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait apparaître l’image suivante — en pli, en facettes triangulées ou en bandes tissées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funde el siguiente fotograma: como pliegue, como facetas trianguladas o como tiras de imagen entretejidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa entrare il fotogramma successivo: come piega, come sfaccettature triangolate o come strisce intrecciate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het volgende beeld binnenkomen — als vouw, als getrianguleerde facetten of als geweven beeldstroken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のコマを導入します — 折り目として、三角形のファセットとして、または織り込んだ帯として。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz o próximo quadro — como vinco, como facetas trianguladas ou como tiras entrelaçadas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prolne další snímek — jako přehyb, jako triangulované fasety nebo jako vpletené pruhy obrazu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadza następną klatkę — jako zagięcie, jako triangulowane fasety albo jako wplecione pasy obrazu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводить наступний кадр — як згин, як тріангульовані фасети або як вплетені смуги зображення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводит следующий кадр — как линию сгиба, как треугольные грани или как вплетённые полосы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki kareyi getirir — bir kıvrım çizgisi, üçgen yüzeyler ya da örülmüş şeritler olarak."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 프레임을 불러와요 — 접힌 선으로, 삼각형 면으로, 또는 엮인 띠로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引入下一帧——以折痕、三角形多面或编织条带的方式。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Toner det næste billede ind — som en fold, som triangulerede facetter eller som vævede striber."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonar in nästa bild — som ett veck, som triangulerade fasetter eller som invävda remsor."
          }
        }
      }
    },
    "Blendet das vorherige Bild halbtransparent über den Sucher.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lays the previous frame over the viewfinder, half transparent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpose l’image précédente au viseur, en transparence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpone el fotograma anterior en el visor, semitransparente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrappone al mirino il fotogramma precedente, semitrasparente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt het vorige beeld halfdoorzichtig over de zoeker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のコマを半透明でファインダーに重ねます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe o quadro anterior ao visor, semitransparente."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překryje hledáček předchozím snímkem, napůl průhledně."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakłada poprzednią klatkę na wizjer, półprzezroczyście."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Накладає попередній кадр на видошукач напівпрозоро."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накладывает предыдущий кадр полупрозрачно на видоискатель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki kareyi yarı saydam olarak vizörün üzerine koyar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 프레임을 반투명하게 뷰파인더 위에 겹쳐 보여 줘요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将上一帧以半透明方式叠加在取景器上。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lægger det forrige billede halvgennemsigtigt over søgeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger den föregående bilden halvgenomskinligt över sökaren."
          }
        }
      }
    },
