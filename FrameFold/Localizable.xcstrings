    "Das Bild konnte nicht gespeichert werden. Ist der Speicher voll?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image couldn't be saved. Is the storage full?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image n’a pas pu être enregistrée. Le stockage est-il plein ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la imagen. ¿Está lleno el almacenamiento?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’immagine. La memoria è piena?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het beeld kon niet worden bewaard. Is de opslag vol?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を保存できませんでした。ストレージがいっぱいではありませんか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a imagem. O armazenamento está cheio?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímek se nepodařilo uložit. Není plné úložiště?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać obrazu. Czy pamięć jest pełna?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти зображення. Можливо, сховище заповнене?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить кадр. Память заполнена?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü kaydedilemedi. Depolama alanı dolu mu?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 저장할 수 없어요. 저장 공간이 가득 찼나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存图像。存储空间已满吗？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet kunne ikke gemmes. Er lageret fuldt?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden kunde inte sparas. Är lagringsutrymmet fullt?"
          }
        }
      }
    },
