    "FrameFold": {
      "shouldTranslate": false
    },
    "FrameFold findet die ruhigen Momente und verwirft Bilder, auf denen deine Hände zu sehen sind. Alles bleibt auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold finds the calm moments and drops any frame with your hands in it. Everything stays on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold repère les moments calmes et écarte chaque image où l’on voit tes mains. Tout reste sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold encuentra los momentos de calma y descarta los fotogramas en los que se ven tus manos. Todo se queda en el dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold trova i momenti di calma e scarta i fotogrammi in cui si vedono le tue mani. Tutto resta sul dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold vindt de rustige momenten en laat beelden weg waarop je handen te zien zijn. Alles blijft op het apparaat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold が静止した瞬間を見つけ、手が写ったコマを除外します。データはすべてデバイス内にとどまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FrameFold encontra os momentos parados e descarta qualquer quadro com suas mãos. Tudo fica no dispositivo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold najde klidné okamžiky a zahodí snímky, na kterých jsou vidět tvoje ruce. Vše zůstává v zařízení."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold znajduje spokojne chwile i odrzuca klatki, na których widać twoje ręce. Wszystko zostaje na urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold знаходить спокійні моменти й відкидає кадри, на яких видно твої руки. Усе залишається на пристрої."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold находит спокойные моменты и отбрасывает кадры, на которых видны руки. Всё остаётся на устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold durgun anları bulur ve ellerinizin göründüğü kareleri atar. Her şey cihazda kalır."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold가 멈춘 순간을 찾아내고 손이 보이는 프레임은 버려요. 모든 것은 기기에 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold 会找出静止的瞬间，并丢弃有手入镜的帧。所有内容都留在设备上。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold finder de rolige øjeblikke og kasserer billeder, hvor dine hænder er med. Alt bliver på enheden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold hittar de lugna ögonblicken och slänger bilder där dina händer syns. Allt stannar på enheten."
          }
        }
      }
    },
