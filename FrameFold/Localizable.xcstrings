          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento de cámara (desde «Avanzado»): paneo y zoom sobre una zona de la imagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimento di camera (da «Avanzata»): panoramica e zoom su un’area dell’immagine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camerabeweging (vanaf ‘Uitgebreid’): pannen en zoomen over een deel van het beeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラワーク（「詳細」以上）：画面の一部をパンしたりズームしたりします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimento de câmera (a partir de “Avançado”): panorâmica e zoom sobre uma área da imagem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jízda kamery (od režimu „Pokročilý“): švenk a zoom přes část obrazu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazda kamery (od trybu „Zaawansowany”): panorama i zoom po fragmencie obrazu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рух камери (від режиму «Розширений»): панорама й зум по ділянці зображення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движение камеры (с режима «Расширенный»): панорама и зум по участку изображения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera hareketi (“Gelişmiş” modundan itibaren): görüntünün bir bölümünde kaydırma ve yakınlaştırma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 무브('고급'부터): 화면 일부를 패닝하고 줌해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运镜（“高级”模式起）：在画面局部上平移和缩放。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerabevægelse (fra “Avanceret”): panorering og zoom over en del af billedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåkning (från ”Avancerad”): panorering och zoom över en del av bilden."
          }
        }
      }
    },
