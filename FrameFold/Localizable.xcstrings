    "Einmal klatschen = ein Bild. Das Mikrofon hört nur auf den Knall, nichts wird aufgenommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One clap = one frame. The microphone only listens for the clap; nothing is recorded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clap = une image. Le micro n’écoute que le claquement, rien n’est enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palmada = un fotograma. El micrófono solo escucha la palmada; no se graba nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un battito = un fotogramma. Il microfono ascolta solo il battito, non registra nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer klappen = één beeld. De microfoon luistert alleen naar de klap; er wordt niets opgenomen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回の拍手 = 1 コマ。マイクは拍手の音だけを聞き取り、何も録音しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palma = um quadro. O microfone só escuta a palma; nada é gravado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno tlesknutí = jeden snímek. Mikrofon poslouchá jen tlesknutí, nic se nenahrává."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno klaśnięcie = jedna klatka. Mikrofon nasłuchuje tylko klaśnięcia, nic nie jest nagrywane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один оплеск = один кадр. Мікрофон слухає лише оплеск, нічого не записується."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один хлопок = один кадр. Микрофон слушает только хлопок, ничего не записывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alkış = bir kare. Mikrofon yalnızca alkışı dinler, hiçbir şey kaydedilmez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박수 한 번 = 프레임 하나. 마이크는 박수 소리만 듣고, 아무것도 녹음하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一下手 = 一帧。麦克风只听拍手声，不会录下任何内容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét klap = ét billede. Mikrofonen lytter kun efter klappet; intet bliver optaget."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En klapp = en bild. Mikrofonen lyssnar bara efter klappen; inget spelas in."
          }
        }
      }
    },
