    "Zeigt das erste oder letzte Bild als Überblendung – zum Ausrichten und um Drift zu erkennen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlays the first or last frame — for lining up and spotting drift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpose la première ou la dernière image — pour aligner et repérer les dérives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el primer o el último fotograma superpuesto, para alinear y detectar desplazamientos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra in sovrimpressione il primo o l’ultimo fotogramma, per allineare e scoprire spostamenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het eerste of laatste beeld als overlay – om uit te lijnen en verschuiving te zien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初または最後のコマを重ねます — 位置合わせやずれの確認に。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe o primeiro ou o último quadro — para alinhar e perceber desvios."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí první nebo poslední snímek jako překryv – k vyrovnání a odhalení posunu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje pierwszą lub ostatnią klatkę jako nakładkę – do wyrównania i wykrywania dryfu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує перший або останній кадр накладанням — щоб вирівняти й помітити зсув."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накладывает первый или последний кадр — чтобы выровнять и заметить смещение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk ya da son kareyi üst üste bindirir — hizalamak ve kaymayı fark etmek için."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 프레임이나 마지막 프레임을 겹쳐 보여 줘요 — 정렬하고 어긋남을 찾을 때."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叠加显示第一帧或最后一帧——用于对齐和发现漂移。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lægger det første eller sidste billede over — til justering og til at opdage drift."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger den första eller sista bilden över — för att rikta in och upptäcka drift."
          }
        }
      }
    },
