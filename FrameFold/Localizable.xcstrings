    "Auslösen geht auch von Hand: großer Knopf, Lautstärketasten, Apple Watch, Klatschen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also shoot by hand: big button, volume buttons, Apple Watch, clapping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On peut aussi déclencher à la main : grand bouton, touches de volume, Apple Watch, applaudissement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se puede disparar a mano: botón grande, botones de volumen, Apple Watch, palmada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può scattare anche a mano: pulsante grande, tasti del volume, Apple Watch, battito di mani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook met de hand opnemen: grote knop, volumeknoppen, Apple Watch, klappen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動でも撮影できます：大きなボタン、音量ボタン、Apple Watch、拍手。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode disparar manualmente: botão grande, botões de volume, Apple Watch, palmas."
          }
        }
      }
    },
    "Bilder per Ziehen umordnen; entfernte Bilder liegen 30 Tage im Papierkorb.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag frames to reorder; removed frames stay in the trash for 30 days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les images pour les réordonner ; les images retirées restent 30 jours dans la corbeille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los fotogramas para reordenarlos; los eliminados quedan 30 días en la papelera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i fotogrammi per riordinarli; quelli rimossi restano 30 giorni nel cestino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep beelden om ze te herschikken; verwijderde beelden blijven 30 dagen in de prullenmand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマはドラッグで並べ替え。削除したコマは 30 日間ゴミ箱に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste quadros para reordenar; quadros removidos ficam 30 dias na lixeira."
          }
        }
      }
    },
    "Bilder, Ton und Werke bleiben auf dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames, sound and works stay on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, son et œuvres restent sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogramas, sonido y obras se quedan en el dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogrammi, audio e opere restano sul dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beelden, geluid en werken blijven op het apparaat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマ、サウンド、作品はデバイス内にとどまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadros, som e obras ficam no dispositivo."
          }
        }
      }
    },
    "Bildrate, Format und Look wählen, dann „Stopmotion exportieren“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose frame rate, format and look, then “Export stop-motion”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la cadence, le format et le look, puis « Exporter le stop motion »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la velocidad, el formato y el look, y luego «Exportar stop motion»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli frequenza, formato e look, poi «Esporta stop motion»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies beeldsnelheid, formaat en look, dan ‘Stop-motion exporteren’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームレート、アスペクト比、ルックを選んで「コマ撮りを書き出す」へ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha taxa de quadros, formato e visual, depois “Exportar stop motion”."
          }
        }
      }
    },
