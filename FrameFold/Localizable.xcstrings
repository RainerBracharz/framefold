        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num texto ou balão de fala para editar ou mover."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na text nebo bublinu ji upravíš nebo posuneš."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij tekst lub dymek, aby go edytować lub przesunąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися тексту або бульбашки, щоб змінити чи перемістити."
