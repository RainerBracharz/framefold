            "state": "translated",
            "value": "Los ajustes de siempre: formato, velocidad, reproducción, estabilización."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni classiche: formato, frame rate, riproduzione, stabilizzazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klassieke instellingen: formaat, beeldsnelheid, afspelen, stabilisatie."
