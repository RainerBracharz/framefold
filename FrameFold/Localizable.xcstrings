        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプル作品「サンプル：折り」で、完成した作品の姿を見られます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A obra de exemplo “Exemplo: Dobra” mostra como fica uma obra pronta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázkové dílo „Skládanka“ ukazuje, jak vypadá hotové dílo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykładowa praca „Składanka” pokazuje, jak wygląda gotowa praca."
