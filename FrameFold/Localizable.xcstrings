    "Belichtung, Fokus und Weißabgleich bleiben, wie du sie stellst – die Automatik misst nicht mehr nach.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposure, focus and white balance stay exactly as you set them – the automatic metering no longer adjusts them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposition, mise au point et balance des blancs restent comme tu les règles – l’automatisme ne les corrige plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exposición, el enfoque y el balance de blancos se quedan como los ajustes: la medición automática ya no los corrige."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esposizione, messa a fuoco e bilanciamento del bianco restano come li imposti: l’automatismo non li corregge più."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Belichting, focus en witbalans blijven zoals je ze instelt – de automatiek meet niet meer na."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "露出、フォーカス、ホワイトバランスは設定したとおりに保たれます – 自動測光では調整されなくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposição, foco e balanço de branco ficam exatamente como você definiu – a medição automática não os ajusta mais."
          }
        }
      }
    },
