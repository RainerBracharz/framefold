            "value": "Don't fire while hands are in frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas déclencher tant que des mains sont dans le cadre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disparar mientras haya manos en el encuadre"
