    "Einfach: nur Auslöser und Fertig. Alles Weitere erscheint ab \"Erweitert\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple: just the shutter and Done. Everything else appears from \"Advanced\" on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple : juste le déclencheur et Terminé. Le reste apparaît à partir du mode « Avancé »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sencillo: solo el obturador y Listo. Todo lo demás aparece a partir de «Avanzado»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Semplice: solo scatto e Fine. Tutto il resto compare da «Avanzata» in su."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenvoudig: alleen ontspanner en Klaar. Al het andere verschijnt vanaf ‘Uitgebreid’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプル：シャッターと「完了」だけ。そのほかの機能は「詳細」から表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simples: só o obturador e Concluído. Todo o resto aparece a partir de “Avançado”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednoduchý: jen spoušť a Hotovo. Vše ostatní se objeví od režimu „Pokročilý“."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosty: tylko spust i Gotowe. Wszystko inne pojawia się od trybu „Zaawansowany”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Простий: лише затвор і «Готово». Решта з’являється від режиму «Розширений»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Простой: только затвор и «Готово». Всё остальное — начиная с режима «Расширенный»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basit: yalnızca deklanşör ve Bitti. Gerisi \"Gelişmiş\" modundan itibaren görünür."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단: 셔터와 완료만. 나머지는 \"고급\"부터 나타나요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简单：只有快门和“完成”。其他功能从“高级”起显示。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkel: kun udløser og Færdig. Alt andet vises fra \"Avanceret\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkel: bara avtryckare och Klar. Allt annat visas från och med \"Avancerad\"."
          }
        }
      }
    },
