    "Fotos aus der Mediathek lassen sich als Bilder anhängen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos from your library can be appended as frames."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos de la photothèque peuvent être ajoutées comme images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de la fototeca se pueden añadir como fotogramas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto della libreria si possono aggiungere come fotogrammi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s uit de bibliotheek kun je als beelden toevoegen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォトライブラリの写真をコマとして追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos da sua fototeca podem ser adicionadas como quadros."
          }
        }
      }
    },
    "Gedrückt halten startet einen Selbstauslöser von 3 Sekunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to start a 3-second self-timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui long lance un retardateur de 3 secondes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado inicia un temporizador de 3 segundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere premuto avvia un autoscatto di 3 secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingedrukt houden start een zelfontspanner van 3 seconden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しすると 3 秒のセルフタイマーが始まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar inicia um temporizador de 3 segundos."
          }
        }
      }
    },
