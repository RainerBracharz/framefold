            "value": "Looking for camera … connect it via USB and turn it on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de l’appareil … branche-le en USB et allume-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando cámara… conéctala por USB y enciéndela."
          }
        },
