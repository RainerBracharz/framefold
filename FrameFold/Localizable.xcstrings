    "Ein Blatt pro Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One sheet per work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille par œuvre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja por obra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio per opera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén vel per werk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 作品につき 1 シート。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha por obra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden arch na dílo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden arkusz na pracę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один аркуш на роботу."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один лист на работу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her eser için bir sayfa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작품마다 한 장."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每件作品一页。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét ark pr. værk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ark per verk."
          }
        }
      }
    },
    "Ein Werk gewählt – noch mindestens eines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One work picked — at least one more to go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une œuvre choisie — encore une au moins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una obra elegida: falta al menos otra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’opera scelta: ne serve almeno un’altra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén werk gekozen – nog minstens één."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 作品を選択しました — あと 1 つ以上選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma obra escolhida — falta pelo menos mais uma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybráno jedno dílo – ještě aspoň jedno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrano jedną pracę – jeszcze co najmniej jedna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано одну роботу — потрібна ще щонайменше одна."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрана одна работа — нужна ещё хотя бы одна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eser seçildi — en az bir tane daha."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작품 하나 선택됨 — 하나 이상 더 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选一件作品——至少再选一件。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét værk valgt — mindst ét mere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett verk valt — minst ett till."
          }
        }
      }
    },
