    "Kamera nicht berühren: fest über dem Tisch montieren und den Auto-Shutter arbeiten lassen (oder den runden Knopf).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't touch the camera: mount it firmly above the table and let the auto-shutter work (or use the round button)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne touche pas la caméra : fixe-la bien au-dessus de la table et laisse faire le déclenchement auto (ou le bouton rond)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No toques la cámara: móntala firme sobre la mesa y deja trabajar al disparo automático (o usa el botón redondo)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non toccare la fotocamera: fissala bene sopra il tavolo e lascia lavorare lo scatto automatico (o usa il pulsante rotondo)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak de camera niet aan: monteer hem stevig boven de tafel en laat de auto-ontspanner werken (of gebruik de ronde knop)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラには触れないでください：テーブルの上にしっかり固定し、オートシャッターにまかせましょう（または丸いボタンを使います）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não toque na câmera: fixe-a bem acima da mesa e deixe o obturador automático trabalhar (ou use o botão redondo)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedotýkej se kamery: připevni ji pevně nad stůl a nech pracovat automatickou spoušť (nebo kulaté tlačítko)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dotykaj kamery: zamocuj ją na stałe nad stołem i pozwól działać automatycznemu spustowi (albo okrągłemu przyciskowi)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не торкайся камери: закріпи її нерухомо над столом і дай попрацювати автозатвору (або круглій кнопці)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не трогайте камеру: надёжно закрепите её над столом и доверьтесь автозатвору (или круглой кнопке)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraya dokunmayın: masanın üzerine sağlam monte edin ve otomatik deklanşörün çalışmasına izin verin (ya da yuvarlak düğmeyi kullanın)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 만지지 마세요: 테이블 위에 단단히 고정하고 자동 셔터에 맡기세요(또는 둥근 버튼)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要触碰相机：把它牢固地安装在桌子上方，让自动快门工作（或使用圆形按钮）。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rør ikke kameraet: monter det fast over bordet, og lad auto-udløseren arbejde (eller brug den runde knap)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rör inte kameran: montera den stadigt över bordet och låt den automatiska avtryckaren jobba (eller använd den runda knappen)."
          }
        }
      }
    },
