    "So lange muss die Szene ruhig sein, bevor automatisch ausgelöst wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the scene has to stay calm before the shutter fires."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle la scène doit rester calme avant le déclenchement automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo que la escena debe estar quieta antes del disparo automático."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto deve restare ferma la scena prima dello scatto automatico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo lang moet de scène stil zijn voordat er automatisch wordt afgedrukt."
          }
        }
      }
    },
    "Standard erfasst großzügig. Unerwünschte Bilder oben einfach abwählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default errs on the generous side. Just deselect what you don't want above."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, la sélection est généreuse. Désélectionne simplement ci-dessus ce que tu ne veux pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción estándar es generosa. Simplemente quita arriba los fotogramas que no quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impostazione standard è generosa. Deseleziona qui sopra i fotogrammi che non vuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaard pakt ruim. Haal ongewenste beelden hierboven gewoon weg."
          }
        }
      }
    },
