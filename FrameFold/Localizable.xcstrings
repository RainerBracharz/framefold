            "state": "translated",
            "value": "Camera en ontspanner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラとシャッター"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera e obturador"
          }
        }
      }
    },
    "Kein Konto, keine Werbung, keine Netzwerkverbindung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no ads, no network connection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de publicité, pas de connexion réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin conexión de red."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessuna pubblicità, nessuna connessione di rete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account, geen reclame, geen netwerkverbinding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなし、広告なし、ネットワーク接続なし。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem anúncios, sem conexão de rede."
          }
        }
      }
    },
    "Kleine Schritte machen weiche, große Schritte schnelle Bewegung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small steps make smooth motion, big steps make fast motion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De petits pas donnent un mouvement doux, de grands pas un mouvement rapide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos pequeños dan movimiento suave; pasos grandes, movimiento rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passi piccoli danno un movimento morbido, passi grandi un movimento veloce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine stappen geven zachte, grote stappen snelle beweging."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく動かすとなめらかに、大きく動かすと速い動きになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos pequenos dão movimento suave; passos grandes, movimento rápido."
          }
        }
      }
    },
