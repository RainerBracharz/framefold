    "Spracherkennung ist nicht erlaubt (Systemeinstellungen → Datenschutz).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is not allowed (System Settings → Privacy)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale n’est pas autorisée (Réglages Système → Confidentialité)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz no está permitido (Ajustes del Sistema → Privacidad)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale non è consentito (Impostazioni di Sistema → Privacy)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning is niet toegestaan (Systeeminstellingen → Privacy)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識が許可されていません（「システム設定」→「プライバシー」）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala não está permitido (Ajustes do Sistema → Privacidade)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání řeči není povoleno (Nastavení systému → Soukromí)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest niedozwolone (Ustawienia systemowe → Prywatność)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення не дозволено (Системні параметри → Приватність)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи не разрешено (Системные настройки → Конфиденциальность)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanımaya izin verilmiyor (Sistem Ayarları → Gizlilik)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식이 허용되지 않았어요(시스템 설정 → 개인정보 보호)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许语音识别（“系统设置” → “隐私”）。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talegenkendelse er ikke tilladt (Systemindstillinger → Anonymitet)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenkänning är inte tillåten (Systeminställningar → Integritet)."
          }
        }
