    "Alle Werkzeuge sichtbar: Raster, Pegel, Daumenkino mit Zurücknehmen, Neu-Einmessen, Referenzbild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool visible: grid, motion gauge, flip-book strip with undo, re-measure, reference image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils visibles : grille, jauge de mouvement, bande folioscope avec annulation, réétalonnage, image de référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas visibles: cuadrícula, indicador de movimiento, tira de flipbook con deshacer, volver a medir, imagen de referencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli strumenti visibili: griglia, indicatore di movimento, striscia flipbook con annulla, nuova misurazione, immagine di riferimento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle hulpmiddelen zichtbaar: raster, bewegingsmeter, flipboekstrook met ongedaan maken, opnieuw meten, referentiebeeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのツールを表示：グリッド、動き検知メーター、取り消し付きパラパラ帯、再測定、参考画像。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ferramentas à vista: grade, medidor de movimento, tira de flipbook com desfazer, nova medição, imagem de referência."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny nástroje na očích: mřížka, ukazatel pohybu, flipbook s vrácením, nové měření, referenční obrázek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie narzędzia widoczne: siatka, wskaźnik ruchu, flipbook z cofaniem, ponowny pomiar, obraz referencyjny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі інструменти на виду: сітка, індикатор руху, фліпбук зі скасуванням, повторне вимірювання, еталонне зображення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все инструменты на виду: сетка, индикатор движения, лента кадров с отменой, повторное измерение, эталонный кадр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm araçlar görünür: ızgara, hareket göstergesi, geri almalı kare şeridi, yeniden ölçme, referans görüntü."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 도구 표시: 격자, 움직임 게이지, 취소 가능한 프레임 스트립, 다시 측정, 참조 이미지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有工具：网格、动作指示、可撤销的手翻条、重新校准、参考图像。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle værktøjer synlige: gitter, bevægelsesmåler, flipbogsstrimmel med fortryd, kalibrér igen, referencebillede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla verktyg synliga: rutnät, rörelsemätare, blädderboksremsa med ångra, kalibrera igen, referensbild."
          }
        }
      }
    },
    "Alle Werkzeuge sichtbar: Raster, Wasserwaage, Pegel, Daumenkino mit Zurücknehmen, Neu-Fixieren, Referenzbild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool visible: grid, spirit level, motion gauge, flip-book strip with undo, re-lock, reference image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils visibles : grille, niveau, jauge de mouvement, bande folioscope avec annulation, reverrouillage, image de référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas visibles: cuadrícula, nivel, indicador de movimiento, tira de flipbook con deshacer, volver a bloquear, imagen de referencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli strumenti visibili: griglia, livella, indicatore di movimento, striscia flipbook con annulla, nuovo blocco, immagine di riferimento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle hulpmiddelen zichtbaar: raster, waterpas, bewegingsmeter, flipboekstrook met ongedaan maken, opnieuw vastzetten, referentiebeeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのツールを表示：グリッド、水準器、動き検知メーター、取り消し付きパラパラ帯、再ロック、参考画像。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ferramentas à vista: grade, nível de bolha, medidor de movimento, tira de flipbook com desfazer, novo bloqueio, imagem de referência."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny nástroje na očích: mřížka, vodováha, ukazatel pohybu, flipbook s vrácením, nové zamčení, referenční obrázek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie narzędzia widoczne: siatka, poziomica, wskaźnik ruchu, flipbook z cofaniem, ponowna blokada, obraz referencyjny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі інструменти на виду: сітка, рівень, індикатор руху, фліпбук зі скасуванням, повторна фіксація, еталонне зображення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все инструменты на виду: сетка, уровень, индикатор движения, лента кадров с отменой, повторная фиксация, эталонный кадр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm araçlar görünür: ızgara, su terazisi, hareket göstergesi, geri almalı kare şeridi, yeniden kilitleme, referans görüntü."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 도구 표시: 격자, 수평계, 움직임 게이지, 취소 가능한 프레임 스트립, 다시 고정, 참조 이미지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所有工具：网格、水平仪、动作指示、可撤销的手翻条、重新锁定、参考图像。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle værktøjer synlige: gitter, vaterpas, bevægelsesmåler, flipbogsstrimmel med fortryd, lås igen, referencebillede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla verktyg synliga: rutnät, vattenpass, rörelsemätare, blädderboksremsa med ångra, lås igen, referensbild."
          }
        }
      }
    },
