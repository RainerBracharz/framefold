            "state": "translated",
            "value": "Kamera nad stołem, zdjęcia same"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера над столом, знімає сама"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера над столом, снимает сама"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera masanın üzerinde, kendiliğinden çeker"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 테이블 위에, 저절로 촬영"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机在桌子上方，自动拍摄"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera over bordet, tager billeder selv"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran över bordet, tar bilder själv"
          }
        }
      }
    },
    "Keine ruhigen Momente gefunden. Halte beim Filmen zwischendurch kurz still – oder nimm etwas länger auf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calm moments found. Hold still for a moment now and then while filming – or record a little longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun moment calme trouvé. Reste immobile un instant de temps en temps pendant le tournage – ou filme un peu plus longtemps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron momentos de calma. Al grabar, quédate quieto de vez en cuando, o graba un poco más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun momento di calma trovato. Mentre riprendi, fermati ogni tanto, oppure riprendi un po’ più a lungo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen rustige momenten gevonden. Houd tijdens het filmen af en toe even stil – of neem wat langer op."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静止した瞬間が見つかりません。撮影中にときどき手を止めるか、もう少し長く録画してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum momento parado encontrado. Fique parado de vez em quando enquanto filma – ou grave um pouco mais."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenalezeny žádné klidné okamžiky. Při natáčení se občas na chvilku zastav – nebo natoč něco delšího."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono spokojnych chwil. Podczas filmowania co jakiś czas na chwilę się zatrzymaj – albo nagraj trochę dłużej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійних моментів не знайдено. Під час зйомки час від часу ненадовго завмирай — або зніми трохи довше."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойных моментов не найдено. Во время съёмки иногда замирайте — или снимайте чуть дольше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durgun an bulunamadı. Çekerken arada bir kısa süre durun — ya da biraz daha uzun çekin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멈춘 순간을 찾지 못했어요. 촬영 중간중간 잠시 멈추거나 조금 더 길게 촬영하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到静止的瞬间。拍摄时请不时停顿一下——或者拍长一点。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen rolige øjeblikke fundet. Hold stille et øjeblik ind imellem, mens du filmer — eller optag lidt længere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga lugna ögonblick hittades. Håll still en stund då och då medan du filmar — eller filma lite längre."
          }
        }
      }
    },
