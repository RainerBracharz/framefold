    },
    "Musik oder Ton aus Dateien hinzufügen, Stimme direkt aufnehmen oder Text sprechen lassen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music or sound from files, record your voice directly or have text spoken."
          }
        },
        "fr": {
