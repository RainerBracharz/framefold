    "Alle Werkzeuge sichtbar: Raster, Pegel, Daumenkino mit Zurücknehmen, Neu-Einmessen, Referenzbild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool visible: grid, motion gauge, flip-book strip with undo, re-measure, reference image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils visibles : grille, jauge de mouvement, bande folioscope avec annulation, réétalonnage, image de référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas visibles: cuadrícula, indicador de movimiento, tira de flipbook con deshacer, volver a medir, imagen de referencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli strumenti visibili: griglia, indicatore di movimento, striscia flipbook con annulla, nuova misurazione, immagine di riferimento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle hulpmiddelen zichtbaar: raster, bewegingsmeter, flipboekstrook met ongedaan maken, opnieuw meten, referentiebeeld."
          }
        }
      }
    },
    "Alle Werkzeuge sichtbar: Raster, Wasserwaage, Pegel, Daumenkino mit Zurücknehmen, Neu-Fixieren, Referenzbild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool visible: grid, spirit level, motion gauge, flip-book strip with undo, re-lock, reference image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils visibles : grille, niveau, jauge de mouvement, bande folioscope avec annulation, reverrouillage, image de référence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas visibles: cuadrícula, nivel, indicador de movimiento, tira de flipbook con deshacer, volver a bloquear, imagen de referencia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli strumenti visibili: griglia, livella, indicatore di movimento, striscia flipbook con annulla, nuovo blocco, immagine di riferimento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle hulpmiddelen zichtbaar: raster, waterpas, bewegingsmeter, flipboekstrook met ongedaan maken, opnieuw vastzetten, referentiebeeld."
          }
        }
      }
    },
