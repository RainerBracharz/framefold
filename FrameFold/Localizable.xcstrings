        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцена постійно неспокійна. Перевір штатив — або збільш допуск руху в налаштуваннях."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сцена никак не успокаивается. Проверьте штатив — или увеличьте допуск движения в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahne bir türlü durulmuyor. Tripodu kontrol edin — ya da ayarlardan hareket toleransını artırın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장면이 계속 안정되지 않아요. 삼각대를 확인하거나 설정에서 움직임 허용치를 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景始终无法静止。请检查三脚架——或在设置中调高动作容差。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen falder aldrig til ro. Tjek stativet — eller hæv bevægelsestolerancen i indstillingerne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Scenen lugnar aldrig ner sig. Kontrollera stativet — eller höj rörelsetoleransen i inställningarna."
          }
