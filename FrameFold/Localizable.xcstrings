    "Kamera verrutscht? Der Hintergrund liegt anders als beim ersten Bild.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera moved? The background sits differently than in the first frame."
          }
        },
        "fr": {
          "stringUnit": {
