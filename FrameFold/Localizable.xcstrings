          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kommandon med tangentbordet: menyn ”Studio”."
          }
        }
      }
    },
    "Alles lässt sich rückgängig machen: mit den Pfeil-Knöpfen oder ⌘Z.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything can be undone: with the arrow buttons or ⌘Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout peut être annulé : avec les boutons fléchés ou ⌘Z."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se puede deshacer: con los botones de flecha o ⌘Z."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto si può annullare: con i pulsanti a freccia o ⌘Z."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles kan ongedaan worden gemaakt: met de pijlknoppen of ⌘Z."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての操作は取り消せます：矢印ボタンまたは ⌘Z で。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pode ser desfeito: com os botões de seta ou ⌘Z."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechno jde vrátit: tlačítky se šipkami nebo ⌘Z."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko można cofnąć: przyciskami ze strzałkami lub ⌘Z."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе можна скасувати: кнопками-стрілками або ⌘Z."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё можно отменить: кнопками со стрелками или ⌘Z."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey geri alınabilir: ok düğmeleriyle ya da ⌘Z ile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 실행 취소할 수 있어요: 화살표 버튼이나 ⌘Z로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都可撤销：使用箭头按钮或 ⌘Z。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt kan fortrydes: med pileknapperne eller ⌘Z."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt kan ångras: med pilknapparna eller ⌘Z."
          }
        }
      }
    },
    "Als Tonspur hinzufügen": {
