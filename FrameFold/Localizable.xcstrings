    "Aufnahmeart: Stativ. Tippen für aus der Hand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture mode: tripod. Tap for handheld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode : trépied. Touche pour passer à main levée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de captura: trípode. Toca para a mano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità di ripresa: treppiede. Tocca per a mano libera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnamewijze: statief. Tik voor uit de hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影モード：三脚。タップで手持ちに切り替え。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de captura: tripé. Toque para na mão."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Způsob snímání: stativ. Klepnutím z ruky."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb: statyw. Stuknij, aby wybrać z ręki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим зйомки: штатив. Торкнися — з рук."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим съёмки: штатив. Коснитесь для съёмки с рук."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekim modu: tripod. Elde çekim için dokunun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 방식: 삼각대. 탭하면 핸드헬드로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄方式：三脚架。轻点切换为手持。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagetilstand: stativ. Tryk for håndholdt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läge: stativ. Tryck för handhållen."
          }
        }
      }
    },
