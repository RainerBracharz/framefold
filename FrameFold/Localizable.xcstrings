    "Fokus findet nichts Scharfes. Liegt das Werk im Bildfeld der Kamera?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus can't find anything sharp. Is your work within the camera's view?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise au point ne trouve rien de net. Ton œuvre est-elle dans le champ de la caméra ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enfoque no encuentra nada nítido. ¿Está tu obra dentro del campo de la cámara?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La messa a fuoco non trova niente di nitido. L’opera è nel campo della fotocamera?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De focus vindt niets scherps. Ligt het werk in het beeldveld van de camera?"
          }
        }
      }
    },
    "Fokus findet nichts Scharfes. Tippe im Sucher auf dein Werk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus can't find anything sharp. Tap your work in the viewfinder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise au point ne trouve rien de net. Touche ton œuvre dans le viseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enfoque no encuentra nada nítido. Toca tu obra en el visor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La messa a fuoco non trova niente di nitido. Tocca la tua opera nel mirino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De focus vindt niets scherps. Tik in de zoeker op je werk."
          }
        }
      }
    },
