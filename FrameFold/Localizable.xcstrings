    "Jedes Bild als Foto vom Sensor statt als Videobild (1080p) – schärfer, braucht mehr Speicher.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every frame as a photo from the sensor instead of a video frame (1080p) – sharper, uses more storage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque image comme photo du capteur au lieu d’une image vidéo (1080p) – plus net, prend plus de place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fotograma como foto del sensor en lugar de imagen de vídeo (1080p): más nítido, ocupa más espacio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni fotogramma come foto dal sensore invece che dal video (1080p): più nitido, occupa più spazio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk beeld als foto van de sensor in plaats van een videobeeld (1080p) – scherper, neemt meer ruimte in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各コマをビデオフレーム（1080p）ではなくセンサーからの写真として記録 – よりシャープですが、ストレージを多く使います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada quadro como foto do sensor em vez de quadro de vídeo (1080p) – mais nítido, ocupa mais espaço."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý snímek jako fotka ze snímače místo snímku z videa (1080p) – ostřejší, zabere víc místa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda klatka jako zdjęcie z matrycy zamiast klatki wideo (1080p) – ostrzejsza, zajmuje więcej miejsca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен кадр як фото з сенсора замість кадру з відео (1080p) — різкіше, займає більше місця."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый кадр — фото с матрицы, а не кадр видео (1080p): резче, но занимает больше места."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kare video karesi (1080p) yerine sensörden fotoğraf olarak — daha net, daha çok yer kaplar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 프레임을 비디오 프레임(1080p) 대신 센서 사진으로 — 더 선명하지만 저장 공간을 더 써요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一帧都用传感器拍摄的照片，而非视频画面（1080p）——更清晰，但占用更多存储空间。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert billede som foto fra sensoren i stedet for et videobillede (1080p) — skarpere, bruger mere lagerplads."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje bild som foto från sensorn i stället för en videobild (1080p) — skarpare, tar mer lagringsutrymme."
          }
        }
      }
    },
    "Auslösen per Klatschen": {
      "localizations": {
        "en": {
