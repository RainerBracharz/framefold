    "10 Bilder sind eine Sekunde Film bei 10 Bildern pro Sekunde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 frames make one second of film at 10 frames per second."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 images font une seconde de film à 10 images par seconde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10 fotogramas son un segundo de película a 10 fotogramas por segundo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "10 fotogrammi sono un secondo di film a 10 fotogrammi al secondo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 beelden zijn één seconde film bij 10 beelden per seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 fps なら、10 コマで映像 1 秒分です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "10 quadros dão um segundo de filme a 10 quadros por segundo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "10 snímků je jedna sekunda filmu při 10 snímcích za sekundu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 klatek to sekunda filmu przy 10 klatkach na sekundę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "10 кадрів — це секунда фільму при 10 кадрах за секунду."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10 кадров — это секунда фильма при 10 кадрах в секунду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saniyede 10 karede, 10 kare bir saniyelik film eder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초당 10프레임이면 10프레임이 영상 1초예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按每秒 10 帧计算，10 帧就是一秒影片。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "10 billeder er ét sekunds film ved 10 billeder i sekundet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "10 bilder blir en sekund film vid 10 bilder per sekund."
          }
        }
      }
    },
    "Ab „Erweitert“ zeigt die Kamera am Mac und iPad die Studio-Arbeitsfläche, am iPhone nach Einschalten in den Kamera-Einstellungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From “Advanced” on, the camera shows the studio workspace on Mac and iPad – on iPhone after switching it on in the camera settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du mode « Avancé », la caméra affiche l’espace studio sur Mac et iPad – sur iPhone après l’avoir activé dans les réglages de la caméra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de «Avanzado», la cámara muestra el espacio de estudio en Mac y iPad; en el iPhone, tras activarlo en los ajustes de la cámara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da «Avanzata» in poi, la fotocamera mostra lo spazio studio su Mac e iPad – su iPhone dopo averlo attivato nelle impostazioni della fotocamera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf ‘Uitgebreid’ toont de camera op Mac en iPad de studio-werkruimte – op iPhone nadat je die in de camera-instellingen hebt ingeschakeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「詳細」以降、Mac と iPad ではカメラに Studio の作業スペースが表示されます。iPhone ではカメラの設定でオンにすると表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir do “Avançado”, a câmera mostra a área de trabalho do Studio no Mac e no iPad – no iPhone, depois de ativá-la nos ajustes da câmera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od režimu „Pokročilý“ ukazuje kamera na Macu a iPadu pracovní plochu Studio, na iPhonu po zapnutí v nastavení kamery."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od trybu „Zaawansowany” aparat na Macu i iPadzie pokazuje obszar roboczy Studio, na iPhonie po włączeniu w ustawieniach aparatu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від режиму «Розширений» камера на Mac і iPad показує робочу область Студії, на iPhone — після ввімкнення в налаштуваннях камери."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начиная с режима «Расширенный», камера на Mac и iPad показывает рабочее место студии, на iPhone — после включения в настройках камеры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Gelişmiş” modundan itibaren kamera Mac ve iPad'de stüdyo çalışma alanını gösterir; iPhone'da kamera ayarlarından açtıktan sonra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'고급'부터 Mac과 iPad의 카메라에 스튜디오 작업 공간이 표시되고, iPhone에서는 카메라 설정에서 켜면 표시돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“高级”起，Mac 和 iPad 上的相机会显示 Studio 工作区；iPhone 上需在相机设置中开启。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra “Avanceret” viser kameraet studie-arbejdsfladen på Mac og iPad — på iPhone, når du slår den til i kameraindstillingerne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från och med ”Avancerad” visar kameran studioarbetsytan på Mac och iPad — på iPhone när du har slagit på den i kamerainställningarna."
          }
        }
      }
    },
    "Alle Befehle mit Tastatur: Menü „Studio“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every command by keyboard: “Studio” menu."
          }
        },
        "fr": {
