          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempelværket “Foldning” viser, hvordan et færdigt værk ser ud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exempelverket ”Vikning” visar hur ett färdigt verk ser ut."
          }
        }
      }
    },
