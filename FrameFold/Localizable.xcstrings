    "Jede Facette liegt anders im Licht — als wäre das Bild gefaltet und wieder abfotografiert worden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each facet catches the light differently — as if the image had been folded and photographed again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque facette accroche la lumière autrement — comme si l’image avait été pliée puis rephotographiée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada faceta recibe la luz de otra manera, como si la imagen se hubiera plegado y vuelto a fotografiar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sfaccettatura prende la luce in modo diverso, come se l’immagine fosse stata piegata e fotografata di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk facet vangt het licht anders — alsof het beeld gevouwen en opnieuw gefotografeerd is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファセットごとに光の当たり方が変わります — まるで画像を折ってもう一度撮影したように。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada faceta capta a luz de um jeito diferente — como se a imagem tivesse sido dobrada e fotografada de novo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá faseta zachytí světlo jinak — jako by byl obraz složený a znovu vyfocený."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda faseta inaczej łapie światło — jakby obraz złożono i sfotografowano ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна фасета ловить світло по-своєму — наче зображення склали й знову сфотографували."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая грань по-своему ловит свет — будто снимок сложили и сфотографировали снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yüzey ışığı farklı yakalar — sanki görüntü katlanıp yeniden fotoğraflanmış gibi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면마다 빛을 다르게 받아요 — 사진을 접었다가 다시 찍은 것처럼."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个面受光各不相同——仿佛图像被折叠后又重新拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver facet fanger lyset forskelligt — som om billedet var foldet og fotograferet igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje fasett fångar ljuset olika — som om bilden hade vikts och fotograferats igen."
          }
        }
      }
    },
    "Kalibriere – kurz ruhig lassen…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrating — keep it steady…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrage — ne bouge pas…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrando: mantenlo quieto…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrazione: tienila ferma…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreren – even stilhouden…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリブレーション中 — 動かさないで…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrando — mantenha firme…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibruji – chvilku klid…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibruję – chwilę spokojnie…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Калібрую — трохи спокою…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калибровка — не двигайте…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibre ediliyor — sabit tutun…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 중 — 움직이지 마세요…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在校准——请保持稳定…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrerer — hold den rolig…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrerar — håll den stilla…"
          }
        }
      }
    },
