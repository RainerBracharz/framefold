    "Der runde Knopf löst jederzeit von Hand aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round button fires by hand at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton rond déclenche à la main à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón redondo dispara a mano en cualquier momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante rotondo scatta a mano in qualsiasi momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ronde knop drukt op elk moment met de hand af."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸いボタンでいつでも手動で撮影できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão redondo dispara manualmente a qualquer momento."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulaté tlačítko snímá ručně kdykoli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrągły przycisk robi zdjęcie ręcznie w każdej chwili."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кругла кнопка будь-коли знімає вручну."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглая кнопка в любой момент снимает вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuvarlak düğme istediğiniz an elle çeker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둥근 버튼으로 언제든 직접 촬영할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以按圆形按钮手动拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den runde knap tager et billede manuelt når som helst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den runda knappen tar en bild manuellt när som helst."
          }
        }
      }
    },
    "Der runde Knopf oder die Leertaste löst jederzeit von Hand aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round button or the space bar fires by hand at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton rond ou la barre d’espace déclenche à la main à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón redondo o la barra espaciadora disparan a mano en cualquier momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante rotondo o la barra spaziatrice scattano a mano in qualsiasi momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ronde knop of de spatiebalk drukt op elk moment met de hand af."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸いボタンかスペースキーでいつでも手動で撮影できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão redondo ou a barra de espaço disparam manualmente a qualquer momento."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulaté tlačítko nebo mezerník snímá ručně kdykoli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrągły przycisk lub spacja robi zdjęcie ręcznie w każdej chwili."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кругла кнопка або пробіл будь-коли знімає вручну."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглая кнопка или пробел в любой момент снимают вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuvarlak düğme ya da boşluk tuşu istediğiniz an elle çeker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둥근 버튼이나 스페이스 바로 언제든 직접 촬영할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以按圆形按钮或空格键手动拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den runde knap eller mellemrumstasten tager et billede manuelt når som helst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den runda knappen eller mellanslagstangenten tar en bild manuellt när som helst."
          }
        }
      }
    },
    "Die Bildauswahl läuft automatisch: FrameFold erfasst alle ruhigen Momente und entfernt Bilder mit Händen. Feinschliff machst du danach in der Bildauswahl.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame selection runs by itself: FrameFold catches every calm moment and drops frames with hands in them. You do the fine-tuning afterwards in frame selection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection se fait toute seule : FrameFold saisit chaque moment calme et écarte les images où l’on voit des mains. Tu peaufines ensuite dans la sélection d’images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección de fotogramas es automática: FrameFold capta cada momento de calma y descarta los fotogramas con manos. Después ajustas los detalles en la selección de fotogramas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione dei fotogrammi è automatica: FrameFold coglie ogni momento di calma e scarta i fotogrammi con le mani. Le rifiniture le fai dopo nella selezione dei fotogrammi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beeldselectie gaat vanzelf: FrameFold legt elk rustig moment vast en laat beelden met handen weg. De puntjes op de i zet je daarna in de beeldselectie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマの選択は自動で行われます：FrameFold が静止した瞬間をすべてとらえ、手が写ったコマを除外します。仕上げの調整はあとからコマの選択で行います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção de quadros acontece sozinha: o FrameFold capta cada momento parado e descarta quadros com mãos. Você faz o ajuste fino depois, na seleção de quadros."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výběr snímků běží automaticky: FrameFold zachytí všechny klidné okamžiky a odebere snímky s rukama. Doladíš to pak ve výběru snímků."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór klatek działa automatycznie: FrameFold wyłapuje wszystkie spokojne chwile i usuwa klatki z rękami. Szlify robisz potem w wyborze klatek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір кадрів відбувається автоматично: FrameFold ловить усі спокійні моменти й вилучає кадри з руками. Доопрацювання — потім у виборі кадрів."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры выбираются автоматически: FrameFold ловит все спокойные моменты и убирает кадры с руками. Доводку вы сделаете потом в выборе кадров."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare seçimi kendiliğinden yapılır: FrameFold tüm durgun anları yakalar ve el görünen kareleri çıkarır. İnce ayarı sonra kare seçiminde yaparsınız."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임 선택은 자동이에요: FrameFold가 멈춘 순간을 모두 잡아내고 손이 보이는 프레임을 지워요. 세부 조정은 나중에 프레임 선택에서 하면 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选帧自动进行：FrameFold 捕捉所有静止的瞬间，并移除有手的帧。之后你可以在选帧界面中精修。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedvalget sker automatisk: FrameFold fanger alle rolige øjeblikke og fjerner billeder med hænder. Finpudsningen laver du bagefter i billedvalget."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildurvalet sker automatiskt: FrameFold fångar alla lugna ögonblick och tar bort bilder med händer. Finputsningen gör du sedan i bildurvalet."
          }
        }
      }
    },
    "Die Bilder kommen ans Ende des Werks und lassen sich dort mit weiteren Aufnahmen ergänzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frames go to the end of the work, where you can add more sessions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images s’ajoutent à la fin de l’œuvre, où tu peux ajouter d’autres séances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fotogramas van al final de la obra, donde puedes añadir más sesiones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fotogrammi vanno alla fine dell’opera, dove puoi aggiungere altre sessioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beelden komen aan het einde van het werk, waar je meer sessies kunt toevoegen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマは作品の最後に追加され、そこにさらにセッションを加えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros vão para o final da obra, onde você pode adicionar mais sessões."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky se přidají na konec díla, kde je můžeš doplnit dalším natáčením."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki trafią na koniec pracy, gdzie możesz uzupełnić je kolejnymi sesjami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри додаються в кінець роботи, де їх можна доповнити новими зйомками."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры добавятся в конец работы, где их можно дополнить новыми съёмками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareler eserin sonuna eklenir; orada yeni çekimlerle tamamlayabilirsiniz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임이 작품 끝에 추가되고, 거기서 촬영을 더 추가할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些帧会添加到作品末尾，你可以在那里继续添加拍摄内容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billederne kommer til sidst i værket, hvor du kan tilføje flere optagelser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna hamnar i slutet av verket, där du kan lägga till fler inspelningar."
          }
        }
      }
    },
    "Die Bilder wandern in ein neues Werk und lassen sich dort mit weiteren Aufnahmen ergänzen und neu exportieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frames move into a new work, where you can add more sessions and export again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images rejoignent une nouvelle œuvre, où tu peux ajouter d’autres séances et exporter à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fotogramas pasan a una obra nueva, donde puedes añadir más sesiones y volver a exportar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fotogrammi passano in una nuova opera, dove puoi aggiungere altre sessioni ed esportare di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beelden gaan naar een nieuw werk, waar je meer sessies kunt toevoegen en opnieuw kunt exporteren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマは新しい作品に移り、そこでセッションを追加して再び書き出せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros vão para uma nova obra, onde você pode adicionar mais sessões e exportar de novo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky se přesunou do nového díla, kde je můžeš doplnit dalším natáčením a znovu exportovat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki trafią do nowej pracy, gdzie możesz uzupełnić je kolejnymi sesjami i ponownie wyeksportować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри перейдуть до нової роботи, де їх можна доповнити новими зйомками й знову експортувати."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры переходят в новую работу, где их можно дополнить новыми съёмками и снова экспортировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareler yeni bir esere taşınır; orada yeni çekimler ekleyip yeniden dışa aktarabilirsiniz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임이 새 작품으로 옮겨지고, 거기서 촬영을 더 추가하고 다시 내보낼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些帧会移入一件新作品，你可以在那里继续添加拍摄内容并重新导出。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billederne flyttes ind i et nyt værk, hvor du kan tilføje flere optagelser og eksportere igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna flyttas till ett nytt verk, där du kan lägga till fler inspelningar och exportera igen."
          }
        }
      }
    },
    "Die Bilder wandern in ein Projekt und lassen sich dort mit weiteren Aufnahmen ergänzen und neu exportieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frames move into a project, where you can add more sessions and export again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images rejoignent un projet, où tu peux ajouter d’autres séances et exporter à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fotogramas pasan a un proyecto, donde puedes añadir más sesiones y volver a exportar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fotogrammi passano in un progetto, dove puoi aggiungere altre sessioni ed esportare di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beelden gaan naar een project, waar je meer sessies kunt toevoegen en opnieuw kunt exporteren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマはプロジェクトに移り、そこでセッションを追加して再び書き出せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros vão para um projeto, onde você pode adicionar mais sessões e exportar de novo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky se přesunou do projektu, kde je můžeš doplnit dalším natáčením a znovu exportovat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki trafią do projektu, gdzie możesz uzupełnić je kolejnymi sesjami i ponownie wyeksportować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри перейдуть до проєкту, де їх можна доповнити новими зйомками й знову експортувати."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры переходят в проект, где их можно дополнить новыми съёмками и снова экспортировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareler bir projeye taşınır; orada yeni çekimler ekleyip yeniden dışa aktarabilirsiniz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임이 프로젝트로 옮겨지고, 거기서 촬영을 더 추가하고 다시 내보낼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些帧会移入一个项目，你可以在那里继续添加拍摄内容并重新导出。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billederne flyttes ind i et projekt, hvor du kan tilføje flere optagelser og eksportere igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna flyttas till ett projekt, där du kan lägga till fler inspelningar och exportera igen."
          }
        }
      }
    },
    "Die ruhigen Momente werden gefunden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calm moments get found"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les moments calmes sont repérés"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se buscan los momentos de calma"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cercano i momenti di calma"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
