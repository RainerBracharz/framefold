    "Alle Werkzeuge sichtbar: Raster, Wasserwaage, Pegel, Daumenkino mit Zurücknehmen, Neu-Fixieren, Referenzbild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool visible: grid, spirit level, motion gauge, flip-book strip with undo, re-lock, reference image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils visibles : grille, niveau, jauge de mouvement, bande folioscope avec annulation, reverrouillage, image de référence."
          }
        }
      }
    },
    "Alle →": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All →"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout →"
          }
        }
      }
    },
    "Alles dabei — plus die Spezialfeatures: Facetten, Echo, Faltvorlage, Rekursion, Ausstellung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything, plus the studio effects: facets, echo, fold template, recursion, exhibition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout, plus les effets d’atelier : facettes, écho, gabarit de pliage, récursion, exposition."
          }
        }
      }
    },
