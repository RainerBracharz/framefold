    "Text oder Sprechblase antippen, um sie zu bearbeiten oder zu verschieben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a text or speech bubble to edit or move it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un texte ou une bulle pour le modifier ou le déplacer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un texto o bocadillo para editarlo o moverlo."
          }
        },
        "it": {
