    "Nicht auslösen, solange Hände im Bild sind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't fire while hands are in frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas déclencher tant que des mains sont dans le cadre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disparar mientras haya manos en el encuadre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non scattare finché ci sono mani nell’inquadratura"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet afdrukken zolang er handen in beeld zijn"
          }
        }
      }
    },
    "Nicht bewegen…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't move…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste immobile…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te muevas…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non muoverti…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet bewegen…"
          }
        }
      }
    },
    "Nimmt sofort ein Bild auf. Sonst löst die Kamera von selbst aus, sobald die Hände aus dem Bild sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes a frame right away. Otherwise the camera fires by itself once your hands are clear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend une image tout de suite. Sinon, la caméra déclenche toute seule dès que tes mains quittent le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un fotograma al instante. Si no, la cámara dispara sola en cuanto las manos salen del encuadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta subito un fotogramma. Altrimenti la fotocamera scatta da sola appena le mani escono dall’inquadratura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt meteen een beeld op. Anders drukt de camera vanzelf af zodra je handen uit beeld zijn."
          }
        }
      }
    },
    "Noch kein Werk – leg eines an, dann kann die Kamera loslegen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No work yet — start one and the camera can go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d’œuvre — crée-en une et la caméra peut démarrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna obra: crea una y la cámara podrá empezar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna opera: creane una e la fotocamera può partire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen werk – maak er een aan, dan kan de camera beginnen."
          }
        }
      }
    },
    "Noch nicht scharf…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sharp yet…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore net…"
          }
        },
        "es": {
