            "value": "“Örnek: Katlama” eseri, bitmiş bir eserin nasıl göründüğünü gösterir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예시 작품 '예시: 접기'에서 완성된 작품이 어떤 모습인지 볼 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
