    "Was falten\nwir heute?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are we\nfolding today?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On plie quoi\naujourd’hui ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué plegamos\nhoy?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa pieghiamo\noggi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat vouwen\nwe vandaag?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は何を\n折りますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que vamos\ndobrar hoje?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co dnes\nposkládáme?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co dziś\nskładamy?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що сьогодні\nскладаємо?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что сложим\nсегодня?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ne\nkatlıyoruz?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 무엇을\n접어 볼까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天我们\n折什么？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad folder\nvi i dag?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad viker\nvi i dag?"
          }
        }
      }
    },
