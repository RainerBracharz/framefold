          }
        }
      }
    },
    "Kurz": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Court"
          }
        }
      }
    },
    "Labor-Ansicht: Blattnummer, Sitzungsuhr, fixierte Belichtung, Messwerte – und der Falz-Countdown wandert in Amber um den Auslöser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab view: sheet number, session clock, locked exposure, readings — and the crease countdown runs in amber around the shutter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue labo : numéro de feuille, chrono de séance, exposition verrouillée, mesures — et le compte à rebours du pli tourne en ambre autour du déclencheur."
          }
        }
      }
    },
    "Lade Video…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading video…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement de la vidéo…"
          }
        }
      }
    },
    "Lese Bilder…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading frames…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture des images…"
          }
        }
      }
    },
    "Letztes Bild halten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold last frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Figer la dernière image"
          }
        }
      }
    },
    "Letztes Bild zurücknehmen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo last frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la dernière image"
          }
        }
      }
    },
    "Licht konstant halten: Kunstlicht nutzen, Fenster abdunkeln. Billige LED-/Leuchtstofflampen flackern im Netztakt und streifen einzelne Bilder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the light steady: use artificial light, shade the windows. Cheap LED and fluorescent lamps flicker at mains frequency and streak individual frames."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde une lumière constante : lumière artificielle, fenêtres occultées. Les LED et néons bon marché scintillent au rythme du secteur et zèbrent certaines images."
          }
        }
      }
    },
    "Live-Einstellungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live settings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages en direct"
          }
        }
      }
    },
    "Lokal auf diesem Gerät": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local, on this device"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En local, sur cet appareil"
          }
        }
      }
    },
    "Los geht's": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est parti !"
          }
        }
      }
    },
    "Los — ich schau zu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go ahead — I'm watching"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas-y — je regarde"
          }
        }
      }
    },
    "Lässt sich jederzeit über das Regler-Symbol ändern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this any time from the sliders icon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiable à tout moment via l’icône des curseurs."
          }
        }
      }
    },
    "Mehr Bilder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More frames"
          }
        },
        "fr": {
