    "Zeigt das erste oder letzte Bild als Überblendung – zum Ausrichten und um Drift zu erkennen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlays the first or last frame — for lining up and spotting drift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpose la première ou la dernière image — pour aligner et repérer les dérives."
          }
        }
      }
    },
    "Ziehen zum Durchblättern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to flip through"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour feuilleter"
          }
        }
      }
    },
    "Zu viel Wackeln – leg das iPhone irgendwo auf oder lehne es an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much shake — set the phone down or lean it against something."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de secousses — pose l’iPhone ou appuie-le contre quelque chose."
          }
        }
      }
    },
