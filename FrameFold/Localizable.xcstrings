    "Titel und Abspann eintragen – sie kommen vor und hinter den Film.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter title and credits – they go before and after the film."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le titre et le générique – ils se placent avant et après le film."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el título y los créditos: van antes y después de la película."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci titolo e titoli di coda – vanno prima e dopo il film."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul titel en aftiteling in – die komen voor en na de film."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルとエンドクレジットを入力 – 映像の前後に入ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira título e créditos – eles entram antes e depois do filme."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplň titulek a závěrečné titulky – přijdou před film a za něj."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz tytuł i napisy końcowe – trafią przed film i po nim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введи титр і фінальні титри — вони з’являться перед фільмом і після нього."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите заголовок и титры — они появятся до и после фильма."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık ve jeneriği girin — filmin önüne ve sonuna eklenir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목과 엔딩 크레딧을 입력하세요 — 영상 앞과 뒤에 붙어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入标题和片尾字幕——它们会出现在影片前后。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv titel og rulletekster — de kommer før og efter filmen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv titel och eftertexter — de hamnar före och efter filmen."
          }
        }
      }
    },
