    "Zu viel Bewegung – steht die Kamera wirklich fest?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much movement — is the camera really fixed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de mouvement — la caméra est-elle bien fixée ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado movimiento: ¿está la cámara realmente fija?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo movimento: la fotocamera è davvero fissa?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel beweging – staat de camera echt vast?"
