    "Nicht auslösen, solange Hände im Bild sind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't fire while hands are in frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas déclencher tant que des mains sont dans le cadre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disparar mientras haya manos en el encuadre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non scattare finché ci sono mani nell’inquadratura"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet afdrukken zolang er handen in beeld zijn"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が画面内にある間は撮影しない"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não disparar com mãos no quadro"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesnímat, dokud jsou v záběru ruce"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie rób zdjęć, gdy w kadrze są ręce"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знімати, поки в кадрі руки"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не снимать, пока в кадре руки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller kadrajdayken çekme"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손이 화면에 있는 동안 촬영 안 함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面中有手时不拍摄"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag ikke billeder, mens der er hænder i billedet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta inga bilder medan händer syns i bild"
          }
        }
      }
    },
    "Nicht bewegen…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't move…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste immobile…"
          }
        },
        "es": {
