    "Nur wenige Bilder gefunden. Halte beim Filmen öfter kurz still, dann werden es mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a few frames found. Pause more often while filming and there will be more."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu d’images trouvées. Fais plus souvent une courte pause pendant le tournage, il y en aura davantage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se encontraron unos pocos fotogramas. Al grabar, para más a menudo y habrá más."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovati solo pochi fotogrammi. Mentre riprendi, fermati più spesso e ce ne saranno di più."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maar weinig beelden gevonden. Houd tijdens het filmen vaker even stil, dan worden het er meer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかったコマはわずかです。撮影中にもっとこまめに手を止めると増えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poucos quadros encontrados. Faça pausas mais vezes enquanto filma e haverá mais."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalezeno jen pár snímků. Při natáčení se častěji na chvilku zastav a bude jich víc."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaleziono tylko kilka klatek. Częściej zatrzymuj się na chwilę podczas filmowania, a będzie ich więcej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдено лише кілька кадрів. Частіше ненадовго завмирай під час зйомки — і їх буде більше."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдено мало кадров. Чаще замирайте во время съёмки — и кадров станет больше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca birkaç kare bulundu. Çekerken daha sık durursanız kare sayısı artar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임을 조금밖에 찾지 못했어요. 촬영할 때 더 자주 잠시 멈추면 늘어나요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只找到少量帧。拍摄时多停顿几次，帧就会更多。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun få billeder fundet. Hold oftere en kort pause, mens du filmer, så bliver der flere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara några få bilder hittades. Gör oftare en kort paus medan du filmar, så blir det fler."
          }
        }
      }
    },
