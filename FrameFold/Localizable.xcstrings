    "Der runde Knopf löst jederzeit von Hand aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round button fires by hand at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton rond déclenche à la main à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón redondo dispara a mano en cualquier momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante rotondo scatta a mano in qualsiasi momento."
          }
        },
