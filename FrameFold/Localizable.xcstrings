    "Masken, Raster, Lupe, Referenzbild mit Chroma-Key, Differenz- und Belichtungsansicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masks, grid, loupe, reference image with chroma key, difference and exposure views."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masques, grille, loupe, image de référence avec incrustation, vues différence et exposition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscaras, cuadrícula, lupa, imagen de referencia con croma, vistas de diferencia y exposición."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maschere, griglia, lente, immagine di riferimento con chroma key, viste differenza ed esposizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskers, raster, loep, referentiebeeld met chromakey, verschil- en belichtingsweergave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスク、グリッド、ルーペ、クロマキー対応の参照画像、差分表示と露出表示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscaras, grade, lupa, imagem de referência com chroma key, visualizações de diferença e de exposição."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Masky, mřížka, lupa, referenční obrázek s klíčováním barvy, zobrazení rozdílu a expozice."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maski, siatka, lupa, obraz referencyjny z kluczowaniem kolorem, widok różnicy i ekspozycji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Маски, сітка, лупа, еталонне зображення з хромакеєм, вигляд різниці й експозиції."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маски, сетка, лупа, эталонный кадр с хромакеем, вид разницы и экспозиции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskeler, ızgara, büyüteç, chroma key'li referans görüntü, fark ve pozlama görünümü."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크, 격자, 확대경, 크로마 키 참조 이미지, 차이 보기와 노출 보기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遮罩、网格、放大镜、带色度抠像的参考图像、差异视图和曝光视图。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Masker, gitter, lup, referencebillede med chroma key, forskels- og eksponeringsvisning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Masker, rutnät, lupp, referensbild med chroma key, skillnads- och exponeringsvy."
          }
        }
      }
    },
    "Mikrofon nur auf Wunsch: für Sprachaufnahmen und das Auslösen per Klatschen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone only on request: for voice recordings and clap-to-shoot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro uniquement sur demande : pour les enregistrements vocaux et le déclenchement par applaudissement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrófono solo si lo pides: para grabar voz y disparar con una palmada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfono solo su richiesta: per le registrazioni vocali e lo scatto con il battito di mani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoon alleen op verzoek: voor spraakopnamen en opnemen door te klappen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクは必要なときだけ：声の録音と拍手での撮影に使います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfone só quando você pede: para gravar voz e disparar com palmas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jen na přání: pro nahrávání hlasu a snímání tlesknutím."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tylko na życzenie: do nagrań głosu i robienia zdjęć klaśnięciem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон лише за бажанням: для запису голосу та зйомки оплеском."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон — только по желанию: для записи голоса и съёмки по хлопку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon yalnızca istek üzerine: ses kaydı ve alkışla çekim için."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크는 원할 때만: 목소리 녹음과 박수 촬영용."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风仅在你需要时使用：用于录制人声和拍手拍摄。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon kun når du vil: til stemmeoptagelser og til at tage billeder med et klap."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon bara när du vill: för röstinspelningar och för att ta bilder med en klapp."
          }
        }
      }
    },
    "Mit dem Stift auf genau dieses Bild zeichnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw with the pen on exactly this frame."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez au stylet sur cette image précise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja con el lápiz justo en este fotograma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna con la penna proprio su questo fotogramma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken met de pen op precies dit beeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンでこのコマだけに描きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe com a caneta exatamente neste quadro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pérem kresli přímo na tento snímek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuj piórem dokładnie na tej klatce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малюй пером саме на цьому кадрі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисуйте пером прямо на этом кадре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalemle tam bu karenin üzerine çizin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펜으로 바로 이 프레임 위에 그려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用画笔只在这一帧上绘画。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn med pennen på netop dette billede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita med pennan på just den här bilden."
          }
        }
      }
    },
    "Musik oder Ton aus Dateien hinzufügen, Stimme direkt aufnehmen oder Text sprechen lassen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music or sound from files, record your voice directly or have text spoken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez musique ou son depuis des fichiers, enregistrez votre voix ou faites lire un texte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade música o sonido desde archivos, graba tu voz directamente o haz que se lea un texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi musica o audio da file, registra la voce direttamente o fai leggere un testo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg muziek of geluid uit bestanden toe, neem je stem direct op of laat tekst uitspreken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルから音楽やサウンドを追加したり、声を直接録音したり、テキストを読み上げさせたりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione música ou som de arquivos, grave sua voz diretamente ou faça um texto ser falado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej hudbu nebo zvuk ze souborů, nahraj hlas přímo, nebo nech text přečíst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj muzykę lub dźwięk z plików, nagraj głos bezpośrednio albo pozwól przeczytać tekst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай музику або звук із файлів, запиши голос одразу або дай озвучити текст."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте музыку или звук из файлов, записывайте голос или озвучивайте текст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalardan müzik ya da ses ekleyin, sesinizi doğrudan kaydedin ya da metni seslendirin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에서 음악이나 사운드를 추가하고, 목소리를 바로 녹음하거나 텍스트를 읽게 해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件添加音乐或声音、直接录制人声，或让文字朗读出来。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj musik eller lyd fra filer, optag din stemme direkte, eller få tekst læst op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till musik eller ljud från filer, spela in din röst direkt eller få text uppläst."
          }
        }
      }
    },
