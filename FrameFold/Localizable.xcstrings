    "Zeitleiste, Abspielen, Umschalten zwischen Live-Bild und Aufnahme, Zwiebelhaut über mehrere Bilder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, playback, toggling between live view and capture, onion skin across several frames."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, lecture, bascule entre image en direct et prise, pelure d’oignon sur plusieurs images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea de tiempo, reproducción, cambio entre imagen en vivo y toma, papel cebolla sobre varios fotogramas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline, riproduzione, passaggio tra immagine live e scatto, onion skin su più fotogrammi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdlijn, afspelen, wisselen tussen livebeeld en opname, onion skin over meerdere beelden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムライン、再生、ライブ映像と撮影済みの切り替え、複数コマのオニオンスキン。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linha do tempo, reprodução, alternância entre imagem ao vivo e captura, papel cebola de vários quadros."
          }
        }
      }
    },
