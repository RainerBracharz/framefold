    "Kleine Schritte machen weiche, große Schritte schnelle Bewegung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small steps make smooth motion, big steps make fast motion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De petits pas donnent un mouvement doux, de grands pas un mouvement rapide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos pequeños dan movimiento suave; pasos grandes, movimiento rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passi piccoli danno un movimento morbido, passi grandi un movimento veloce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine stappen geven zachte, grote stappen snelle beweging."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく動かすとなめらかに、大きく動かすと速い動きになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos pequenos dão movimento suave; passos grandes, movimento rápido."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malé kroky dělají plynulý pohyb, velké kroky rychlý."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Małe kroki dają płynny ruch, duże kroki szybki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малі кроки дають плавний рух, великі — швидкий."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькие шаги дают плавное движение, большие — быстрое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük adımlar yumuşak, büyük adımlar hızlı hareket sağlar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작게 움직이면 부드럽게, 크게 움직이면 빠르게 보여요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小步移动动作柔和，大步移动动作迅速。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Små skridt giver bløde bevægelser, store skridt giver hurtige."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Små steg ger mjuka rörelser, stora steg ger snabba."
          }
        }
      }
    },
