{
  "sourceLanguage": "de",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Systemdialog beim ersten Öffnen der Kamera",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold nimmt im Live-Modus automatisch Bilder auf, wenn deine Hände aus dem Bild sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In live mode FrameFold automatically takes frames when your hands are out of the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo en directo, FrameFold toma fotogramas automáticamente cuando tus manos están fuera de la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode direct, FrameFold prend automatiquement des images dès que tes mains sont hors du cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità live, FrameFold riprende fotogrammi automaticamente quando le tue mani sono fuori dall’inquadratura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブモードでは、手が画面から出るたびに FrameFold が自動でコマを撮影します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold neemt in de livemodus automatisch beelden op als je handen uit beeld zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo ao vivo, o FrameFold captura quadros automaticamente quando suas mãos estão fora da imagem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V živém režimu FrameFold automaticky pořizuje snímky, když máš ruce mimo záběr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie na żywo FrameFold automatycznie robi zdjęcia, gdy twoje ręce są poza kadrem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У режимі наживо FrameFold автоматично знімає кадри, щойно твої руки зникають із кадру."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме съёмки вживую FrameFold автоматически делает кадры, когда твои руки уходят из кадра."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı modda FrameFold, elleriniz kadrajdan çıktığında otomatik olarak kare çeker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 모드에서 FrameFold는 손이 화면에서 벗어날 때마다 자동으로 프레임을 촬영해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在实时模式下，只要你的手离开画面，FrameFold 就会自动拍摄帧。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold tager automatisk billeder i livetilstand, når dine hænder er ude af billedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold tar automatiskt bilder i liveläget när dina händer är ur bild."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Systemdialog beim ersten Sichern in die Fotomediathek",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sichern fertiger Stop-Motion-Videos in deiner Fotomediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To save finished stop-motion videos to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar vídeos de stop motion terminados en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer les vidéos stop motion terminées dans ta photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per salvare i video stop motion finiti nella tua libreria foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成したコマ撮り動画をフォトライブラリに保存するために使用します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het bewaren van voltooide stop-motionvideo’s in je fotobibliotheek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para salvar vídeos em stop motion prontos na sua fototeca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K ukládání hotových stop motion videí do tvé knihovny fotek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do zapisywania gotowych filmów poklatkowych w twojej bibliotece zdjęć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зберігати готові стоп-моушн-відео у твоїй медіатеці."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сохранения готовых стоп-моушен-видео в твою медиатеку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmiş stop motion videolarını fotoğraf arşivinize kaydetmek için."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성된 스톱모션 비디오를 사진 보관함에 저장하기 위해 사용해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将完成的定格动画视频保存到你的照片图库。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til at gemme færdige stopmotion-videoer i dit fotobibliotek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att spara färdiga stopmotion-videor i ditt bildbibliotek."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Systemdialog beim ersten „Wörter erkennen“ im X-Sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Studio erkennt FrameFold gesprochene Wörter einer Tonspur, um Mundformen den Bildern zuzuordnen. Das geschieht nur auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the studio FrameFold recognizes spoken words of an audio track to assign mouth shapes to the frames. This happens only on the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el estudio, FrameFold reconoce las palabras habladas de una pista de audio para asignar formas de boca a los fotogramas. Esto solo ocurre en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le studio, FrameFold reconnaît les mots parlés d’une piste audio pour associer les formes de bouche aux images. Cela se fait uniquement sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nello Studio FrameFold riconosce le parole pronunciate in una traccia audio per abbinare le forme della bocca ai fotogrammi. Questo avviene solo sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio では、口の形をコマに合わせるため、FrameFold がオーディオトラック内の話し言葉を認識します。処理はデバイス上でのみ行われます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de studio herkent FrameFold gesproken woorden van een geluidsspoor om mondvormen aan de beelden toe te wijzen. Dat gebeurt alleen op het apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Studio, o FrameFold reconhece palavras faladas de uma faixa de áudio para atribuir formas da boca aos quadros. Isso acontece apenas no dispositivo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Studiu FrameFold rozpoznává mluvená slova ve zvukové stopě, aby snímkům přiřadil tvary úst. Děje se to jen v zařízení."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Studio FrameFold rozpoznaje wypowiadane słowa na ścieżce dźwiękowej, aby przypisać kształty ust do klatek. Dzieje się to tylko na urządzeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Студії FrameFold розпізнає слова в аудіодоріжці, щоб призначити кадрам форми рота. Це відбувається лише на пристрої."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В студии FrameFold распознаёт произнесённые слова в аудиодорожке, чтобы назначить формы рта кадрам. Это происходит только на устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stüdyoda FrameFold, ağız şekillerini karelere atamak için bir ses parçasındaki konuşulan kelimeleri tanır. Bu işlem yalnızca cihazda gerçekleşir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스튜디오에서 FrameFold는 입 모양을 프레임에 맞추기 위해 오디오 트랙의 말소리를 인식해요. 처리는 기기에서만 이루어져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Studio 中，FrameFold 会识别音轨中说出的词语，以便为各帧匹配口型。这仅在设备上进行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I Studio genkender FrameFold talte ord i et lydspor for at tildele mundformer til billederne. Det sker kun på enheden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Studio känner FrameFold igen talade ord i ett ljudspår för att koppla munformer till bilderna. Det sker bara på enheten."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Systemdialog bei „Stimme aufnehmen“",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold nimmt auf deinen Wunsch Stimme oder Geräusche zu deinem Film auf und hört, wenn du es einschaltest, auf ein Klatschen als Auslöser. Aufnahmen bleiben auf dem Gerät; beim Klatschen wird nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On request, FrameFold records your voice or sounds for your film and, if you turn it on, listens for a clap to take a shot. Recordings stay on the device. Nothing is saved when listening for claps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold graba voz o sonidos para tu película si lo deseas y, si lo enciendes, escucha una palmada como disparador. Las grabaciones se quedan en el dispositivo, al aplaudir no se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ta demande, FrameFold enregistre ta voix ou des bruits pour ton film et, si tu l’actives, écoute un applaudissement pour déclencher. Les enregistrements restent sur l’appareil. Rien n’est enregistré lors de l’écoute des applaudissements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su tua richiesta, FrameFold registra la tua voce o dei suoni per il film e, se lo attivi, ascolta un battito di mani per scattare. Le registrazioni restano sul dispositivo; durante l’ascolto del battito non viene salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご希望に応じて、FrameFold は映画用の声や音を録音し、オンにすると拍手を合図に撮影します。録音はデバイスに残り、拍手を聞き取る際には何も保存されません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold neemt op jouw verzoek stem of geluiden voor je film op en luistert, als je het inschakelt, naar een klap als ontspanner. Opnamen blijven op het apparaat. Bij het klappen wordt niets bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FrameFold grava a seu pedido voz ou sons para o seu filme e escuta, se você ativar, uma palma como disparador. As gravações ficam no dispositivo; ao bater palmas, nada é salvo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold na tvé přání nahrává hlas nebo zvuky k tvému filmu a, pokud to zapneš, poslouchá tlesknutí jako spoušť. Nahrávky zůstávají v zařízení. Při tlesknutí se nic neukládá."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na twoje życzenie FrameFold nagrywa głos lub dźwięki do twojego filmu, a jeśli to włączysz, nasłuchuje klaśnięcia jako spustu. Nagrania zostają na urządzeniu. Przy nasłuchiwaniu klaśnięć nic nie jest zapisywane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За твоїм бажанням FrameFold записує голос або звуки до твого фільму, а якщо ти це ввімкнеш, слухає оплеск як сигнал для зйомки. Записи залишаються на пристрої. Під час очікування оплеску нічого не зберігається."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По твоему желанию FrameFold записывает голос или звуки для твоего фильма, а если ты включишь эту функцию, реагирует на хлопок для спуска затвора. Записи остаются на устройстве; при хлопке ничего не сохраняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold, isteğiniz üzerine filminiz için sesinizi veya sesleri kaydeder ve açtığınızda tetikleyici olarak bir alkışı dinler. Kayıtlar cihazda kalır; alkış sırasında hiçbir şey kaydedilmez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원할 경우 FrameFold는 영상에 넣을 목소리나 소리를 녹음하며, 이 기능을 켜면 박수 소리를 듣고 촬영해요. 녹음은 기기에 남고, 박수를 칠 때는 아무것도 저장되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold 会根据你的需要为影片录制人声或声音，如果你开启该功能，它会聆听拍手声作为快门。录音保留在设备上，聆听拍手声时不会保存任何内容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold optager efter dit ønske stemme eller lyde til din film og lytter, når du slår det til, efter et klap som udløser. Optagelser bliver på enheden; ved klap gemmes intet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold spelar på din begäran in röst eller ljud till din film och lyssnar, om du slår på det, efter en klapp som avtryckare. Inspelningar stannar på enheten; vid klappning sparas ingenting."
          }
        }
      }
    },
