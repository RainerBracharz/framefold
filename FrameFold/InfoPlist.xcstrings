    "NSLocalNetworkUsageDescription": {
      "comment": "Systemdialog beim ersten Einschalten der Lichtsteuerung (Art-Net)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold schickt Lichtwerte (Art-Net) nur dann an ein Gerät in deinem lokalen Netz, wenn du im Studio die Lichtsteuerung einschaltest. Es geht nichts ins Internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold only sends light values (Art-Net) to a device on your local network if you turn on the light control in the studio. Nothing goes to the internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold envoie des valeurs d’éclairage (Art-Net) à un appareil de ton réseau local uniquement si tu actives le contrôle de la lumière dans le studio. Rien ne part sur Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold solo envía valores de luz (Art-Net) a un dispositivo de tu red local si enciendes el control de luz en el estudio. Nada va a internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold invia valori di luce (Art-Net) a un dispositivo nella tua rete locale solo se attivi il controllo luci nello Studio. Nulla va su Internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold stuurt alleen lichtwaarden (Art-Net) naar een apparaat in je lokale netwerk als je in de studio de lichtbesturing inschakelt. Er gaat niets naar het internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio で照明コントロールをオンにした場合のみ、FrameFold はローカルネットワーク内の機器に照明の値（Art-Net）を送信します。インターネットには何も送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FrameFold envia valores de luz (Art-Net) para um dispositivo na sua rede local apenas se você ativar o controle de luz no Studio. Nada vai para a internet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold posílá hodnoty světla (Art-Net) do zařízení ve tvé místní síti jen tehdy, když ve Studiu zapneš ovládání světla. Nic nejde do internetu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold wysyła wartości światła (Art-Net) do urządzenia w twojej sieci lokalnej tylko wtedy, gdy włączysz sterowanie światłem w Studio. Nic nie trafia do internetu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold надсилає значення світла (Art-Net) на пристрій у твоїй локальній мережі, лише якщо ти вмикаєш керування світлом у Студії. До інтернету нічого не потрапляє."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold отправляет значения света (Art-Net) на устройство в твоей локальной сети только в том случае, если ты включаешь управление светом в студии. В интернет ничего не передается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold, yalnızca Stüdyo’da ışık kontrolünü açtığınızda yerel ağınızdaki bir cihaza ışık değerleri (Art-Net) gönderir. İnternete hiçbir şey gitmez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스튜디오에서 조명 제어를 켤 때만 FrameFold가 로컬 네트워크의 기기로 조명 값(Art-Net)을 보내요. 인터넷으로는 아무것도 보내지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你在 Studio 中开启灯光控制时，FrameFold 才会把灯光数值（Art-Net）发送到你本地网络中的设备。不会向互联网发送任何内容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold sender kun lysværdier (Art-Net) til en enhed på dit lokale netværk, når du slår lysstyringen til i Studio. Intet sendes til internettet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold skickar ljusvärden (Art-Net) till en enhet i ditt lokala nätverk endast när du slår på ljusstyrningen i Studio. Inget skickas till internet."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Systemdialog beim ersten Verbinden von Motion Control",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold steuert nur dann per Bluetooth einen Kameraschlitten oder Schwenkkopf, wenn du im Studio Motion Control verbindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold only controls a camera slider or pan-tilt head via Bluetooth if you connect motion control in the studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold pilote par Bluetooth un slider ou une tête panoramique uniquement si tu connectes le Motion Control dans le studio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold solo controla por Bluetooth un deslizador de cámara o un cabezal panorámico si conectas el Motion Control en el estudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold controlla via Bluetooth uno slider o una testa panoramica solo se colleghi il Motion Control nello Studio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold bestuurt alleen via Bluetooth een cameraslider of panoramakop als je in de studio motion control verbindt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio でモーションコントロールを接続した場合のみ、FrameFold は Bluetooth でカメラスライダーや雲台を制御します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FrameFold controla por Bluetooth um slider de câmera ou uma cabeça panorâmica apenas se você conectar o Motion Control no Studio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold přes Bluetooth ovládá kamerový slider nebo panoramatickou hlavu jen tehdy, když ve Studiu připojíš Motion Control."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold steruje przez Bluetooth sliderem kamery lub głowicą panoramiczną tylko wtedy, gdy połączysz Motion Control w Studio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold керує через Bluetooth слайдером камери або панорамною головкою, лише якщо ти підключаєш Motion Control у Студії."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold управляет по Bluetooth слайдером камеры или панорамной головкой только в том случае, если ты подключаешь Motion Control в студии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold, yalnızca Stüdyo’da Motion Control’ü bağladığınızda Bluetooth üzerinden bir kamera kızağını veya pan-tilt başlığını kontrol eder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스튜디오에서 모션 컨트롤을 연결할 때만 FrameFold가 Bluetooth로 카메라 슬라이더나 팬·틸트 헤드를 제어해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你在 Studio 中连接运动控制时，FrameFold 才会通过蓝牙控制相机滑轨或云台。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold styrer kun en kameraslider eller et panoramahoved via Bluetooth, når du forbinder motion control i Studio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FrameFold styr en kameraslider eller ett panoramahuvud via Bluetooth endast när du ansluter motion control i Studio."
          }
        }
      }
    }
  },
  "version": "1.3"
}
