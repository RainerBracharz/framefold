<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nur für die Mac-Fassung: Der Mac App Store verlangt die Sandbox.
	     Kamera für die Aufnahme, vom Nutzer gewählte Dateien für Teilen
	     und Sichern. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Spiegelreflex- und Systemkameras per USB auslösen (ImageCaptureCore) -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- Nur auf Wunsch: Licht (Art-Net) und Motion Control im lokalen Netz bzw. per Bluetooth -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Stimme zum Film aufnehmen (nur auf Wunsch, bleibt auf dem Mac) -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Kamera-Ordner im Studio über Neustarts hinweg merken -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
