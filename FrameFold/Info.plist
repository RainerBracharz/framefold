<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Klassisches (opakes) Leisten-Design statt Liquid Glass: die
	     schwebende Glas-Tab-Bar von iOS 26 passt sich dem Inhalt an und
	     macht die Tusche-Tint auf dunklen Screens unlesbar. Mit diesem
	     Schlüssel greift der feste Papier-Grund aus FrameFoldApp überall. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<!-- Keine eigene Verschluesselung — erspart die Compliance-Frage
	     bei jedem App-Store-Upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Werk als Datei („Faltung.framefold“): per AirDrop oder „Dateien“
	     von einem Gerät aufs andere. Importiert wird eine Kopie. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.bracharz.framefold.work</string>
			<key>UTTypeDescription</key>
			<string>FrameFold Work</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>framefold</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>FrameFold Work</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bracharz.framefold.work</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
