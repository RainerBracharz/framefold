# FrameFold — Veröffentlichung ohne Browser.
#
# Einmalig nötig:
#   brew install fastlane
#   API-Schlüssel unter ~/.appstoreconnect/AuthKey_RYCY6P77D7.p8
#
# Danach genügt für ein Update:
#   1. Versionsnummer in Xcode erhöhen (oder: fastlane bump version:1.0.2)
#   2. Release-Notes in fastlane/metadata/de-DE/release_notes.txt schreiben
#   3. fastlane release
#      (hängt die Einreichung, reicht danach: fastlane submit)
#
# Was der Befehl tut: Build-Nummer hochzählen, archivieren, hochladen,
# Version anlegen, Notes setzen, Build anhängen, zur Prüfung einreichen.

default_platform(:ios)

# Für das iPhone Duo muss mit Xcode 27.1 gebaut werden (iOS-27.1-SDK). Solange
# das noch nicht das Standard-Xcode ist, hier gezielt wählen. Liegt es nicht
# unter diesem Pfad, baut fastlane mit dem Standard-Xcode wie bisher.
XCODE_DUO = "/Applications/Xcode-27.1.app/Contents/Developer"
ENV["DEVELOPER_DIR"] = XCODE_DUO if File.directory?(XCODE_DUO) && ENV["DEVELOPER_DIR"].to_s.empty?

APP_ID     = "com.bracharz.framefold"
SCHEME     = "FrameFold"
PROJECT    = "FrameFold.xcodeproj"
KEY_ID     = "RYCY6P77D7"
ISSUER_ID  = "2035739a-efc7-450c-8f2f-61f211394113"
KEY_PATH   = File.expand_path("~/.appstoreconnect/AuthKey_#{KEY_ID}.p8")
TEAM_ID    = "57TBDSR367"
ASC_APP_ID = "6801045603"   # öffentliche App-Store-Nummer; der Mac-Upload braucht sie

# Der Export muss ausdrücklich mit einer Distributions-Identität signieren –
# sonst bleibt es beim Development-Zertifikat und das Paketieren scheitert.
# Als Methode statt Konstante: gym verändert den Hash und stolpert über
# eingefrorene Objekte.
def export_options
  {
    signingStyle: "automatic",
    teamID: TEAM_ID,
    destination: "export",
    uploadSymbols: true
  }
end

platform :ios do

  # Meldet uns bei der App Store Connect API an. Der private Schlüssel bleibt
  # auf der Platte, er wandert nie ins Repository.
  private_lane :login do
    UI.user_error!("Schlüssel fehlt: #{KEY_PATH}") unless File.exist?(KEY_PATH)
    app_store_connect_api_key(
      key_id: KEY_ID,
      issuer_id: ISSUER_ID,
      key_filepath: KEY_PATH,
      in_house: false
    )
  end

  desc "Versionsnummer setzen, z. B. fastlane bump version:1.0.2"
  lane :bump do |options|
    version = options[:version]
    UI.user_error!("Bitte version angeben: fastlane bump version:1.0.2") if version.nil?
    increment_version_number(version_number: version, xcodeproj: PROJECT)
    UI.success("Version steht auf #{version}")
  end

  desc "Nur bauen und hochladen (ohne Einreichung) – landet in TestFlight"
  lane :upload do
    api_key = login
    increment_build_number(xcodeproj: PROJECT)
    build_app(project: PROJECT, scheme: SCHEME,
              export_method: "app-store",
              export_team_id: TEAM_ID,
              export_options: export_options,
              xcargs: "-allowProvisioningUpdates")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: false)
    UI.success("Build ist in App Store Connect.")
  end

  # Die Mac-Fassung (Mac Catalyst) teilt sich Bundle-ID und App-Eintrag mit
  # dem iPhone – ein Kauf, zwei Plattformen. Gebaut wird ein signiertes .pkg
  # für den Mac App Store.
  private_lane :mac_pkg do |options|
    build_app(project: PROJECT, scheme: SCHEME,
              catalyst_platform: "macos",
              export_method: "app-store",
              export_team_id: TEAM_ID,
              export_options: export_options.merge(destination: "export"),
              output_directory: "build/mac-release",
              xcargs: "-allowProvisioningUpdates")
  end

  desc "Mac-Fassung nur lokal bauen und signieren (lädt nichts hoch)"
  lane :mac_build do
    mac_pkg
    UI.success("Paket liegt in build/mac-release.")
  end

  desc "Mac-Fassung bauen und nach TestFlight hochladen (ohne Einreichung)"
  lane :mac_upload do
    api_key = login
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID,
                                            platform: "osx", initial_build_number: 0)
    current = get_build_number(xcodeproj: PROJECT).to_i
    increment_build_number(xcodeproj: PROJECT, build_number: [latest + 1, current].max)
    pkg = mac_pkg
    upload_to_testflight(api_key: api_key, app_platform: "osx", pkg: pkg, apple_id: ASC_APP_ID,
                         skip_waiting_for_build_processing: true)
    UI.success("Mac-Build ist in App Store Connect.")
  end

  # Texte und Screenshots der Mac-Version. Untertitel und Name teilt sich der
  # Mac mit dem iPhone – darum liegen in metadata-mac bewusst keine.
  # Screenshots (2880×1800) erzeugt die Debug-Fassung mit Ersatzkamera:
  # FF_SIM_FRAMES, FF_AUTOSTART, FF_TAB, FF_WINDOW=1440x900.
  desc "Mac-Texte und -Screenshots hochladen (ohne Einreichung)"
  lane :mac_metadata do
    api_key = login
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "osx",
      app_version: get_version_number(xcodeproj: PROJECT, target: SCHEME),
      metadata_path: "./fastlane/metadata-mac",
      screenshots_path: "./fastlane/screenshots-mac",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
    UI.success("Mac-Texte und -Screenshots sind in App Store Connect.")
  end

  desc "Kompletter Mac-Release: bauen, hochladen, Version + Texte + Screenshots, einreichen"
  lane :mac_release do
    api_key = login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)

    mac_upload

    # Warten, bis Apple den Build verarbeitet hat – vorher lässt er sich
    # nicht an die Version hängen.
    build = nil
    60.times do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, platform: "MAC_OS",
                                               sort: "-uploadedDate", limit: 1).first
      state = build&.processing_state
      UI.message("Mac-Build #{version} (#{build&.version || '–'}): #{state || 'noch nicht sichtbar'}")
      break if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Apple hat den Build zurückgewiesen (#{state}).") if %w[FAILED INVALID].include?(state)
      sleep 30
    end

    # Legt die Mac-Version an, falls es sie noch nicht gibt, lädt Texte und
    # Screenshots (ersetzt die alten) und reicht ein.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "osx",
      app_version: version,
      build_number: build.version,
      metadata_path: "./fastlane/metadata-mac",
      screenshots_path: "./fastlane/screenshots-mac",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false,
      automatic_release: true,
      submit_for_review: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
    UI.success("Mac #{version} (#{build.version}) eingereicht.")
  end

  desc "Mac-Version mit dem jüngsten gültigen Mac-Build einreichen"
  lane :mac_submit do
    api_key = login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, platform: "MAC_OS",
                                             sort: "-uploadedDate", limit: 1).first
    unless build&.processing_state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Kein gültiger Mac-Build für #{version} (#{build&.processing_state || 'keiner'}).")
    end
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "osx",
      app_version: version,
      build_number: build.version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
    UI.success("Mac #{version} (#{build.version}) eingereicht.")
  end

  desc "Wartende Mac-Einreichung zurückziehen und mit dem jüngsten Mac-Build neu einreichen"
  lane :mac_resubmit do
    login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    subs = app.get_review_submissions(
      filter: { state: "WAITING_FOR_REVIEW,READY_FOR_REVIEW,UNRESOLVED_ISSUES", platform: "MAC_OS" })
    subs.each do |sub|
      sub.cancel_submission
      UI.success("Mac-Einreichung zurückgezogen.")
    end
    20.times do
      v = app.get_app_store_versions(filter: { versionString: version, platform: "MAC_OS" }).first
      state = v&.app_store_state
      UI.message("Mac #{version}: #{state}")
      break unless %w[WAITING_FOR_REVIEW IN_REVIEW].include?(state)
      sleep 15
    end
    mac_submit
  end

  desc "Kompletter Release: bauen, hochladen, Version anlegen, einreichen"
  lane :release do |options|
    api_key = login

    # Apple erlaubt nur EINE Version in der Prüfung. Wartet noch eine andere,
    # benennt deliver sie um, statt eine neue anzulegen (so geschehen am
    # 02.10.: aus der wartenden 1.5 wurde „2.0" mit dem 1.5-Build). Daher
    # vorher abbrechen.
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    target = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    # Nur iOS: Eine Mac-Version in Prüfung blockiert das iPhone-Release nicht.
    busy = Spaceship::ConnectAPI::App.find(APP_ID).get_app_store_versions(filter: { platform: "IOS" }).find do |v|
      %w[WAITING_FOR_REVIEW IN_REVIEW].include?(v.app_store_state) && v.version_string != target
    end
    if busy
      UI.user_error!("#{busy.version_string} ist noch in der Prüfung (#{busy.app_store_state}). " \
                     "Erst abwarten – oder `fastlane resubmit`, um sie durch #{target} zu ersetzen.")
    end

    # Build-Nummer aus App Store Connect statt aus dem Projekt: agvtool las
    # sonst den Wert des jüngsten Targets (UI-Tests, stand auf 1) und zählte
    # von dort weiter. So ist die Nummer immer höher als alles Hochgeladene.
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID,
                                            initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: latest + 1)
    build_app(project: PROJECT, scheme: SCHEME,
              export_method: "app-store",
              export_team_id: TEAM_ID,
              export_options: export_options,
              xcargs: "-allowProvisioningUpdates")

    # Schritt 1: Build, Texte, Screenshots hochladen – noch nicht einreichen.
    # Apple muss den Build erst verarbeiten; wer sofort einreicht, bekommt
    # „The specified pre-release build could not be added".
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      # Metadaten kommen aus fastlane/metadata, Screenshots aus
      # fastlane/screenshots (iPhone 6,9" in allen drei Sprachen, Watch für
      # de-DE). `fastlane release overwrite_shots:true` ersetzt, was im Store
      # liegt – nötig, wenn die Bilder neu sind (2.3: „Werke", ohne alte
      # Aldo-Motive). Duo-Bilder lädt Schritt 2b danach wieder hoch.
      skip_screenshots: false,
      skip_metadata: false,
      overwrite_screenshots: [true, "true"].include?(options[:overwrite_shots]),
      force: true,                       # keine Rückfrage im Browser
      precheck_include_in_app_purchases: false,
      automatic_release: true,           # nach Apples Freigabe sofort im Store
      submit_for_review: false
    )

    # Schritt 2: App-Vorschau (Video) anhängen, falls vorbereitet. deliver
    # kann keine Videos – das übernimmt scripts/app_preview.rb über die API
    # und wartet, bis Apple sie verarbeitet hat. Ohne Videos: nichts tun.
    # Achtung: Die gerahmten Vorschauen (App-Bild verkleinert im iPhone-Rahmen,
    # Text darüber) hat Apple am 15.10.2026 abgelehnt (Guideline 2.3.4). Sie
    # liegen jetzt in previews-gerahmt-abgelehnt/ und werden nicht mehr
    # hochgeladen. Neue Videos: reine Bildschirmaufnahmen, Text nur als
    # Einblendung über dem App-Bild.
    previews = Dir[File.expand_path("previews/*/framefold-preview.mp4", __dir__)]
    sh("ruby", File.expand_path("../scripts/app_preview.rb", __dir__), "upload") unless previews.empty?

    # Schritt 2b: Screenshots für das iPhone Duo, falls vorbereitet. deliver
    # kennt den Gerätetyp noch nicht – scripts/duo_screenshots.rb lädt sie
    # über die API.
    duo_shots = Dir[File.expand_path("screenshots-duo/*/*/duo-*.png", __dir__)]
    sh("ruby", File.expand_path("../scripts/duo_screenshots.rb", __dir__), "upload") unless duo_shots.empty?

    # Schritt 3: warten, bis der Build verarbeitet ist, dann einreichen.
    submit
  end

  desc "Wartende Einreichung zurückziehen und mit dem neuesten Build dieser Version neu einreichen"
  lane :resubmit do
    login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)

    # Nur iOS – eine laufende Mac-Einreichung bleibt unberührt.
    subs = app.get_review_submissions(
      filter: { state: "WAITING_FOR_REVIEW,READY_FOR_REVIEW,UNRESOLVED_ISSUES", platform: "IOS" })
    if subs.empty?
      UI.message("Keine wartende Einreichung gefunden.")
    else
      subs.each do |sub|
        sub.cancel_submission
        UI.success("Einreichung zurückgezogen.")
      end
    end

    # Bis die Version wieder bearbeitbar ist, dauert es ein paar Sekunden.
    20.times do
      v = app.get_app_store_versions(filter: { versionString: version, platform: "IOS" }).first
      state = v&.app_store_state
      UI.message("#{version}: #{state}")
      break unless %w[WAITING_FOR_REVIEW IN_REVIEW].include?(state)
      sleep 15
    end

    submit
  end

  desc "Neuesten Build der aktuellen Version einreichen (wartet auf Apples Verarbeitung)"
  lane :submit do
    api_key = login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)

    # Schon eingereicht? Dann nichts tun – ein zweiter Build lässt sich an
    # eine wartende Version nicht mehr hängen, das war der Fehler vom 23.09.
    current = app.get_app_store_versions(filter: { versionString: version, platform: "IOS" }).first
    if current && %w[WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE READY_FOR_SALE].include?(current.app_store_state)
      UI.success("#{version} steht schon auf #{current.app_store_state} – nichts zu tun.")
      next
    end

    build = nil
    60.times do                          # höchstens 30 Minuten
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, platform: "IOS",
                                               sort: "-uploadedDate", limit: 1).first
      state = build&.processing_state
      UI.message("Build #{version} (#{build&.version || '–'}): #{state || 'noch nicht sichtbar'}")
      break if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Apple hat den Build zurückgewiesen (#{state}).") if %w[FAILED INVALID].include?(state)
      sleep 30
    end
    unless build&.processing_state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Build nach 30 Minuten noch nicht verarbeitet – später `fastlane submit`.")
    end

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: version,
      build_number: build.version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
    UI.success("#{version} (#{build.version}) eingereicht. Nach Apples Freigabe geht die Version automatisch in den Store.")
  end

  desc "Nur Texte aktualisieren (Beschreibung, Release-Notes) – ohne neues Binary"
  lane :metadata do
    api_key = login
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
    UI.success("Texte hochgeladen. Ob Apple sie ohne neue Version übernimmt, zeigt App Store Connect.")
  end

  desc "Status der letzten Einreichung anzeigen"
  lane :status do
    api_key = login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    app.get_app_store_versions(includes: "build").first(3).each do |v|
      build = v.build ? " · Build #{v.build.version}" : " · kein Build"
      UI.message("#{v.version_string} — #{v.app_store_state}#{build}")
    end
  end

  desc "Zeigt, welche Screenshots je Gerätetyp im Store liegen"
  lane :shots do
    login
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    app.get_app_store_versions.first(2).each do |v|
      UI.message("── Version #{v.version_string} (#{v.app_store_state})")
      v.get_app_store_version_localizations.each do |loc|
        UI.message("   Sprache #{loc.locale}")
        sets = loc.get_app_screenshot_sets
        if sets.empty?
          UI.important("     keine Screenshot-Sets")
          next
        end
        sets.each do |s|
          shots = s.app_screenshots || []
          UI.message("     #{s.screenshot_display_type}: #{shots.size} Bild(er)")
        end
      end
    end
  end

  desc "Lädt die im Store liegenden Screenshots nach fastlane/store-shots/"
  lane :pull_shots do
    login
    require "spaceship"
    require "open-uri"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    dir = File.expand_path("store-shots", Dir.pwd)
    FileUtils.rm_rf(dir); FileUtils.mkdir_p(dir)

    v = app.get_app_store_versions.first
    UI.message("Version #{v.version_string} (#{v.app_store_state})")
    v.get_app_store_version_localizations.each do |loc|
      loc.get_app_screenshot_sets.each do |s|
        (s.app_screenshots || []).each_with_index do |shot, i|
          asset = shot.image_asset
          next UI.important("  #{shot.file_name}: noch keine Vorschau") if asset.nil?
          url = asset["templateUrl"].to_s
                    .gsub("{w}", asset["width"].to_s)
                    .gsub("{h}", asset["height"].to_s)
                    .gsub("{f}", "png")
          name = "#{s.screenshot_display_type}-#{format('%02d', i + 1)}.png"
          File.binwrite(File.join(dir, name), URI.parse(url).read)
          UI.success("  #{name}  (#{asset['width']}×#{asset['height']})")
        end
      end
    end
  end

  desc "Vollständiger Prüfbericht -> fastlane/bericht.txt"
  lane :check do
    login
    require "spaceship"
    require "json"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)

    out = []
    def out.say(line); self << line; end

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    out.say "APP"
    out.say "  Name:        #{app.name}"
    out.say "  Bundle-ID:   #{app.bundle_id}"
    out.say "  Primär:      #{app.primary_locale}"
    out.say ""

    app.get_app_store_versions.first(3).each do |v|
      out.say "VERSION #{v.version_string} — #{v.app_store_state}"
      out.say "  Freigabe:  #{v.release_type}"
      begin
        b = v.build
        out.say "  Build:     #{b ? "#{b.version} (hochgeladen #{b.uploaded_date})" : 'KEIN BUILD ANGEHÄNGT'}"
      rescue => e
        out.say "  Build:     nicht lesbar (#{e.class})"
      end
      begin
        v.get_app_store_version_localizations.each do |loc|
          notes = (loc.whats_new || "").strip
          out.say "  Notes [#{loc.locale}]: #{notes.empty? ? 'LEER' : notes.lines.first.strip + ' …'}"
        end
      rescue => e
        out.say "  Notes:     nicht lesbar (#{e.class})"
      end
      out.say ""
    end

    # Bedienungshilfen – erst seit kurzem in der API, daher abgesichert
    begin
      resp  = Spaceship::ConnectAPI::App.client.get("apps/#{app.id}/accessibilityDeclarations")
      raw   = resp.respond_to?(:body) ? resp.body : resp
      raw   = JSON.parse(raw) if raw.is_a?(String)
      items = (raw.is_a?(Hash) ? (raw["data"] || raw[:data]) : nil) || []
      if items.empty?
        out.say "BEDIENUNGSHILFEN: keine Angaben gefunden"
      else
        out.say "BEDIENUNGSHILFEN:"
        items.each do |d|
          attrs = d["attributes"] || {}
          attrs.sort.each { |k, v| out.say "  #{k}: #{v}" }
        end
      end
    rescue => e
      out.say "BEDIENUNGSHILFEN: nicht abrufbar (#{e.class}: #{e.message[0, 120]})"
    end
    out.say ""

    begin
      resp = Spaceship::ConnectAPI::App.client.get("apps/#{app.id}/reviewSubmissions")
      raw  = resp.respond_to?(:body) ? resp.body : resp
      raw  = JSON.parse(raw) if raw.is_a?(String)
      subs = (raw.is_a?(Hash) ? (raw["data"] || raw[:data]) : nil) || []
      out.say "EINREICHUNGEN: #{subs.size}"
      subs.last(3).each do |s|
        a = s["attributes"] || {}
        out.say "  #{a['state']} · eingereicht #{a['submittedDate']}"
      end
    rescue => e
      out.say "EINREICHUNGEN: nicht lesbar (#{e.class}: #{e.message[0, 120]})"
    end

    # fastlane arbeitet bereits im Ordner fastlane/ – Pfad nicht doppeln
    path = File.expand_path("bericht.txt", Dir.pwd)
    File.write(path, out.join("\n") + "\n")
    UI.success("Bericht geschrieben: #{path}")
    UI.message(out.join("\n"))
  end

  # ── Creative Assets (Produktseiten-Kopf und Suche, iOS/iPadOS 27) ──────────
  # Über die App Asset Library der App-Store-Connect-API:
  #   fastlane creative_assets step:probe    nur lesen: Bibliothek, Vorgaben, Bilder
  #   fastlane creative_assets step:upload   fastlane/creative-assets/*.png hochladen
  #   fastlane creative_assets step:submit   hochgeladene Bilder zur Prüfung einreichen
  #   fastlane creative_assets step:place    freigegebene Bilder Kopf und Suche zuordnen
  desc "Creative Assets: probe | upload | submit | place"
  lane :creative_assets do |options|
    require "spaceship"
    require "net/http"
    require "json"
    login
    token = Spaceship::ConnectAPI::Token.create(key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    api = lambda do |method, path, body = nil|
      uri = URI("https://api.appstoreconnect.apple.com#{path}")
      req = Net::HTTP.const_get(method.capitalize).new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      req["Content-Type"] = "application/json"
      req.body = JSON.generate(body) if body
      res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
      data = res.body.to_s.empty? ? {} : JSON.parse(res.body)
      UI.user_error!("#{method.upcase} #{path} → #{res.code}: #{JSON.generate(data["errors"] || data)}") unless res.code.start_with?("2")
      data
    end
    lang_of = { "de" => "de-DE", "en" => "en-US", "fr" => "fr-FR" }
    library = api.call(:get, "/v1/apps/#{ASC_APP_ID}/assetLibrary")["data"]
    lib_id = library["id"]
    images = lambda do
      api.call(:get, "/v1/appAssetLibraries/#{lib_id}/images?filter[category]=CREATIVE_ASSETS&limit=50")["data"]
    end

    case options[:step].to_s
    when "probe"
      UI.message("Bibliothek: #{lib_id}")
      ref = api.call(:get, "/v1/appAssetLibraryRefData")
      File.write("/tmp/ff-asset-refdata.json", JSON.pretty_generate(ref))
      UI.message("Vorgaben gesichert: /tmp/ff-asset-refdata.json")
      images.call.each { |i| UI.message("#{i["attributes"]["fileName"]} — #{i["attributes"]["state"]} (#{i["id"]})") }

    when "upload"
      present = images.call.map { |i| i["attributes"]["fileName"] }
      Dir[File.expand_path("creative-assets/creative-universal-*.png", __dir__)].sort.each do |file|
        name = File.basename(file)
        if present.include?(name)
          UI.message("schon da: #{name}")
          next
        end
        bytes = File.binread(file)
        reserved = api.call(:post, "/v1/appAssetLibraryImages", { data: {
          type: "appAssetLibraryImages",
          attributes: { fileName: name, fileSize: bytes.bytesize, category: "CREATIVE_ASSETS",
                        referenceName: "FrameFold Universal #{name[/-(\w\w)\.png/, 1].upcase}" },
          relationships: { assetLibrary: { data: { type: "appAssetLibraries", id: lib_id } } } } })["data"]
        reserved["attributes"]["uploadOperations"].each do |op|
          uri = URI(op["url"])
          req = Net::HTTP.const_get(op["method"].capitalize).new(uri)
          op["requestHeaders"].each { |h| req[h["name"]] = h["value"] }
          req.body = bytes.byteslice(op["offset"], op["length"])
          res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
          UI.user_error!("Upload #{name} → #{res.code}") unless res.code.start_with?("2")
        end
        api.call(:patch, "/v1/appAssetLibraryImages/#{reserved["id"]}",
                 { data: { type: "appAssetLibraryImages", id: reserved["id"], attributes: { uploaded: true } } })
        UI.success("hochgeladen: #{name} (#{reserved["id"]})")
      end
      30.times do
        states = images.call.map { |i| i["attributes"]["state"] }
        UI.message("Zustände: #{states.join(", ")}")
        break unless states.include?("UPLOAD_COMPLETE") || states.include?("AWAITING_UPLOAD")
        sleep 10
      end
      images.call.each do |i|
        a = i["attributes"]
        UI.message("#{a["fileName"]} — #{a["state"]} · spec #{a["specId"]}#{a["stateDetails"] ? " · #{a["stateDetails"]}" : ""}")
      end

    when "submit"
      ready = images.call.select { |i| i["attributes"]["state"] == "PREPARE_FOR_SUBMISSION" }
      UI.user_error!("Nichts zum Einreichen") if ready.empty?
      sub = api.call(:post, "/v1/reviewSubmissions", { data: { type: "reviewSubmissions",
        attributes: { platform: "IOS" },
        relationships: { app: { data: { type: "apps", id: ASC_APP_ID } } } } })["data"]
      ready.each do |i|
        api.call(:post, "/v1/reviewSubmissionItems", { data: { type: "reviewSubmissionItems",
          relationships: { reviewSubmission: { data: { type: "reviewSubmissions", id: sub["id"] } },
                           appAssetLibraryImage: { data: { type: "appAssetLibraryImages", id: i["id"] } } } } })
        UI.message("in die Einreichung: #{i["attributes"]["fileName"]}")
      end
      api.call(:patch, "/v1/reviewSubmissions/#{sub["id"]}",
               { data: { type: "reviewSubmissions", id: sub["id"], attributes: { submitted: true } } })
      UI.success("Eingereicht (#{sub["id"]})")

    when "place"
      version = Spaceship::ConnectAPI::App.find(APP_ID).get_app_store_versions
                  .find { |v| v.app_store_state == "READY_FOR_SALE" }
      UI.user_error!("Keine Version im Verkauf") unless version
      locs = version.get_app_store_version_localizations
      images.call.select { |i| i["attributes"]["state"] == "APPROVED" }.each do |i|
        lang = i["attributes"]["fileName"][/-(\w\w)\.png/, 1]
        loc = locs.find { |l| l.locale == lang_of[lang] }
        next UI.important("keine Sprache #{lang} in #{version.version_string}") unless loc
        %w[PRODUCT_PAGE_HEADER_ASSET APP_STORE_SEARCH_RESULTS_ASSET].each do |type|
          api.call(:post, "/v1/appAssetLibraryPlacements", { data: { type: "appAssetLibraryPlacements",
            attributes: { placementType: type, placementGroup: options[:group] || "DEFAULT_PROFILE" },
            relationships: { image: { data: { type: "appAssetLibraryImages", id: i["id"] } },
                             appStoreVersionLocalization: { data: { type: "appStoreVersionLocalizations", id: loc.id } } } } })
          UI.success("#{type} → #{loc.locale} (#{version.version_string})")
        end
      end
    else
      UI.user_error!("step:probe | upload | submit | place")
    end
  end
end
